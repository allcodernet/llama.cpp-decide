+// spec 5 sequential fields (after): phases, the answer lines and given of a state, the worst-case line budget, the context-trie
+// cache; with a vocab file (argv[1], ctest passes models/ggml-vocab-*.gguf): the line token counts, the budget bound on real
+// context tries and the tail|context-stem join check
+#include "decide-engine.h"
+
+#include "common.h"
+#include "llama.h"
+
+#include <algorithm>
+#include <climits>
+#include <cstdio>
+#include <string>
+#include <vector>
+
+static int failures = 0;
+#define CHECK(cond) do { if (!(cond)) { std::fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #cond); failures++; } } while (0)
+
+using phases = std::vector<std::vector<size_t>>;
+using i64s   = std::vector<int64_t>;
+
+static const char * QUEUE = R"("queue": {"type": "choice", "description": "Which team?", "options": {"billing": "b", "technical": "t", "sales": "s", "feedback": "f"}})";
+
+static decide::compiled_schema schema(const std::string & fields) {
+    return decide::compile_request(common_json::parse("{\"fields\": {" + fields + "}, \"states\": [\"x\"]}"));
+}
+
+// triage; urgency and angry after queue (the live configuration of the evaluation)
+static decide::compiled_schema siblings() {
+    return schema(std::string(QUEUE) + R"(,
+        "urgency": {"type": "score", "description": "How urgent?", "levels": ["a", "b", "c", "d"], "after": ["queue"]},
+        "angry":   {"type": "bool", "description": "Angry?", "after": ["queue"]})");
+}
+
+// triage; urgency after queue, angry after urgency and queue (given in another order than declared): three phases
+static decide::compiled_schema chain() {
+    return schema(std::string(QUEUE) + R"(,
+        "urgency": {"type": "score", "description": "How urgent?", "levels": ["a", "b", "c", "d"], "after": ["queue"]},
+        "angry":   {"type": "bool", "description": "Angry?", "after": ["urgency", "queue"]})");
+}
+
+// tree: branch nodes 0 (stem) and 1 (stem + {10}); full-path: 3 options, paths {10, 20}, {10, 21}, {11}
+static decide::field_trie region() {
+    decide::field_trie t;
+    t.stem = {100, 101};
+    t.paths = {{10, 20}, {10, 21}, {11}};
+    t.nodes.resize(5);
+    t.nodes[0].children = {1, 4}; t.nodes[0].options_through = {0, 1, 2};
+    t.nodes[1].tok = 10; t.nodes[1].children = {2, 3}; t.nodes[1].options_through = {0, 1};
+    t.nodes[2].tok = 20; t.nodes[2].options_through = {0};
+    t.nodes[3].tok = 21; t.nodes[3].options_through = {1};
+    t.nodes[4].tok = 11; t.nodes[4].options_through = {2};
+    t.branch_nodes = {0, 1};
+    t.option_nodes = {{0, 1, 2}, {0, 1, 3}, {0, 4}};
+    return t;
+}
+
+// a bool-like field: stem {200}, paths {7}, {8}
+static decide::field_trie two_leaves() {
+    decide::field_trie t;
+    t.stem = {200};
+    t.paths = {{7}, {8}};
+    t.nodes.resize(3);
+    t.nodes[0].children = {1, 2}; t.nodes[0].options_through = {0, 1};
+    t.nodes[1].tok = 7; t.nodes[1].options_through = {0};
+    t.nodes[2].tok = 8; t.nodes[2].options_through = {1};
+    t.branch_nodes = {0};
+    t.option_nodes = {{0, 1}, {0, 2}};
+    return t;
+}
+
+// true when f() throws the 500 engine error naming `field` whose message contains `text`
+template <typename F> static bool throws_engine(F f, const std::string & field, const std::string & text) {
+    try {
+        f();
+    } catch (const decide::error & e) {
+        const bool ok = e.code == "engine" && e.http == 500 && e.field == field && std::string(e.what()).find(text) != std::string::npos;
+        if (!ok) {
+            std::fprintf(stderr, "unexpected error: %s %d field \"%s\": %s\n", e.code.c_str(), e.http, e.field.c_str(), e.what());
+        }
+        return ok;
+    }
+    return false;
+}
+
+template <typename F> static bool no_throw(F f) {
+    try {
+        f();
+    } catch (const std::exception & e) {
+        std::fprintf(stderr, "unexpected exception: %s\n", e.what());
+        return false;
+    }
+    return true;
+}
+
+static decide::field_answer answer(std::vector<double> probs, int argmax) {
+    decide::field_answer a;
+    a.probs    = std::move(probs);
+    a.argmax   = argmax;
+    a.expected = 0.0;
+    return a;
+}
+
+static void model_free() {
+    using decide::phase_fields;
+
+    // 1. spec 5.1 phases: phase L holds the fields of level L in declaration order
+    {
+        const auto plain = schema(std::string(QUEUE) + R"(, "urgency": {"type": "score", "description": "u", "levels": ["a", "b"]}, "angry": {"type": "bool", "description": "a"})");
+        CHECK(phase_fields(plain) == (phases{{0, 1, 2}}));
+        CHECK(phase_fields(siblings()) == (phases{{0}, {1, 2}}));
+        CHECK(phase_fields(chain()) == (phases{{0}, {1}, {2}}));
+        // diamond declared dependent first: d after c and b, c and b after a -> levels d 2, c 1, b 1, a 0, e 0
+        const auto diamond = schema(R"("d": {"type": "bool", "description": "d", "after": ["c", "b"]},
+                                        "c": {"type": "bool", "description": "c", "after": ["a"]},
+                                        "b": {"type": "bool", "description": "b", "after": ["a"]},
+                                        "a": {"type": "bool", "description": "a"},
+                                        "e": {"type": "bool", "description": "e"})");
+        CHECK(phase_fields(diamond) == (phases{{3, 4}, {1, 2}, {0}}));
+    }
+
+    // 2. the option an answer reports as its value: argmax for choice and score, answer_json's p_true >= 0.5 for bool
+    {
+        const auto cs = chain();
+        const auto & queue = cs.fields[0];
+        const auto & urgency = cs.fields[1];
+        const auto & angry = cs.fields[2];
+        CHECK(decide::answer_option(queue, answer({0.2, 0.5, 0.1, 0.2}, 1)) == 1);
+        CHECK(decide::answer_option(urgency, answer({0.1, 0.2, 0.3, 0.4}, 3)) == 3);
+        const auto tie = answer({0.5, 0.5}, 0);
+        CHECK(decide::answer_option(angry, tie) == 0 && decide::answer_json(angry, tie).at("value").dump() == "true");
+        const auto no = answer({0.3, 0.7}, 1);
+        CHECK(decide::answer_option(angry, no) == 1 && decide::answer_json(angry, no).at("value").dump() == "false");
+        // probabilities one rounding short of 1: the argmax is "true", the reported value is false; the lines follow the value
+        const auto short_sum = answer({0.49999999, 0.49999998}, 0);
+        CHECK(decide::answer_option(angry, short_sum) == 1 && decide::answer_json(angry, short_sum).at("value").dump() == "false");
+    }
+
+    // 3. spec 5.2 lines and given: every ancestor in declaration order, its stem text, the encoded answer and ",\n"
+    {
+        using decide::lines_for;
+        const auto cs = chain();
+        const std::vector<int> opt = {2, 3, -1};   // queue "sales", urgency 3, angry not answered
+        const auto u = lines_for(cs, 1, opt);
+        CHECK(u.text == "  \"queue\": \"sales\",\n");
+        CHECK(u.given.dump() == R"({"queue":"sales"})");
+        // after ["urgency", "queue"]: declaration order, not the order given
+        const auto a = lines_for(cs, 2, opt);
+        CHECK(a.text == "  \"queue\": \"sales\",\n  \"urgency\": 3,\n");
+        CHECK(a.given.dump() == R"({"queue":"sales","urgency":3})");
+        // a level-0 field has no lines
+        const auto q = lines_for(cs, 0, opt);
+        CHECK(q.text.empty() && q.given.is_null());
+        // an ancestor without an answer is an engine defect
+        CHECK(throws_engine([&] { lines_for(cs, 2, {2, -1, -1}); }, "angry", "no answer"));
+        CHECK(throws_engine([&] { lines_for(cs, 2, {2, 4, -1}); }, "angry", "no answer"));
+        CHECK(throws_engine([&] { lines_for(cs, 2, {2}); }, "angry", "no answer"));
+
+        // a bool ancestor, a key that needs JSON escaping (the lines hold the encoded text, given the key)
+        const auto bc = schema(R"("angry": {"type": "bool", "description": "a"},
+                                   "c": {"type": "choice", "description": "c", "options": ["say \"hi\"", "b"]},
+                                   "n": {"type": "choice", "description": "n", "options": ["x", "y"], "after": ["c", "angry"]})");
+        const auto l0 = lines_for(bc, 2, {0, 0, -1});
+        CHECK(l0.text == "  \"angry\": true,\n  \"c\": \"say \\\"hi\\\"\",\n");
+        CHECK(l0.given.dump() == R"({"angry":true,"c":"say \"hi\""})");
+        const auto l1 = lines_for(bc, 2, {1, 1, -1});
+        CHECK(l1.text == "  \"angry\": false,\n  \"c\": \"b\",\n");
+        CHECK(l1.given.dump() == R"({"angry":false,"c":"b"})");
+    }
+
+    // 4. spec 5.4 worst-case lines: per ancestor its longest line + 2 tokens
+    {
+        CHECK(decide::worst_lines_tokens(siblings(), {7, 4, 3}) == (i64s{0, 9, 9}));
+        CHECK(decide::worst_lines_tokens(chain(), {7, 4, 3}) == (i64s{0, 9, 15}));
+    }
+
+    // 5. branch sequences and reserved branch cells per field and state: lines-free tokens + one worst-case lines per sequence
+    {
+        decide::trie_set ts;
+        ts.fields = {region(), two_leaves()};
+        using decide::scoring_mode;
+        CHECK(decide::branch_seqs(ts.fields[0], scoring_mode::TREE) == 2 && decide::branch_seqs(ts.fields[1], scoring_mode::TREE) == 1);
+        CHECK(decide::branch_seqs(ts.fields[0], scoring_mode::FULL_PATH) == 3 && decide::branch_seqs(ts.fields[1], scoring_mode::FULL_PATH) == 2);
+        // tree: region 2 + 3 tokens (root at the stem, node 1 after {10}), two_leaves 1
+        CHECK(decide::count_branches(ts.fields[0], scoring_mode::TREE).tokens == 5 && decide::count_branches(ts.fields[0], scoring_mode::TREE).rows == 2);
+        ts.mode = scoring_mode::TREE;
+        CHECK(decide::reserved_branch_tokens(ts, {0, 6}) == (i64s{5, 1 + 6}));
+        CHECK(decide::reserved_branch_tokens(ts, {4, 6}) == (i64s{5 + 2 * 4, 1 + 6}));
+        // full-path: region (2+2) + (2+2) + (2+1) = 11 over 3 sequences, two_leaves 2 + 2 over 2
+        CHECK(decide::count_branches(ts.fields[0], scoring_mode::FULL_PATH).tokens == 11 && decide::count_branches(ts.fields[0], scoring_mode::FULL_PATH).rows == 5);
+        ts.mode = scoring_mode::FULL_PATH;
+        CHECK(decide::reserved_branch_tokens(ts, {4, 6}) == (i64s{11 + 3 * 4, 4 + 2 * 6}));
+        // the trie set's count is the sum of the fields'
+        CHECK(decide::count_branches(ts).tokens == 15 && decide::count_branches(ts).rows == 8);
+    }
+
+    // 6. spec 5.3 context-trie cache: one entry per (field, lines), built once, never moved, nothing stored when the build throws
+    {
+        decide::context_cache cache;
+        int made = 0;
+        const auto make = [&made](int64_t n) {
+            return [&made, n] {
+                made++;
+                decide::context_entry e;
+                e.tokens = n;
+                return e;
+            };
+        };
+        const decide::context_entry & a = cache.get(1, "L1", make(10));
+        const decide::context_entry & b = cache.get(1, "L1", make(20));
+        CHECK(made == 1 && &a == &b && b.tokens == 10);
+        const decide::context_entry & c = cache.get(1, "L2", make(30));   // other lines
+        const decide::context_entry & d = cache.get(2, "L1", make(40));   // same lines, other field
+        CHECK(made == 3 && &c != &a && &d != &a && &c != &d && c.tokens == 30 && d.tokens == 40);
+        for (int i = 0; i < 100; ++i) {
+            cache.get(3, std::to_string(i), make(i));
+        }
+        CHECK(made == 103 && cache.size() == 103);
+        CHECK(&cache.get(1, "L1", make(99)) == &a && a.tokens == 10 && made == 103);
+        bool threw = false;
+        try {
+            cache.get(4, "L", [&]() -> decide::context_entry { made++; throw decide::error("engine", 500, "x", "f"); });
+        } catch (const decide::error &) {
+            threw = true;
+        }
+        CHECK(threw && cache.size() == 103);
+        CHECK(cache.get(4, "L", make(7)).tokens == 7 && made == 105 && cache.size() == 104);
+    }
+}
+
+// a control token whose text the template tokenizer parses back into it (the join check skips such text)
+static std::string control_text(const llama_vocab * vocab) {
+    for (llama_token t = 0; t < llama_vocab_n_tokens(vocab); ++t) {
+        if (!llama_vocab_is_control(vocab, t)) {
+            continue;
+        }
+        const std::string s = common_token_to_piece(vocab, t, true);
+        if (!s.empty() && decide::tokenize_template(vocab, s) == std::vector<llama_token>{t}) {
+            return s;
+        }
+    }
+    return "";
+}
+
+static void with_vocab(const llama_vocab * vocab) {
+    using decide::scoring_mode;
+    const std::string tail = "{\n";
+
+    // 7. spec 5.4 line tokens: per ancestor, the longest jointly tokenised line of its options; 0 for fields no one is after
+    {
+        const auto cs = chain();
+        const auto lm = decide::line_tokens_max(cs, vocab);
+        CHECK(lm.size() == 3 && lm[2] == 0);
+        for (size_t f = 0; f < 2 && f < lm.size(); ++f) {
+            int64_t want = 0;
+            for (const auto & o : cs.fields[f].options) {
+                want = std::max<int64_t>(want, (int64_t) decide::tokenize_plain(vocab, decide::stem_text(cs.fields[f]) + o.encoded + ",\n").size());
+            }
+            CHECK(want > 0 && lm[f] == want);
+        }
+        std::printf("line tokens max: queue %lld, urgency %lld\n", (long long) lm[0], (long long) lm[1]);
+        CHECK(decide::line_tokens_max(schema(QUEUE), vocab) == (i64s{0}));
+    }
+
+    // 8. the worst case bounds the real context tries: every answer combination as lines, both modes, both configurations;
+    //    and each context trie passes the tail|context-stem join check
+    for (const scoring_mode mode : {scoring_mode::TREE, scoring_mode::FULL_PATH}) {
+        for (const bool deep : {false, true}) {
+            const auto cs       = deep ? chain() : siblings();
+            const auto ts       = decide::build_tries(cs, vocab, mode);
+            const auto reserved = decide::reserved_branch_tokens(ts, decide::worst_lines_tokens(cs, decide::line_tokens_max(cs, vocab)));
+            int64_t min_slack = INT64_MAX;
+            int     checked   = 0;
+            for (int q = 0; q < 4; ++q) {
+                for (int u = 0; u < 4; ++u) {
+                    for (size_t f = 1; f < 3; ++f) {
+                        const auto al = decide::lines_for(cs, f, {q, u, -1});
+                        const auto ct = decide::context_trie(ts.fields[f], cs.fields[f], al.text, vocab);
+                        const int64_t exact = decide::count_branches(ct, mode).tokens;
+                        CHECK(exact <= reserved[f]);
+                        CHECK(exact > decide::count_branches(ts.fields[f], mode).tokens);   // the lines add cells
+                        CHECK(no_throw([&] { decide::check_context_join(vocab, tail, cs.fields[f], ct, al.text, "test"); }));
+                        min_slack = std::min(min_slack, reserved[f] - exact);
+                        checked++;
+                    }
+                }
+            }
+            std::printf("worst-case lines, %s, %s: %d context tries, reserved - exact >= %lld cells per state\n",
+                        mode == scoring_mode::TREE ? "tree" : "full_path", deep ? "chain" : "siblings", checked, (long long) min_slack);
+        }
+    }
+
+    // 9. spec 5.3 join check: a context stem that is not the joint tokenisation is the 500 of spec 11, naming the field
+    {
+        const auto cs = siblings();
+        const auto ts = decide::build_tries(cs, vocab, scoring_mode::TREE);
+        const auto al = decide::lines_for(cs, 1, {0, -1, -1});
+        auto ct = decide::context_trie(ts.fields[1], cs.fields[1], al.text, vocab);
+        CHECK(no_throw([&] { decide::check_context_join(vocab, tail, cs.fields[1], ct, al.text, "test"); }));
+        ct.stem.back() = ct.stem.back() == 0 ? 1 : 0;
+        CHECK(throws_engine([&] { decide::check_context_join(vocab, tail, cs.fields[1], ct, al.text, "test"); }, "urgency",
+                            "answer lines change the tokenisation of field \"urgency\""));
+        // the probe includes the first option's path: a changed path fails too
+        auto cp = decide::context_trie(ts.fields[2], cs.fields[2], al.text, vocab);
+        cp.paths[0].push_back(cp.paths[0].back());
+        CHECK(throws_engine([&] { decide::check_context_join(vocab, tail, cs.fields[2], cp, al.text, "test"); }, "angry",
+                            "answer lines change the tokenisation of field \"angry\""));
+    }
+
+    // 10. a quote-split dependent (tree mode: " \"" and " \"<" conflict, the fallback resolves it): the stem is the lines + stem text
+    //     + "\"" tokenised jointly, the join check covers it; a quote-split ancestor's line is its encoded answer
+    {
+        const auto qs = schema(std::string(QUEUE) + R"(,
+            "q": {"type": "choice", "description": "d", "options": ["a", "<b"], "after": ["queue"]},
+            "angry": {"type": "bool", "description": "Angry?", "after": ["q"]})");
+        const auto ts = decide::build_tries(qs, vocab, scoring_mode::TREE);
+        CHECK(ts.fields[1].quote_split);
+        for (int q = 0; q < 4; ++q) {
+            const auto al = decide::lines_for(qs, 1, {q, -1, -1});
+            auto ct = decide::context_trie(ts.fields[1], qs.fields[1], al.text, vocab);
+            CHECK(ct.quote_split && ct.paths == ts.fields[1].paths);
+            CHECK(ct.stem == decide::tokenize_plain(vocab, al.text + decide::stem_text(qs.fields[1]) + "\""));
+            CHECK(no_throw([&] { decide::check_context_join(vocab, tail, qs.fields[1], ct, al.text, "test"); }));
+            ct.stem.pop_back();
+            CHECK(throws_engine([&] { decide::check_context_join(vocab, tail, qs.fields[1], ct, al.text, "test"); }, "q",
+                                "answer lines change the tokenisation of field \"q\""));
+        }
+        // angry is after q, q after queue: both are its ancestors, in declaration order
+        const auto al = decide::lines_for(qs, 2, {0, 1, -1});
+        CHECK(al.text == "  \"queue\": \"billing\",\n  \"q\": \"<b\",\n" && al.given.dump() == R"({"queue":"billing","q":"<b"})");
+        const auto ct = decide::context_trie(ts.fields[2], qs.fields[2], al.text, vocab);
+        CHECK(no_throw([&] { decide::check_context_join(vocab, tail, qs.fields[2], ct, al.text, "test"); }));
+    }
+
+    // 11. lines with control-token text are skipped like check_trie_joins skips such fields (the joint probe would parse the token)
+    {
+        const std::string ctl = control_text(vocab);
+        CHECK(!ctl.empty());
+        common_json body = common_json::parse(R"({"fields": {"c": {"type": "choice", "description": "c"},
+                                                            "n": {"type": "bool", "description": "n", "after": ["c"]}}, "states": ["x"]})");
+        body["fields"]["c"]["options"] = common_json::array({ctl, "plain"});
+        const auto cs   = decide::compile_request(body);
+        const auto base = decide::build_trie(cs.fields[1], vocab, scoring_mode::TREE);
+        const auto al   = decide::lines_for(cs, 1, {0, -1});
+        auto ct = decide::context_trie(base, cs.fields[1], al.text, vocab);
+        ct.stem.back() = ct.stem.back() == 0 ? 1 : 0;
+        CHECK(no_throw([&] { decide::check_context_join(vocab, tail, cs.fields[1], ct, al.text, "test"); }));
+        std::printf("control-token text skipped: %s\n", ctl.c_str());
+    }
+}
+
+int main(int argc, char ** argv) {
+    model_free();
+    if (argc < 2) {
+        std::printf("test-decide-after: model-free checks only (no vocab file)\n");
+    } else {
+        llama_backend_init();
+        auto mparams       = llama_model_default_params();
+        mparams.vocab_only = true;
+        llama_model * model = llama_model_load_from_file(argv[1], mparams);
