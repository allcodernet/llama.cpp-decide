--- /dev/null
+++ b/tools/decide/decide-after.h
@@ -0,0 +1,61 @@
+#pragma once
+#include "decide-schema.h"
+#include "decide-score.h"
+#include "decide-trie.h"
+#include "llama.h"
+
+#include <cstdint>
+#include <functional>
+#include <map>
+#include <string>
+#include <utility>
+#include <vector>
+
+// Sequential fields (spec 5): phases, answer lines, the worst-case line budget and the context tries of one request.
+namespace decide {
+
+// spec 5.1: per level, its field indices in declaration order; phase L scores the fields of level L
+std::vector<std::vector<size_t>> phase_fields(const compiled_schema & cs);
+
+// the option the answer reports as its value (answer_json): bool "true" when p_true >= 0.5, else the argmax
+int answer_option(const field & f, const field_answer & a);
+
+// spec 5.2: lines(F) of one state: over F's ancestors G in declaration order, stem_text(G) + the encoded answer of G + ",\n".
+// option_of[G] is the option G answered in that state. given = {G name: answer value}; null without ancestors.
+struct answer_lines {
+    std::string text;
+    common_json given;
+};
+answer_lines lines_for(const compiled_schema & cs, size_t f, const std::vector<int> & option_of);
+
+// branch sequences of a field per state and variant: tree = its branch nodes, full-path = its options
+int branch_seqs(const field_trie & t, scoring_mode mode);
+
+// spec 5.4: per field that some field is after, the most tokens of stem_text + encoded + ",\n" over its options (tokenised jointly); else 0
+std::vector<int64_t> line_tokens_max(const compiled_schema & cs, const llama_vocab * vocab);
+// spec 5.4: per field, the worst-case tokens of its lines: sum over its ancestors G of line_max[G] + 2 (0 without "after")
+std::vector<int64_t> worst_lines_tokens(const compiled_schema & cs, const std::vector<int64_t> & line_max);
+
+// spec 5.3: the trie of a field after one lines text, its full-path plan and its branch tokens (cells) per state and variant
+struct context_entry {
+    field_trie                 trie;
+    std::vector<full_path_seq> plan;   // full-path mode
+    int64_t                    tokens = 0;
+};
+// spec 5.3: the context tries of one request, keyed by (field index, lines text); make() builds a missing entry once, entries do not move
+class context_cache {
+public:
+    const context_entry & get(size_t field, const std::string & lines, const std::function<context_entry()> & make);
+    size_t size() const { return entries.size(); }
+
+private:
+    std::map<std::pair<size_t, std::string>, context_entry> entries;
+};
+
+// spec 5.3: the tail|context-stem join, checked as check_trie_joins does for the lines-free stem: tail_text + lines + stem_text(f) +
+// first option ("\"" when quote-split) must tokenise as the tail + ct.stem (+ ct.paths[0]). Text with control tokens is skipped.
+// Throws error{"engine", 500, "answer lines change the tokenisation of field ...", f.name}.
+void check_context_join(const llama_vocab * vocab, const std::string & tail_text, const field & f, const field_trie & ct,
+                        const std::string & lines, const std::string & who);
+
+} // namespace decide
