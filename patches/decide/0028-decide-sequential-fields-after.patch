+            with_vocab(llama_model_get_vocab(model));
+            llama_model_free(model);
+        }
+        llama_backend_free();
+    }
+    if (failures) {
+        std::fprintf(stderr, "%d failure(s)\n", failures);
+        return 1;
+    }
