new file mode 100644
index 000000000..0f4fe3542
--- /dev/null
+++ b/tools/decide/decide-after.cpp
@@ -0,0 +1,110 @@
+#include "decide-after.h"
+
+#include <algorithm>
+
+namespace decide {
+
+std::vector<std::vector<size_t>> phase_fields(const compiled_schema & cs) {
+    std::vector<std::vector<size_t>> out((size_t) max_level(cs) + 1);
+    for (size_t f = 0; f < cs.fields.size(); ++f) {
+        out[(size_t) cs.fields[f].level].push_back(f);
+    }
+    return out;
+}
+
+int answer_option(const field & f, const field_answer & a) {
+    if (f.type == field_type::BOOL) {
+        return a.probs[0] >= 0.5 ? 0 : 1;
+    }
+    return a.argmax;
+}
+
+// option o as the answer's "value": the key, the level or true/false
+static common_json answer_value(const field & f, int o) {
+    if (f.type == field_type::CHOICE) {
+        return common_json(f.options[o].key);
+    }
+    if (f.type == field_type::SCORE) {
+        return common_json(o);
+    }
+    return common_json(o == 0);
+}
+
+answer_lines lines_for(const compiled_schema & cs, size_t f, const std::vector<int> & option_of) {
+    const field & F = cs.fields[f];
+    answer_lines  out;
+    for (int g : F.ancestors) {
+        const field & G = cs.fields[g];
+        const int     o = (size_t) g < option_of.size() ? option_of[g] : -1;
+        if (o < 0 || o >= (int) G.options.size()) {
+            throw error("engine", 500, "field \"" + F.name + "\": no answer of \"" + G.name + "\" for its lines", F.name);
+        }
+        out.text += stem_text(G) + G.options[o].encoded + ",\n";
+        if (out.given.is_null()) {
+            out.given = common_json::object();
+        }
+        out.given[G.name] = answer_value(G, o);
+    }
+    return out;
+}
+
+int branch_seqs(const field_trie & t, scoring_mode mode) {
+    return mode == scoring_mode::FULL_PATH ? (int) t.paths.size() : (int) t.branch_nodes.size();
+}
+
+std::vector<int64_t> line_tokens_max(const compiled_schema & cs, const llama_vocab * vocab) {
+    std::vector<bool> ancestor(cs.fields.size(), false);
+    for (const field & f : cs.fields) {
+        for (int g : f.ancestors) {
+            ancestor[g] = true;
+        }
+    }
+    std::vector<int64_t> out(cs.fields.size(), 0);
+    for (size_t g = 0; g < cs.fields.size(); ++g) {
+        if (!ancestor[g]) {
+            continue;
+        }
+        for (const option & o : cs.fields[g].options) {
+            out[g] = std::max<int64_t>(out[g], (int64_t) tokenize_plain(vocab, stem_text(cs.fields[g]) + o.encoded + ",\n").size());
+        }
+    }
+    return out;
+}
+
+std::vector<int64_t> worst_lines_tokens(const compiled_schema & cs, const std::vector<int64_t> & line_max) {
+    std::vector<int64_t> out(cs.fields.size(), 0);
+    for (size_t f = 0; f < cs.fields.size(); ++f) {
+        for (int g : cs.fields[f].ancestors) {
+            out[f] += line_max[g] + 2;   // 2 tokens slack per line: a token can span two lines or a line and the key
+        }
+    }
+    return out;
+}
+
+const context_entry & context_cache::get(size_t field, const std::string & lines, const std::function<context_entry()> & make) {
+    const auto key = std::make_pair(field, lines);
+    auto       it  = entries.find(key);
+    if (it == entries.end()) {
+        it = entries.emplace(key, make()).first;
+    }
+    return it->second;
+}
+
+void check_context_join(const llama_vocab * vocab, const std::string & tail_text, const field & f, const field_trie & ct,
+                        const std::string & lines, const std::string & who) {
+    const std::string        text = lines + stem_text(f) + (ct.quote_split ? "\"" : f.options[0].encoded);
+    std::vector<llama_token> toks = ct.stem;
+    if (!ct.quote_split) {
+        toks.insert(toks.end(), ct.paths[0].begin(), ct.paths[0].end());
+    }
+    if (tokenize_template(vocab, text) != tokenize_plain(vocab, text)) {
+        return;   // control-token text: the joint probe would parse it differently
+    }
+    try {
+        check_join(vocab, tail_text, text, toks, who, "trunk/branch (field \"" + f.name + "\")");
+    } catch (const error &) {
+        throw error("engine", 500, "answer lines change the tokenisation of field \"" + f.name + "\" at the trunk/branch join; remove its \"after\"", f.name);
+    }
+}
+
+} // namespace decide
