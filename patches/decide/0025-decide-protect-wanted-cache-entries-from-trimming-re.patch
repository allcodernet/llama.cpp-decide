--- /dev/null
+++ b/tests/test-decide-cache.cpp
@@ -0,0 +1,31 @@
+// spec 6.2 prefix cache trim: cache_victim picks the entry to drop while the cache is over its limits
+#include "decide-engine.h"
+#include <cstdio>
+
+static int failures = 0;
+#define CHECK(cond) do { if (!(cond)) { std::fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #cond); failures++; } } while (0)
+
+int main() {
+    using decide::cache_victim;
+
+    // capacity 2 after A, B, C: the request for A snapshots C (last); B goes, not the wanted A
+    CHECK(cache_victim({1, 2, 3}, {true, false, false}) == 1);
+    // nothing wanted: plain LRU
+    CHECK(cache_victim({1, 2, 3}, {false, false, false}) == 0);
+    // LRU by tick, not by position
+    CHECK(cache_victim({5, 2, 9}, {false, false, false}) == 1);
+    CHECK(cache_victim({5, 2, 9}, {false, true, false}) == 0);
+    // every older entry wanted: the new snapshot goes instead
+    CHECK(cache_victim({1, 2, 3}, {true, true, false}) == 2);
+    CHECK(cache_victim({1, 2, 3}, {true, true, true}) == 2);
+    // a wanted new snapshot does not protect older entries that are not wanted
+    CHECK(cache_victim({1, 2, 3}, {false, false, true}) == 0);
+    // one entry over the byte limit: that entry
+    CHECK(cache_victim({7}, {false}) == 0);
+    CHECK(cache_victim({7}, {true}) == 0);
+
+    if (failures == 0) {
+        std::printf("test-decide-cache: OK\n");
+    }
+    return failures == 0 ? 0 : 1;
+}
