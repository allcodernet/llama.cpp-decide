+size_t cache_victim(const std::vector<uint64_t> & used, const std::vector<bool> & wanted) {
+    size_t victim = used.size() - 1;
+    for (size_t i = 0; i + 1 < used.size(); ++i) {
+        if (!wanted[i] && (victim + 1 == used.size() || used[i] < used[victim])) {
+            victim = i;
+        }
+    }
+    return victim;
+}
+
