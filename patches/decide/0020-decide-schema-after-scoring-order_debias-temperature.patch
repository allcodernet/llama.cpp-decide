+// compile_request must fail with exactly this code (http 400), message and error.field
+static void expect_exact(const std::string & body, const std::string & code, const std::string & msg, const std::string & field) {
+    try {
+        (void) decide::compile_request(common_json::parse(body));
+    } catch (const decide::error & e) {
+        if (e.code != code || e.http != 400 || msg != e.what() || e.field != field) {
+            std::fprintf(stderr, "FAIL wrong error for %s\n  got:  code=%s http=%d field=\"%s\" msg=%s\n  want: code=%s http=400 field=\"%s\" msg=%s\n",
+                         body.c_str(), e.code.c_str(), e.http, e.field.c_str(), e.what(), code.c_str(), field.c_str(), msg.c_str());
+            failures++;
+        }
+        return;
+    }
+    std::fprintf(stderr, "FAIL no error for %s (wanted %s)\n", body.c_str(), msg.c_str());
+    failures++;
+}
+
+// compile_request must succeed; a rejection ends the test (later checks index into the fields)
+static decide::compiled_schema accept(const std::string & body) {
+    try {
+        return decide::compile_request(common_json::parse(body));
+    } catch (const decide::error & e) {
+        std::fprintf(stderr, "FAIL rejected %s: %s\n", body.c_str(), e.what());
+        std::exit(1);
+    }
+}
+
+// body with bool fields {name, raw JSON of "after" or ""} in this order and the given options object
+static std::string bools(const std::vector<std::pair<std::string, std::string>> & fields, const std::string & options = "{}") {
+    std::string s = R"({"fields": {)";
+    for (size_t i = 0; i < fields.size(); ++i) {
+        s += (i ? ", " : "") + decide::json_string(fields[i].first) + R"(: {"type": "bool", "description": "d")";
+        if (!fields[i].second.empty()) s += R"(, "after": )" + fields[i].second;
+        s += "}";
+    }
+    return s + R"(}, "states": ["x"], "options": )" + options + "}";
+}
+
+// ["f0", ..., "f<n-1>"]
+static std::string names(int n) {
+    std::string s = "[";
+    for (int i = 0; i < n; ++i) s += (i ? ", \"f" : "\"f") + std::to_string(i) + "\"";
+    return s + "]";
+}
+
+// chain f0 <- f1 <- ... <- f<last>: f<i>.after = ["f<i-1>"], so f<i> has level i
+static std::string chain(int last) {
+    std::vector<std::pair<std::string, std::string>> f;
+    for (int i = 0; i <= last; ++i) f.push_back({"f" + std::to_string(i), i ? "[\"f" + std::to_string(i - 1) + "\"]" : ""});
+    return bools(f);
+}
