+// DFS along "after" from `from`; true when it reaches `to`, with the path appended. Marks every visited field in `seen`.
+static bool reach(const std::vector<std::vector<int>> & deps, int from, int to, std::vector<bool> & seen, std::vector<int> & path) {
+    for (int d : deps[from]) {
+        if (d == to) {
+            path.push_back(d);
+            return true;
+        }
+        if (seen[d]) continue;
+        seen[d] = true;
+        path.push_back(d);
+        if (reach(deps, d, to, seen, path)) return true;
+        path.pop_back();
+    }
+    return false;
+}
+
+static int level_of(const std::vector<std::vector<int>> & deps, int i, std::vector<int> & level) {
+    if (level[i] < 0) {
+        int l = 0;
+        for (int d : deps[i]) l = std::max(l, 1 + level_of(deps, d, level));
+        level[i] = l;
+    }
+    return level[i];
+}
+
+// names, self, cycles and levels of "after" (spec 3.1, 5.1); fills ancestors and level
+static void resolve_after(std::vector<field> & fields) {
+    const int n = (int) fields.size();
+    std::vector<std::vector<int>> deps(n);
+    for (int i = 0; i < n; ++i) {
+        const std::string what = "field \"" + fields[i].name + "\": after: ";
+        for (const auto & a : fields[i].after) {
+            int j = 0;
+            while (j < n && fields[j].name != a) j++;
+            if (j == n) throw error("invalid_schema", 400, what + "unknown field \"" + a + "\"", fields[i].name);
+            deps[i].push_back(j);
+        }
+        for (int d : deps[i])
+            if (d == i) throw error("invalid_schema", 400, what + "names the field itself", fields[i].name);
+    }
+    // a cycle is reported at its first field in declaration order; with no cycle through i, `seen` holds the ancestors of i
+    for (int i = 0; i < n; ++i) {
+        std::vector<bool> seen(n, false);
+        std::vector<int>  path = {i};
+        if (reach(deps, i, i, seen, path)) {
+            std::string text;
+            for (size_t k = 0; k < path.size(); ++k) text += (k ? " -> " : "") + fields[path[k]].name;
+            throw error("invalid_schema", 400, "field \"" + fields[i].name + "\": after: cycle " + text, fields[i].name);
+        }
+        for (int j = 0; j < n; ++j)
+            if (seen[j]) fields[i].ancestors.push_back(j);
+    }
+    std::vector<int> level(n, -1);
+    for (int i = 0; i < n; ++i) {
+        fields[i].level = level_of(deps, i, level);
+        if (fields[i].level > 8) throw error("invalid_schema", 400, "field \"" + fields[i].name + "\": after: dependency level " + std::to_string(fields[i].level) + " is above 8", fields[i].name);
+    }
+}
