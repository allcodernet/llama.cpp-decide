+// a feature without its engine part is a clean 500, not a wrong answer; the engine change for a feature removes its line
+static void require_implemented(const compiled_schema & cs) {
+    const auto missing = [](const char * feature) { return error("engine", 500, std::string("not implemented yet: ") + feature); };
+    if (cs.opts.scoring == "full_path")  throw missing("full_path");
+    if (max_level(cs) > 0)               throw missing("after");
+    if (effective_variants(cs) > 1)      throw missing("order_debias");
+    if (cs.opts.temperature != 0)        throw missing("temperature");
+}
