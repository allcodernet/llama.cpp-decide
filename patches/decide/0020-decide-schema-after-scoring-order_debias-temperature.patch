+    // catalogue variants (spec 7.1): variant 0 is today's text; choice options rotate left by floor(v * n / K_eff)
+    {
+        auto vs = accept(VARIANTS);
+        CHECK(decide::effective_variants(vs) == 4);
+        CHECK(variant_text(0, 0) == GOLDEN_V0);
+        const std::string v0 = decide::render_catalogue(vs, 0, 1);
+        if (v0 != GOLDEN_V0) { std::fprintf(stderr, "FAIL variant 0 of 1:\n---got---\n%s\n---want---\n%s\n", v0.c_str(), GOLDEN_V0); failures++; }
+        const size_t queue_start[4] = {0, 1, 2, 3};   // n = 4 = K_eff
+        const size_t tone_start[4]  = {0, 0, 1, 2};   // n = 3 < K_eff
+        for (int v = 0; v < 4; ++v) {
+            const std::string got  = decide::render_catalogue(vs, v, 4);
+            const std::string want = variant_text(queue_start[v], tone_start[v]);   // score and bool text as in variant 0
+            if (got != want) { std::fprintf(stderr, "FAIL variant %d of 4:\n---got---\n%s\n---want---\n%s\n", v, got.c_str(), want.c_str()); failures++; }
+        }
+        // a variant outside 0..variants-1 is an engine error, not a crash
+        const auto engine_error = [&](int v, int k) {
+            try {
+                (void) decide::render_catalogue(vs, v, k);
+            } catch (const decide::error & e) {
+                return e.code == "engine" && e.http == 500;
+            }
+            return false;
+        };
+        CHECK(engine_error(0, 0) && engine_error(4, 4) && engine_error(-1, 4));
+
+        // effective_variants: min(K, largest choice option count); 1 when off or without a choice field
+        vs.opts.order_debias = 0; CHECK(decide::effective_variants(vs) == 1);
+        vs.opts.order_debias = 1; CHECK(decide::effective_variants(vs) == 1);
+        vs.opts.order_debias = 2; CHECK(decide::effective_variants(vs) == 2);
+        vs.opts.order_debias = 8; CHECK(decide::effective_variants(vs) == 4);
+        auto three = accept(R"({"fields": {"c3": {"type": "choice", "description": "d", "options": ["a", "b", "c"]},
+                                           "c2": {"type": "choice", "description": "d", "options": ["a", "b"]},
+                                           "s":  {"type": "score", "description": "d", "levels": ["0", "1", "2", "3", "4"]}},
+                                "states": ["x"], "options": {"order_debias": 4}})");
+        CHECK(decide::effective_variants(three) == 3);   // score levels do not count
+        auto no_choice = accept(R"({"fields": {"s": {"type": "score", "description": "d", "levels": ["0", "1", "2", "3", "4"]},
+                                               "b": {"type": "bool", "description": "d"}},
+                                    "states": ["x"], "options": {"order_debias": 4}})");
+        CHECK(decide::effective_variants(no_choice) == 1);
+    }
+
+    // after: a chain queue <- urgency <- angry
+    {
+        auto c = accept(R"({"fields": {
+            "queue":   {"type": "choice", "description": "d", "options": ["billing", "technical"]},
+            "urgency": {"type": "score", "description": "d", "levels": ["low", "high"], "after": ["queue"]},
+            "angry":   {"type": "bool", "description": "d", "after": ["urgency"]}}, "states": ["x"]})");
+        CHECK(c.fields[0].after.empty() && c.fields[0].ancestors.empty() && c.fields[0].level == 0);
+        CHECK(c.fields[1].after == std::vector<std::string>{"queue"});
+        CHECK(c.fields[1].ancestors == std::vector<int>{0} && c.fields[1].level == 1);
+        CHECK(c.fields[2].after == std::vector<std::string>{"urgency"});
+        CHECK((c.fields[2].ancestors == std::vector<int>{0, 1}) && c.fields[2].level == 2);
+        CHECK(decide::max_level(c) == 2);
+    }
+    // after: a diamond declared dependent first; ancestors in declaration order, after kept as given
+    {
+        auto c = accept(bools({{"d", R"(["c", "b"])"}, {"c", R"(["a"])"}, {"b", R"(["a"])"}, {"a", ""}, {"e", ""}}));
+        CHECK((c.fields[0].after == std::vector<std::string>{"c", "b"}));
+        CHECK((c.fields[0].ancestors == std::vector<int>{1, 2, 3}) && c.fields[0].level == 2);
+        CHECK(c.fields[1].ancestors == std::vector<int>{3} && c.fields[1].level == 1);
+        CHECK(c.fields[2].ancestors == std::vector<int>{3} && c.fields[2].level == 1);
+        CHECK(c.fields[3].ancestors.empty() && c.fields[3].level == 0);
+        CHECK(c.fields[4].ancestors.empty() && c.fields[4].level == 0);
+        CHECK(decide::max_level(c) == 2);
+    }
+    // after: 8 entries and level 8 are the limits
