+        const std::string sc = "invalid_schema";
+        expect_exact(bools({{"a", ""}, {"b", R"("a")"}}),        sc, "field \"b\": after: must be an array", "b");
+        expect_exact(bools({{"a", ""}, {"b", "null"}}),           sc, "field \"b\": after: must be an array", "b");
+        expect_exact(bools({{"a", ""}, {"b", "[]"}}),             sc, "field \"b\": after: must have 1 to 8 entries", "b");
+        expect_exact(bools({{"a", ""}, {"b", R"(["a", 1])"}}),    sc, "field \"b\": after: entries must be strings", "b");
+        expect_exact(bools({{"a", ""}, {"b", R"(["a", "a"])"}}),  sc, "field \"b\": after: duplicate \"a\"", "b");
+        expect_exact(bools({{"a", ""}, {"b", R"(["a", "zz"])"}}), sc, "field \"b\": after: unknown field \"zz\"", "b");
+        expect_exact(bools({{"a", ""}, {"b", R"(["a", "b"])"}}),  sc, "field \"b\": after: names the field itself", "b");
+        expect_exact(bools({{"a", R"(["b"])"}, {"b", R"(["a"])"}}), sc, "field \"a\": after: cycle a -> b -> a", "a");
+        // the first field on the cycle in declaration order, not the first field that reaches the cycle
+        expect_exact(bools({{"x", R"(["a"])"}, {"b", R"(["a"])"}, {"a", R"(["b"])"}}), sc, "field \"b\": after: cycle b -> a -> b", "b");
+        // arrows follow "after": c is after a, a after b, b after c
+        expect_exact(bools({{"c", R"(["a"])"}, {"a", R"(["b"])"}, {"b", R"(["c"])"}}), sc, "field \"c\": after: cycle c -> a -> b -> c", "c");
+        expect_exact(chain(9), sc, "field \"f9\": after: dependency level 9 is above 8", "f9");
+    }
+
+    // options: scoring, order_debias, temperature (spec 3.1)
+    {
+        const auto with = [](const std::string & options) { return bools({{"b", ""}}, options); };
+        CHECK(accept(with(R"({"scoring": "full_path"})")).opts.scoring == "full_path");
+        CHECK(accept(with(R"({"scoring": "tree"})")).opts.scoring == "tree");
+        for (int k = 0; k <= 8; ++k) CHECK(accept(with(R"({"order_debias": )" + std::to_string(k) + "}")).opts.order_debias == k);
+        CHECK(accept(with(R"({"temperature": 0.05})")).opts.temperature == 0.05);
+        CHECK(accept(with(R"({"temperature": 20})")).opts.temperature == 20.0);
+        CHECK(accept(with(R"({})")).opts.temperature == 0);   // absent: the server default applies
+        const auto all = accept(with(R"({"scoring": "full_path", "order_debias": 4, "temperature": 2.5})")).opts;
+        CHECK(all.scoring == "full_path" && all.order_debias == 4 && all.temperature == 2.5);
+
+        const std::string io = "invalid_options";
+        expect_exact(with(R"({"scoring": "x"})"), io, "options.scoring must be \"tree\" or \"full_path\"", "");
+        expect_exact(with(R"({"scoring": 1})"),   io, "options.scoring must be \"tree\" or \"full_path\"", "");
+        for (const char * v : {"9", "-1", "1.5", "\"2\"", "4294967298"}) {   // 2^32 + 2 must not wrap to 2
+            expect_exact(with(std::string(R"({"order_debias": )") + v + "}"), io, "options.order_debias must be an integer from 0 to 8", "");
+        }
+        for (const char * v : {"0.04", "21", "\"1\"", "0"}) {   // 0 is not a temperature (absent means the default)
+            expect_exact(with(std::string(R"({"temperature": )") + v + "}"), io, "options.temperature must be a number from 0.05 to 20", "");
