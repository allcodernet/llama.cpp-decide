new file mode 100644
index 000000000..be9c7c497
--- /dev/null
+++ b/tests/test-decide-debias.cpp
@@ -0,0 +1,160 @@
+// spec 6.1, 7, 8 without a model: the sequence layout of K catalogue variants, the sequence budget and its 400 message, the request
+// temperature, and one field's answer from its variant answers (mean, order_spread, mean coverage, then temperature)
+#include "decide-debias.h"
+
+#include <cmath>
+#include <cstdio>
+#include <set>
+#include <string>
+#include <vector>
+
+static int failures = 0;
+#define CHECK(cond) do { if (!(cond)) { std::fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #cond); failures++; } } while (0)
+
+static bool near(double a, double b, double eps = 1e-12) { return std::fabs(a - b) < eps; }
+
+static decide::field choice2() {
+    decide::field f; f.name = "c"; f.type = decide::field_type::CHOICE;
+    for (const char * k : {"x", "y"}) f.options.push_back({k, "", decide::json_string(k)});
+    return f;
+}
+static decide::field score3() {
+    decide::field f; f.name = "u"; f.type = decide::field_type::SCORE;
+    for (int i = 0; i < 3; ++i) f.options.push_back({std::to_string(i), "L", std::to_string(i)});
+    return f;
+}
+static decide::field bool2() {
+    decide::field f; f.name = "b"; f.type = decide::field_type::BOOL;
+    f.options = {{"true", "", "true"}, {"false", "", "false"}};
+    return f;
+}
+static decide::field_answer answer(const decide::field & f, std::vector<double> p, double coverage = NAN) {
+    decide::field_answer extras; extras.coverage = coverage;
+    return decide::rebuild_answer(f, p, extras);
+}
+template <typename F> static bool engine_500(F fn, const char * text) {
+    try { fn(); }
+    catch (const decide::error & e) { return e.code == "engine" && e.http == 500 && std::string(e.what()).find(text) != std::string::npos; }
+    return false;
+}
+
+int main() {
+    using decide::trunk_seq;
+
+    // 1. spec 6.1 layout. K = 1 is the layout without debiasing: prefix in seq_base, trunk c at seq_base + 1 + c (1 + B)
+    for (int B : {1, 3, 10}) {
+        for (size_t c = 0; c < 5; ++c) {
+            CHECK(trunk_seq(7, 1, B, c, 0) == 7 + 1 + (llama_seq_id) c * (1 + B));
+        }
+    }
+    // K = 2, B = 3 from seq_base 1: slots 1, 2; state 0 owns 3..10 (trunks 3 and 7), state 1 owns 11..18 (trunks 11 and 15)
+    CHECK(trunk_seq(1, 2, 3, 0, 0) == 3 && trunk_seq(1, 2, 3, 0, 1) == 7 && trunk_seq(1, 2, 3, 1, 0) == 11 && trunk_seq(1, 2, 3, 1, 1) == 15);
+    // K = 4, B = 10 from seq_base 1: slots 1..4, state 0 owns 5..48, variant 3's trunk at 5 + 3 * 11
+    CHECK(trunk_seq(1, 4, 10, 0, 0) == 5 && trunk_seq(1, 4, 10, 0, 3) == 38 && trunk_seq(1, 4, 10, 1, 0) == 49);
+    // every trunk and branch id of a full round: each id once, the block of state c is [base + K + c S, base + K + (c + 1) S),
+    // no id below base + K (the prefix slots) or at base + D and above
+    for (int K : {1, 2, 4}) {
+        for (int B : {3, 10}) {
+            const int D = 64, base = 5;
+            const decide::seq_budget b = decide::sequence_budget(D, K, B);
+            CHECK(b.seqs_per_state == K * (1 + B) && b.states_per_round >= 1);
+            std::set<llama_seq_id> ids;
+            bool in_block = true;
+            for (int c = 0; c < b.states_per_round; ++c) {
+                const llama_seq_id lo = base + K + c * b.seqs_per_state;
+                for (int v = 0; v < K; ++v) {
+                    const llama_seq_id T = trunk_seq(base, K, B, (size_t) c, v);
+                    CHECK(T == lo + v * (1 + B));
+                    for (int i = 0; i <= B; ++i) {   // the trunk, then its B branches
+                        ids.insert(T + i);
+                        in_block = in_block && T + i >= lo && T + i < lo + b.seqs_per_state;
+                    }
+                }
+            }
+            CHECK(in_block);
+            CHECK((int) ids.size() == b.states_per_round * b.seqs_per_state);
+            CHECK(*ids.begin() == base + K && *ids.rbegin() == base + K + b.states_per_round * b.seqs_per_state - 1);
+            CHECK(*ids.rbegin() < base + D);
+        }
+    }
+
+    // 2. spec 7.3 budget: K (1 + B) sequences per state, (D - K) / that states per round; 0 is the 400 with the numbers
+    {
+        using decide::sequence_budget;
+        const auto sb = [](int D, int K, int B) { const decide::seq_budget b = sequence_budget(D, K, B); return std::vector<int>{b.seqs_per_state, b.states_per_round}; };
+        CHECK(sb(9, 1, 3) == (std::vector<int>{4, 2}));      // triage tree without debiasing
+        CHECK(sb(64, 1, 3) == (std::vector<int>{4, 15}));
+        CHECK(sb(64, 2, 3) == (std::vector<int>{8, 7}));
+        CHECK(sb(32, 2, 3) == (std::vector<int>{8, 3}));
+        CHECK(sb(21, 4, 3) == (std::vector<int>{16, 1}));    // Qwen3.5-9B, K = 4, tree
+        CHECK(sb(64, 4, 10) == (std::vector<int>{44, 1}));   // every switch on Qwen2.5-0.5B
+        CHECK(sb(32, 4, 10) == (std::vector<int>{44, 0}));   // every switch on Qwen3.5-4B
+        CHECK(sb(3, 1, 3) == (std::vector<int>{4, 0}));
+        CHECK(sb(3, 4, 3) == (std::vector<int>{16, 0}));     // fewer sequences than prefix slots
+        CHECK(decide::sequence_budget_message(32, 4, 10, "full_path") ==
+              "schema needs 44 sequences per state (K_eff 4 \u00d7 (1 trunk + 10 branch sequences, full_path)); --decide-seqs 32 leaves 28 after 4 prefix slots");
+        // K = 1: the budget texts without debiasing
+        CHECK(decide::sequence_budget_message(3, 1, 3, "tree") ==
+              "schema needs 4 sequences per state (K_eff 1 \u00d7 (1 trunk + 3 branch sequences, tree)); --decide-seqs 3 leaves 2 after 1 prefix slots");
+        CHECK(decide::sequence_budget_message(10, 1, 10, "full_path") ==
+              "schema needs 11 sequences per state (K_eff 1 \u00d7 (1 trunk + 10 branch sequences, full_path)); --decide-seqs 10 leaves 9 after 1 prefix slots");
+    }
+
+    // 3. spec 8: options.temperature when given (0 = not given), else the server default
+    {
+        CHECK(decide::resolve_temperature(0.0, 1.0) == 1.0);
+        CHECK(decide::resolve_temperature(0.0, 0.7) == 0.7);
+        CHECK(decide::resolve_temperature(2.0, 1.0) == 2.0);
+        CHECK(decide::resolve_temperature(0.5, 2.0) == 0.5);
+    }
+
+    // 4. spec 7.2, 8: a field's answer from its variant answers
+    {
+        using decide::combine_variants;
+        // one variant at T = 1: the variant's answer itself (the answer without debiasing, bit for bit), no order_spread
+        const decide::field s = score3();
+        const decide::field_answer one = answer(s, {0.1, 0.6, 0.3});
+        const decide::field_answer same = combine_variants(s, {one}, 1.0);
+        CHECK(same.probs == one.probs && same.argmax == one.argmax && same.expected == one.expected);
+        CHECK(std::isnan(same.coverage) && std::isnan(same.order_spread) && same.given.is_null());
+        const decide::field_answer full = combine_variants(s, {answer(s, {0.1, 0.6, 0.3}, 0.93)}, 1.0);
+        CHECK(full.coverage == 0.93 && std::isnan(full.order_spread));
+        CHECK(!decide::answer_json(s, same).contains("order_spread") && decide::answer_json(s, same).dump() == decide::answer_json(s, one).dump());
+
+        // two variants at T = 1: the mean [0.4, 0.6]; order_spread max(0.6 - 0.2, 0.8 - 0.4) = 0.4; coverage the mean 0.8
+        const decide::field c = choice2();
+        const decide::field_answer v0 = answer(c, {0.6, 0.4}, 0.9), v1 = answer(c, {0.2, 0.8}, 0.7);
+        const decide::field_answer m = combine_variants(c, {v0, v1}, 1.0);
+        CHECK(near(m.probs[0], 0.4) && near(m.probs[1], 0.6) && m.argmax == 1 && near(m.order_spread, 0.4) && near(m.coverage, 0.8));
+
+        // T = 2 on the mean, not on the variants: p_T = sqrt(0.4) : sqrt(0.6); value, order_spread and coverage stay those of the mean
+        const decide::field_answer t = combine_variants(c, {v0, v1}, 2.0);
+        const double z = std::sqrt(0.4) + std::sqrt(0.6);
+        CHECK(near(t.probs[0], std::sqrt(0.4) / z) && near(t.probs[1], std::sqrt(0.6) / z) && t.argmax == 1);   // 0.4495, 0.5505
+        CHECK(near(t.order_spread, 0.4) && near(t.coverage, 0.8));
+        // tempering each variant before the mean gives another distribution (0.4419 for x)
+        const double tv0 = std::sqrt(0.6) / (std::sqrt(0.6) + std::sqrt(0.4)), tv1 = std::sqrt(0.2) / (std::sqrt(0.2) + std::sqrt(0.8));
+        CHECK(!near(t.probs[0], (tv0 + tv1) / 2, 1e-4));
+
+        // score: expected and confidence from the tempered mean. Mean of [0.2, 0.3, 0.5] and [0.4, 0.3, 0.3] = [0.3, 0.3, 0.4];
+        // T = 0.5: 0.09 : 0.09 : 0.16 over 0.34
+        const decide::field_answer st = combine_variants(s, {answer(s, {0.2, 0.3, 0.5}), answer(s, {0.4, 0.3, 0.3})}, 0.5);
+        CHECK(near(st.probs[0], 0.09 / 0.34) && near(st.probs[2], 0.16 / 0.34) && st.argmax == 2);
+        CHECK(near(st.expected, (0.09 + 2 * 0.16) / 0.34) && near(st.order_spread, 0.2));
+        CHECK(near(decide::answer_json(s, st).at("confidence").get<double>(), 0.16 / 0.34));
+
+        // bool, K = 4 (the mean [0.4, 0.6]), T = 0.5: 0.16 : 0.36 over 0.52; value false; order_spread 0.3 (p_true 0.25 .. 0.55)
+        const decide::field b = bool2();
+        const decide::field_answer bt = combine_variants(b, {answer(b, {0.55, 0.45}), answer(b, {0.25, 0.75}), answer(b, {0.4, 0.6}), answer(b, {0.4, 0.6})}, 0.5);
+        const common_json j = decide::answer_json(b, bt);
+        CHECK(j.at("value").get<bool>() == false && near(j.at("p_true").get<double>(), 0.16 / 0.52) && near(j.at("confidence").get<double>(), 0.36 / 0.52));
+        CHECK(near(j.at("order_spread").get<double>(), 0.3) && !j.contains("coverage"));
+
+        // a temperature that was not resolved (0) is an engine error, not a distribution
+        CHECK(engine_500([&] { combine_variants(c, {v0, v1}, 0.0); }, "temperature"));
+    }
+
+    if (failures) { std::fprintf(stderr, "%d failure(s)\n", failures); return 1; }
+    std::printf("test-decide-debias: OK\n");
+    return 0;
+}
