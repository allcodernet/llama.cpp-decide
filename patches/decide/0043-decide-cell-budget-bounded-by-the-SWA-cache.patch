+// spec 7.3: the 400 budget message when state i needs more than cell_limit(n_ctx, swa_cells) cells; K = 1 is the text without debiasing.
 // Sub-project 4 (spec 3.2, 5.3): `state` counts text tokens and image cells; with image_cells > 0 the text names them
-std::string state_cells_message(size_t i, int64_t held, int64_t prefix, int K, int64_t state, int64_t tail, int64_t branches, int64_t limit,
-                                int64_t image_cells = 0);
