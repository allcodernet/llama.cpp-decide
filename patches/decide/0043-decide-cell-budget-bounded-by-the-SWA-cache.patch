diff --git a/tools/decide/decide-debias.cpp b/tools/decide/decide-debias.cpp
index eb41df82e..cdac72c31 100644
--- a/tools/decide/decide-debias.cpp
+++ b/tools/decide/decide-debias.cpp
@@ -25,13 +25,33 @@ int64_t state_cells(int64_t held, int64_t prefix, int K, int64_t state, int64_t
     return held + prefix + K * (state + tail + branches);
 }
 
-std::string state_cells_message(size_t i, int64_t held, int64_t prefix, int K, int64_t state, int64_t tail, int64_t branches, int64_t limit,
-                                int64_t image_cells) {
+int64_t swa_cache_cells(int64_t kv_size, int64_t n_swa, int64_t n_seq_max, int64_t n_ubatch, bool unified, bool swa_full) {
+    if (n_swa <= 0 || swa_full) {
+        return kv_size;
+    }
+    const int64_t cells = std::min(kv_size, n_swa * (unified ? n_seq_max : 1) + n_ubatch);
+    return (cells + 255) / 256 * 256;   // GGML_PAD(cells, 256)
+}
+
+int64_t cell_limit(int64_t n_ctx, int64_t swa_cells) {
+    return std::min(n_ctx, swa_cells) - 16;
+}
+
+std::string cell_limit_text(int64_t n_ctx, int64_t swa_cells) {
+    if (swa_cells >= n_ctx) {
+        return "n_ctx - 16 is " + std::to_string(n_ctx - 16);
+    }
+    return "the sliding-window cache holds " + std::to_string(swa_cells) + " cells (limit " + std::to_string(cell_limit(n_ctx, swa_cells)) +
+           "); start with --swa-full to use n_ctx";
+}
+
+std::string state_cells_message(size_t i, int64_t held, int64_t prefix, int K, int64_t state, int64_t tail, int64_t branches, int64_t n_ctx,
+                                int64_t swa_cells, int64_t image_cells) {
     const std::string state_text  = "state " + std::to_string(state) + (image_cells > 0 ? " (image cells " + std::to_string(image_cells) + ")" : "");
     const std::string per_variant = state_text + ", tail " + std::to_string(tail) + ", branches " + std::to_string(branches);
     return "state " + std::to_string(i) + " needs " + std::to_string(state_cells(held, prefix, K, state, tail, branches)) + " cells (held " +
            std::to_string(held) + ", prefix " + std::to_string(prefix) + ", " +
-           (K == 1 ? per_variant : "K_eff " + std::to_string(K) + " \u00d7 (" + per_variant + ")") + "), n_ctx - 16 is " + std::to_string(limit);
+           (K == 1 ? per_variant : "K_eff " + std::to_string(K) + " \u00d7 (" + per_variant + ")") + "), " + cell_limit_text(n_ctx, swa_cells);
 }
 
