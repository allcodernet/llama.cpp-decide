+        CHECK(swa_cache_cells(4096, 1000, 4, 100, false, false) == 1280);    // 1100 padded to 256
+        // padding to 256 after the cap: 512 x 16 + 500 = 8692 -> 8704; 1000 x 3 + 100 = 3100 -> 3328
