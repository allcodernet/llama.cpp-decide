+#pragma once
+#include "decide-schema.h"
+#include "decide-trie.h"
+#include "chat.h"
+#include "llama.h"
+#include <cstdint>
+#include <functional>
+#include <string>
+#include <vector>
+
+namespace decide {
+
+struct engine_config {
+    int                       decide_seqs = 0;   // >= 3
+    llama_seq_id              seq_base    = 0;   // first reserved seq id
+    std::vector<llama_seq_id> slot_seqs;         // sequences owned by server slots (for the cell check); empty in the CLI
+};
+
+struct prefix_state {
+    std::string              hash;              // hex64(fnv1a64(prefix_text + "\x1e" + tail_text))
+    std::string              prefix_text, tail_text, assistant_prefix;
+    std::vector<llama_token> tokens;            // prefix tokens in seq P
+    std::vector<llama_token> tail_tokens;       // template tail + "{"
+    bool                     valid = false;
+};
+
+class engine {
+public:
+    // Throws error{"engine", 500, "no chat template; pass --chat-template"} when
+    // !common_chat_templates_was_explicit(tmpls) (the ChatML fallback is not accepted).
+    engine(llama_context * ctx, const llama_model * model, const common_chat_templates * tmpls, engine_config cfg);
+    ~engine();
+    engine(const engine &) = delete;
+    engine & operator=(const engine &) = delete;
+
+    // Full request: throws decide::error; never leaves trunks/branches behind.
+    common_json decide(const compiled_schema & cs, const trie_set & ts, const std::vector<std::string> & states, bool dump_tokens);
+    // Info JSON (spec 3.3); builds/validates the prefix for cs when given.
+    common_json info(const compiled_schema * cs, const trie_set * ts);
+
+private:
+    // one token of a phase; `tag` names the branch whose logit row it requests (-1: no logits)
+    struct entry {
+        llama_token  tok;
+        llama_pos    pos;
+        llama_seq_id seq;
+        int          tag;
+    };
+    // prefix, tail and hash of one rendering (cs == nullptr: placeholder system text)
+    struct rendered {
+        std::string prefix_text, tail_text, assistant_prefix, hash;
+    };
+    // per-request counters
+    struct stats {
+        int     decodes       = 0;
+        int     rounds        = 0;
+        int64_t prompt_tokens = 0;
+        int64_t prefill_us    = 0;
+        int64_t scoring_us    = 0;
+    };
+
+    rendered render(const compiled_schema * cs) const;
+    // returns true when the cached prefix was reused
+    bool     ensure_prefix(const compiled_schema & cs, stats & st);
+    bool     prefix_live() const;
+    // returns 0, or 1 when a decode found no KV slot (caller cleans up and retries); throws on anything else.
+    // Fills answers[first + c] for every state c of the round.
+    int      run_round(const compiled_schema & cs, const trie_set & ts, int seqs_per_state,
+                       const std::vector<std::vector<llama_token>> & state_tokens, size_t first, size_t count,
+                       std::vector<common_json> & answers, stats & st);
+    int      decode_chunked(const std::vector<entry> & entries, const std::function<void(size_t, size_t)> & on_chunk_done, stats & st);
+    void     cleanup(int seqs_per_state, size_t count);
+    int64_t  held_cells() const;
+
+    llama_context               * ctx;
+    const llama_model           * model;
+    const llama_vocab           * vocab;
+    const common_chat_templates * tmpls;
+    engine_config                 cfg;
+    llama_memory_t                mem;
+    llama_batch                   batch;
+    int                           n_batch;
+    prefix_state                  p;
+};
+
+} // namespace decide
