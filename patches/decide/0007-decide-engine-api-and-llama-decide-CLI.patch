diff --git a/tools/decide/decide-api.cpp b/tools/decide/decide-api.cpp
new file mode 100644
index 000000000..d02f4e362
--- /dev/null
+++ b/tools/decide/decide-api.cpp
@@ -0,0 +1,44 @@
+#include "decide-api.h"
+
+#include <exception>
+
+namespace decide {
+
+static api_result error_result(int status, const std::string & code, const std::string & message) {
+    common_json e = common_json::object();
+    e["message"] = message;
+    e["code"]    = code;
+    common_json body = common_json::object();
+    body["error"] = e;
+    return {status, body};
+}
+
+api_result handle_decide(engine & eng, const llama_vocab * vocab, const common_json & body, bool dump_tokens) {
+    try {
+        const compiled_schema          cs     = compile_request(body);
+        const std::vector<std::string> states = states_of(body);
+        const trie_set                 ts     = build_tries(cs, vocab);
+        return {200, eng.decide(cs, ts, states, dump_tokens)};
+    } catch (const error & e) {
+        return error_result(e.http, e.code, e.what());
+    } catch (const std::exception & e) {
+        return error_result(500, "engine", e.what());
+    }
+}
+
+api_result handle_info(engine & eng, const llama_vocab * vocab, const common_json * schema_body) {
+    try {
+        if (schema_body == nullptr) {
+            return {200, eng.info(nullptr, nullptr)};
+        }
+        const compiled_schema cs = compile_request(*schema_body);
+        const trie_set        ts = build_tries(cs, vocab);
+        return {200, eng.info(&cs, &ts)};
+    } catch (const error & e) {
+        return error_result(e.http, e.code, e.what());
+    } catch (const std::exception & e) {
+        return error_result(500, "engine", e.what());
+    }
+}
+
+} // namespace decide
