From 518540229ab69e37e27eb112694e0afd903dcec0 Mon Sep 17 00:00:00 2001
From: allcodernet <67543055+allcodernet@users.noreply.github.com>
Date: Sat, 26 Sep 2026 00:31:53 +0200
Subject: [PATCH 29/45] decide: one value rule for answers, given and lines;
 keep join-check detail

answer_option (the option an answer reports: bool true when p_true >= 0.5,
else the argmax) and option_value (its JSON: key, level, true/false) move to
decide-score; answer_json, lines_for and the context tries use them, so a
dependent field's given and lines always equal the value its ancestor returns.
The context join error keeps the spec text and appends check_join's token
detail. Behaviour-neutral: the tree dump and the live `after` runs are unchanged.
---
 tests/test-decide-after.cpp   | 17 ++++++++++++++++-
 tests/test-decide-score.cpp   | 21 +++++++++++++++++++++
 tools/decide/decide-after.cpp | 31 +++++++++----------------------
 tools/decide/decide-after.h   |  5 +----
 tools/decide/decide-score.cpp | 24 +++++++++++++++++++++---
 tools/decide/decide-score.h   |  5 +++++
 6 files changed, 73 insertions(+), 30 deletions(-)

diff --git a/tests/test-decide-after.cpp b/tests/test-decide-after.cpp
index a588b030c..ee9b285ba 100644
--- a/tests/test-decide-after.cpp
+++ b/tests/test-decide-after.cpp
@@ -82,6 +82,16 @@ template <typename F> static bool throws_engine(F f, const std::string & field,
     return false;
 }
 
+// the message of the decide::error f() throws, "" when it throws nothing
+template <typename F> static std::string error_message(F f) {
+    try {
+        f();
+    } catch (const decide::error & e) {
+        return e.what();
+    }
+    return "";
+}
+
 template <typename F> static bool no_throw(F f) {
     try {
         f();
@@ -130,7 +140,7 @@ static void model_free() {
         CHECK(decide::answer_option(angry, tie) == 0 && decide::answer_json(angry, tie).at("value").dump() == "true");
         const auto no = answer({0.3, 0.7}, 1);
         CHECK(decide::answer_option(angry, no) == 1 && decide::answer_json(angry, no).at("value").dump() == "false");
-        // probabilities one rounding short of 1: the argmax is "true", the reported value is false; the lines follow the value
+        // probabilities 3e-8 short of 1 (0.49999999 + 0.49999998): the argmax is "true", the reported value is false; the lines follow the value
         const auto short_sum = answer({0.49999999, 0.49999998}, 0);
         CHECK(decide::answer_option(angry, short_sum) == 1 && decide::answer_json(angry, short_sum).at("value").dump() == "false");
     }
@@ -299,6 +309,11 @@ static void with_vocab(const llama_vocab * vocab) {
         ct.stem.back() = ct.stem.back() == 0 ? 1 : 0;
         CHECK(throws_engine([&] { decide::check_context_join(vocab, tail, cs.fields[1], ct, al.text, "test"); }, "urgency",
                             "answer lines change the tokenisation of field \"urgency\""));
+        // the spec 11 text first, then check_join's token detail (without its "model not supported" part)
+        const std::string m = error_message([&] { decide::check_context_join(vocab, tail, cs.fields[1], ct, al.text, "test"); });
+        CHECK(m.rfind("answer lines change the tokenisation of field \"urgency\"; remove its \"after\" (trunk/branch (field \"urgency\") join \"", 0) == 0);
+        CHECK(m.find("tokenises jointly as [") != std::string::npos && m.find("separately as [") != std::string::npos && m.back() == ')');
+        CHECK(m.find("model not supported") == std::string::npos);
         // the probe includes the first option's path: a changed path fails too
         auto cp = decide::context_trie(ts.fields[2], cs.fields[2], al.text, vocab);
         cp.paths[0].push_back(cp.paths[0].back());
diff --git a/tests/test-decide-score.cpp b/tests/test-decide-score.cpp
index 033102e75..489b6b060 100644
--- a/tests/test-decide-score.cpp
+++ b/tests/test-decide-score.cpp
@@ -2,6 +2,8 @@
 #include <cmath>
 #include <cstdio>
 #include <limits>
+#include <utility>
+#include <vector>
 
 static int failures = 0;
 #define CHECK(cond) do { if (!(cond)) { std::fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #cond); failures++; } } while (0)
@@ -339,6 +341,25 @@ int main() {
         CHECK(decide::answer_json(bool2(), b).dump() ==
               R"({"value":true,"p_true":0.75,"confidence":0.75,"coverage":0.5,"order_spread":0.125,"given":{"queue":"billing"}})");
     }
+    // 21. one value rule: answer_option picks the option an answer reports (choice and score: the argmax; bool: true when
+    //     p_true >= 0.5), option_value writes it, and answer_json's "value" is exactly that
+    {
+        const auto answer = [](std::vector<double> p, int argmax) {
+            decide::field_answer a; a.probs = std::move(p); a.argmax = argmax; a.expected = 0.0; return a;
+        };
+        const decide::field q = choice4(), s = score4(), b = bool2();
+        const auto qa = answer({0.2, 0.5, 0.1, 0.2}, 1);
+        CHECK(decide::answer_option(q, qa) == 1 && decide::option_value(q, 1).dump() == R"("b")");
+        const auto sa = answer({0.1, 0.2, 0.3, 0.4}, 3);
+        CHECK(decide::answer_option(s, sa) == 3 && decide::option_value(s, 3).dump() == "3");
+        CHECK(decide::option_value(b, 0).dump() == "true" && decide::option_value(b, 1).dump() == "false");
+        // bool: the tie reports true; 0.49999999 vs 0.49999998 (3e-8 short of 1) has argmax 0 but reports false
+        const auto tie = answer({0.5, 0.5}, 0), no = answer({0.3, 0.7}, 1), short_sum = answer({0.49999999, 0.49999998}, 0);
+        CHECK(decide::answer_option(b, tie) == 0 && decide::answer_option(b, no) == 1 && decide::answer_option(b, short_sum) == 1);
+        for (const auto & [f, a] : std::vector<std::pair<decide::field, decide::field_answer>>{{q, qa}, {s, sa}, {b, tie}, {b, no}, {b, short_sum}}) {
+            CHECK(decide::answer_json(f, a).at("value").dump() == decide::option_value(f, decide::answer_option(f, a)).dump());
+        }
+    }
     if (failures) { std::fprintf(stderr, "%d failure(s)\n", failures); return 1; }
     std::printf("test-decide-score: OK\n");
     return 0;
