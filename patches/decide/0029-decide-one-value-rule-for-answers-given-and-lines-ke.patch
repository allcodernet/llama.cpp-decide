 answer_lines lines_for(const compiled_schema & cs, size_t f, const std::vector<int> & option_of) {
     const field & F = cs.fields[f];
     answer_lines  out;
@@ -43,7 +25,7 @@ answer_lines lines_for(const compiled_schema & cs, size_t f, const std::vector<i
         if (out.given.is_null()) {
             out.given = common_json::object();
         }
-        out.given[G.name] = answer_value(G, o);
+        out.given[G.name] = option_value(G, o);
     }
     return out;
 }
@@ -100,10 +82,15 @@ void check_context_join(const llama_vocab * vocab, const std::string & tail_text
     if (tokenize_template(vocab, text) != tokenize_plain(vocab, text)) {
         return;   // control-token text: the joint probe would parse it differently
     }
+    const std::string join = "trunk/branch (field \"" + f.name + "\")";
     try {
-        check_join(vocab, tail_text, text, toks, who, "trunk/branch (field \"" + f.name + "\")");
-    } catch (const error &) {
-        throw error("engine", 500, "answer lines change the tokenisation of field \"" + f.name + "\" at the trunk/branch join; remove its \"after\"", f.name);
+        check_join(vocab, tail_text, text, toks, who, join);
+    } catch (const error & e) {
+        // keep check_join's token detail from the join name on; its first part blames the model, not the lines
+        const std::string what = e.what();
+        const size_t      at   = what.find(join);
+        throw error("engine", 500, "answer lines change the tokenisation of field \"" + f.name + "\"; remove its \"after\" (" +
+                                       (at == std::string::npos ? what : what.substr(at)) + ")", f.name);
     }
 }
 
