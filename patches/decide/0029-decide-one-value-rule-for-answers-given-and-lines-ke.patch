+int answer_option(const field & f, const field_answer & a) {
+    if (f.type == field_type::BOOL) {
+        return a.probs[0] >= 0.5 ? 0 : 1;
+    }
+    return a.argmax;
+}
+
+common_json option_value(const field & f, int o) {
+    if (f.type == field_type::CHOICE) {
+        return common_json(f.options[o].key);
+    }
+    if (f.type == field_type::SCORE) {
+        return common_json(o);
+    }
+    return common_json(o == 0);
+}
+
 static common_json answer_json_base(const field & f, const field_answer & a) {
     double confidence = a.probs[a.argmax];
+    const common_json value = option_value(f, answer_option(f, a));
 
     if (f.type == field_type::CHOICE) {
         common_json probs = common_json::object();
@@ -315,7 +333,7 @@ static common_json answer_json_base(const field & f, const field_answer & a) {
             probs[f.options[i].key] = a.probs[i];
         }
         common_json j = common_json::object();
-        j["value"]         = f.options[a.argmax].key;
+        j["value"]         = value;
         j["probabilities"] = probs;
         j["confidence"]    = confidence;
         return j;
@@ -327,7 +345,7 @@ static common_json answer_json_base(const field & f, const field_answer & a) {
             probs.push_back(p);
         }
         common_json j = common_json::object();
-        j["value"]         = a.argmax;
+        j["value"]         = value;
         j["expected"]      = a.expected;
         j["probabilities"] = probs;
         j["confidence"]    = confidence;
@@ -336,7 +354,7 @@ static common_json answer_json_base(const field & f, const field_answer & a) {
 
     // BOOL: options[0] = "true", options[1] = "false"
     common_json j = common_json::object();
-    j["value"]      = a.probs[0] >= 0.5;
+    j["value"]      = value;
     j["p_true"]     = a.probs[0];
     j["confidence"] = std::max(a.probs[0], a.probs[1]);
     return j;
