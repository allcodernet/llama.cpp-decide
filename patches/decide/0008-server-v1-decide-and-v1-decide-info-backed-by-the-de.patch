+    // needs ctx_tgt and chat_params.tmpls; no-op when --decide-seqs is 0
+    bool init_decide_engine() {
+        if (params_base.decide_seqs <= 0) {
+            return true;
+        }
+
+        decide::engine_config cfg;
+        cfg.decide_seqs = params_base.decide_seqs;
+        cfg.seq_base    = (llama_seq_id) params_base.n_parallel;
+        for (int i = 0; i < params_base.n_parallel; i++) {
+            cfg.slot_seqs.push_back((llama_seq_id) i);
+        }
+
+        try {
+            decide_engine = std::make_unique<decide::engine>(ctx_tgt, model_tgt, chat_params.tmpls.get(), cfg);
+        } catch (const decide::error & e) {
+            SRV_ERR("decide: %s\n", e.what());
+            return false;
+        }
+
+        SRV_INF("decide: %d sequences reserved above %d slots; memory recurrent=%d swa=%d\n",
+                params_base.decide_seqs, params_base.n_parallel,
+                (llama_model_is_recurrent(model_tgt) || llama_model_is_hybrid(model_tgt)) ? 1 : 0,
+                llama_model_n_swa(model_tgt) > 0 ? 1 : 0);
+        if (params_base.n_parallel > 1) {
+            SRV_WRN("decide: n_parallel = %d - slots and decisions share the %d cells of n_ctx\n",
+                    params_base.n_parallel, n_ctx);
+        }
+
+        return true;
+    }
