@@ -2722,6 +2772,27 @@ private:
                     res->id = task.id;
                     queue_results.send(std::move(res));
                 } break;
+            case SERVER_TASK_TYPE_DECIDE:
+                {
+                    // runs the whole decision synchronously; slots are not advanced meanwhile
+                    auto res = std::make_unique<server_task_result_decide>();
+                    res->id = task.id;
+                    if (!decide_engine) {
+                        json err = json::object();
+                        err["message"] = "decide endpoint disabled (--decide-seqs 0)";
+                        err["code"]    = "disabled";
+                        res->status = 404;
+                        res->data   = json::object();
+                        res->data["error"] = err;
+                    } else {
+                        const decide::api_result r = task.decide_info
+                            ? decide::handle_info(*decide_engine, vocab, task.decide_request.is_null() ? nullptr : &task.decide_request)
+                            : decide::handle_decide(*decide_engine, vocab, task.decide_request, false);
+                        res->status = r.status;
+                        res->data   = r.body;
+                    }
+                    queue_results.send(std::move(res));
+                } break;
         }
 
         return true;
@@ -5285,6 +5356,83 @@ void server_routes::init_routes() {
         res->ok(result->to_json());
         return res;
     };
+
+    // decide routes: the status is set directly, since res->error() derives it from an integer "code"
+    // while decide errors carry string codes
+    const auto decide_error = [](server_res_generator & res, int status, const std::string & message, const std::string & code) {
+        json err = json::object();
+        err["message"] = message;
+        err["code"]    = code;
+        json body = json::object();
+        body["error"] = err;
+        res.status = status;
+        res.data   = safe_json_to_str(body);
+    };
+
+    const auto decide_run = [](server_res_generator & res, const server_http_req & req, json request, bool info) {
+        auto & rd = res.rd;
+        {
+            server_task task(SERVER_TASK_TYPE_DECIDE);
+            task.id             = rd.get_new_id();
+            task.decide_request = std::move(request);
+            task.decide_info    = info;
+            rd.post_task(std::move(task));
+        }
+
+        auto result = rd.next(req.should_stop);
+        if (!result) {
+            // connection was closed
+            GGML_ASSERT(req.should_stop());
+            return;
+        }
+
+        const auto * dres = dynamic_cast<server_task_result_decide *>(result.get());
+        if (dres == nullptr) {
+            GGML_ASSERT(result->is_error());
+            res.error(result->to_json());
+            return;
+        }
+        res.status = dres->status;
+        res.data   = safe_json_to_str(dres->data);
+    };
+
+    this->post_decide = [this, decide_error, decide_run](const server_http_req & req) {
+        auto res = create_response();
+        if (params.decide_seqs <= 0) {
+            decide_error(*res, 404, "decide endpoint disabled (--decide-seqs 0)", "disabled");
+            return res;
+        }
+
+        json body = json::parse_no_throw(req.body);
+        if (body.is_discarded()) {
+            decide_error(*res, 400, "request body is not valid JSON", "invalid_schema");
+            return res;
+        }
+
+        // validate here so that bad requests never reach the model
+        try {
+            decide::compile_request(body);
+            decide::states_of(body);
+        } catch (const decide::error & e) {
+            decide_error(*res, e.http, e.what(), e.code);
+            return res;
+        }
+
+        decide_run(*res, req, std::move(body), false);
+        return res;
+    };
+
+    this->get_decide_info = [this, decide_error, decide_run](const server_http_req & req) {
+        auto res = create_response();
+        if (params.decide_seqs <= 0) {
+            decide_error(*res, 404, "decide endpoint disabled (--decide-seqs 0)", "disabled");
+            return res;
+        }
+
+        // no schema: the engine renders the template-only assistant prefix
+        decide_run(*res, req, json(), true);
+        return res;
+    };
 }
 
