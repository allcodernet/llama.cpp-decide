+        // the key parts are tokenised alone, so the paths stay the same
+        t.stem = tokenize_plain(vocab, lines + stem_text(f) + "\"");
+        return t;
+    }
+    std::vector<std::vector<llama_token>> toks(f.options.size());
+    for (size_t i = 0; i < f.options.size(); ++i) {
+        toks[i] = tokenize_plain(vocab, lines + stem_text(f) + f.options[i].encoded);
+    }
+    const size_t common = common_prefix_len(toks);
+    t.stem.assign(toks[0].begin(), toks[0].begin() + common);
+    for (size_t i = 0; i < toks.size(); ++i) {
+        if (!std::equal(toks[i].begin() + common, toks[i].end(), base.paths[i].begin(), base.paths[i].end())) {
