             ok = false;
@@ -127,10 +187,23 @@ int main() {
         // (e.g. "cat"/"cats", "tech"/"technical") and record the pieces in the report.
         auto bad = decide::compile_request(common_json::parse(R"({"fields": {"q": {"type": "choice", "description": "d", "options": ["sale", "sales"]}}, "states": ["x"]})"));
         bool threw = false; std::string msg; std::string field;
-        try { decide::build_tries(bad, vocab); } catch (const decide::error & e) { threw = e.code == "invalid_schema"; msg = e.what(); field = e.field; }
+        try { decide::build_tries(bad, vocab, decide::scoring_mode::TREE); } catch (const decide::error & e) { threw = e.code == "invalid_schema"; msg = e.what(); field = e.field; }
         CHECK(threw);
         CHECK(msg.find("\"sale\"") != std::string::npos && msg.find("\"sales\"") != std::string::npos);
