+        CHECK(threw);
     }
     // 255-option choice builds
     {
@@ -138,9 +211,186 @@ int main() {
         for (int i = 0; i < 255; ++i) { opts += (i ? ",\"opt" : "\"opt") + std::to_string(i) + "\""; }
         opts += "]";
         auto big = decide::compile_request(common_json::parse(R"({"fields": {"c": {"type": "choice", "description": "d", "options": )" + opts + R"(}}, "states": ["x"]})"));
-        auto tb = decide::build_tries(big, vocab);
+        auto tb = decide::build_tries(big, vocab, decide::scoring_mode::TREE);
         CHECK(tb.fields[0].paths.size() == 255 && !tb.fields[0].branch_nodes.empty());
+        auto tf = decide::build_tries(big, vocab, decide::scoring_mode::FULL_PATH);
+        CHECK(tf.branches_per_state == 255 && decide::full_path_plan(tf.fields[0]).size() == 255);
     }
+
+    // spec 4.1 vocabulary indexes: END holds the tokens of ",", "}" and "\n"; MERGED["\""] holds "\"," when the vocabulary has it
+    const decide::vocab_index vi = decide::build_vocab_index(vocab);
+    {
+        for (const char * s : {",", "}", "\n"}) {
+            const auto toks = decide::tokenize_plain(vocab, s);
+            CHECK(toks.size() == 1 && contains(vi.end_tokens, toks[0]));
+        }
+        const auto it = vi.merged.find("\"");
+        const std::vector<llama_token> quote = it == vi.merged.end() ? std::vector<llama_token>() : it->second;
+        int bad = 0;   // control tokens, or pieces that do not match the definition
+        for (llama_token u : vi.end_tokens) {
+            bad += llama_vocab_is_control(vocab, u) || !decide::ends_value(common_token_to_piece(vocab, u, false));
+        }
+        for (llama_token u : quote) {
+            const std::string s = common_token_to_piece(vocab, u, false);
+            bad += llama_vocab_is_control(vocab, u) || s.size() < 2 || s[0] != '"' || !decide::ends_value(s.substr(1));
+        }
+        CHECK(bad == 0);
+        const auto qc = decide::tokenize_plain(vocab, "\",");
+        if (qc.size() == 1) {
+            CHECK(!quote.empty() && contains(quote, qc[0]));
+        }
+        std::printf("END: %zu tokens, MERGED: %zu bases; the \",\" token: %s\n", vi.end_tokens.size(), vi.merged.size(), qc.size() == 1 ? show(vocab, qc).c_str() : "none");
+        std::printf("MERGED[\"\\\"\"] (%zu): %s\n", quote.size(), show(vocab, quote).c_str());
+    }
+
+    // spec 4.2/4.3 full-path tries: no quote-split fallback; one branch sequence per option; every node read exactly once
+    {
+        auto fcs = decide::compile_request(common_json::parse(R"json({
+          "fields": {
+            "queue":   {"type": "choice", "description": "Which team?", "options": {"billing": "b", "technical": "t", "sales": "s", "feedback": "f"}},
+            "urgency": {"type": "score", "description": "How urgent?", "levels": ["a", "b", "c", "d"]},
+            "angry":   {"type": "bool", "description": "Angry?"},
+            "region":  {"type": "choice", "description": "Where?", "options": ["billing", "billing (EU)", "billing (US)", "tech"]},
+            "q":       {"type": "choice", "description": "d", "options": ["a", "<b"]}
+          }, "states": ["x"]})json"));
+        const auto fts = decide::build_tries(fcs, vocab, decide::scoring_mode::FULL_PATH);
+        CHECK(fts.mode == decide::scoring_mode::FULL_PATH && fts.fields.size() == 5);
+        size_t n_options = 0;
+        for (size_t fi = 0; fi < fts.fields.size(); ++fi) {
+            const auto & f = fcs.fields[fi];
+            const auto & t = fts.fields[fi];
+            n_options += f.options.size();
+            CHECK(!t.quote_split);
+            CHECK(t.option_nodes.size() == f.options.size() && t.paths.size() == f.options.size());
+            for (size_t o = 0; o < f.options.size() && o < t.option_nodes.size(); ++o) {
+                // stem + path is the joint tokenisation; option_nodes runs from the root to the option's own leaf
+                const auto joint = concat(t.stem, t.paths[o]);
+                CHECK(joint == decide::tokenize_plain(vocab, decide::branch_text(f, f.options[o])));
+                const auto & on = t.option_nodes[o];
+                bool ok = on.size() == t.paths[o].size() + 1 && on[0] == 0;
+                for (size_t d = 1; ok && d < on.size(); ++d) ok = t.nodes[on[d]].tok == t.paths[o][d - 1] && contains(t.nodes[on[d - 1]].children, on[d]);
+                CHECK(ok && t.nodes[on.back()].children.empty() && t.nodes[on.back()].options_through == std::vector<int>{(int) o});
+                CHECK(decide::branch_tokens(t, on.back()) == joint);
+            }
+            const auto plan = decide::full_path_plan(t);
+            CHECK(plan.size() == f.options.size());
+            std::vector<int> reads(t.nodes.size(), 0);
+            bool rows_ok = true;
+            for (size_t o = 0; o < plan.size() && rows_ok; ++o) {
+                const auto & s = plan[o];
+                rows_ok = s.option == (int) o && s.tokens == concat(t.stem, t.paths[o]) && !s.row_index.empty() && s.row_index.size() == s.row_node.size();
+                for (size_t r = 0; rows_ok && r < s.row_index.size(); ++r) {
+                    // the row of the node at depth d is read at token stem.size() - 1 + d (the root's row r_0 at the stem's last token)
+                    const int depth = s.row_index[r] - ((int) t.stem.size() - 1);
+                    rows_ok = depth >= 0 && depth < (int) t.option_nodes[o].size() && t.option_nodes[o][depth] == s.row_node[r] &&
+                              (r == 0 || s.row_index[r] > s.row_index[r - 1]);
+                    if (rows_ok) reads[s.row_node[r]]++;
+                }
+            }
+            CHECK(rows_ok);
+            CHECK(std::all_of(reads.begin(), reads.end(), [](int n) { return n == 1; }));
+            CHECK(!plan.empty() && !plan[0].row_node.empty() && plan[0].row_node[0] == 0 && plan[0].row_index[0] == (int) t.stem.size() - 1);
+        }
+        CHECK(fts.branches_per_state == (int) n_options);
+        // without a fallback, the triage fields get the tree-mode tries
+        for (size_t fi = 0; fi < 3; ++fi) CHECK(fts.fields[fi].stem == ts.fields[fi].stem && fts.fields[fi].paths == ts.fields[fi].paths);
+        // region: options 1 and 2 share nodes with option 0, so their sequences skip the rows already read
+        {
+            const auto plan = decide::full_path_plan(fts.fields[3]);
+            CHECK(plan.size() == 4 && plan[1].row_index.size() < fts.fields[3].paths[1].size() + 1 && plan[2].row_index.size() < fts.fields[3].paths[2].size() + 1);
+            for (const auto & s : plan) {
+                std::printf("full-path plan region[%d]: tokens after stem %s, rows at", s.option, show(vocab, fts.fields[3].paths[s.option]).c_str());
+                for (size_t r = 0; r < s.row_index.size(); ++r) std::printf(" %d(node %d)", s.row_index[r], s.row_node[r]);
+                std::printf("\n");
+            }
+        }
+    }
+
+    // spec 5.3 context tries: the lines join the stem, the paths stay the lines-free ones
+    {
+        auto qs = decide::compile_request(common_json::parse(R"({"fields": {"q": {"type": "choice", "description": "d", "options": ["a", "<b"]}}, "states": ["x"]})"));
+        const auto qts = decide::build_tries(qs, vocab, decide::scoring_mode::TREE);
+        CHECK(qts.fields[0].quote_split);   // first children after the stem " \"" and " \"<" conflict; the fallback resolves it
+        struct item { const decide::field * f; const decide::field_trie * t; };
+        const std::vector<item> items = {{&cs.fields[1], &ts.fields[1]}, {&cs.fields[2], &ts.fields[2]}, {&cs.fields[0], &ts.fields[0]}, {&qs.fields[0], &qts.fields[0]}};
+        // the last lines variant ends in a space, so a token spans the lines and the key's indentation
+        int variant = 0;
+        for (const std::string & lines : {std::string("  \"queue\": \"billing\",\n"), std::string("  \"tier\": 3,\n  \"vip\": true,\n"), std::string("  \"queue\": \"billing\",\n ")}) {
+            ++variant;
+            for (const item & it : items) {
+                const decide::field &      f    = *it.f;
+                const decide::field_trie & base = *it.t;
+                decide::field_trie ct;
+                bool threw = false;
+                try { ct = decide::context_trie(base, f, lines, vocab); } catch (const decide::error & e) { threw = true; std::fprintf(stderr, "context trie %s: %s\n", f.name.c_str(), e.what()); }
+                CHECK(!threw);
+                CHECK(ct.paths == base.paths && ct.quote_split == base.quote_split);
+                CHECK(ct.nodes.size() == base.nodes.size() && ct.branch_nodes == base.branch_nodes && ct.option_nodes == base.option_nodes);
+                if (!base.quote_split) {
+                    // stem = common token prefix of lines + stem_text + encoded, and stem + path is each option's joint tokenisation
+                    std::vector<std::vector<llama_token>> joint;
+                    for (const auto & o : f.options) joint.push_back(decide::tokenize_plain(vocab, lines + decide::stem_text(f) + o.encoded));
+                    CHECK(ct.stem == common_prefix(joint));
+                    for (size_t o = 0; o < joint.size() && o < ct.paths.size(); ++o) CHECK(concat(ct.stem, ct.paths[o]) == joint[o]);
+                } else {
+                    CHECK(ct.stem == decide::tokenize_plain(vocab, lines + decide::stem_text(f) + "\""));
+                }
+                // the stem text is the lines + stem text, plus shared value text (" \"") or minus the space a value absorbed (" true")
+                const std::string stem_str = text_of(vocab, ct.stem);
+                const std::string full     = lines + decide::stem_text(f);
+                CHECK(stem_str.compare(0, lines.size(), lines) == 0);
+                CHECK(stem_str.compare(0, full.size(), full) == 0 || full.compare(0, stem_str.size(), stem_str) == 0);
+                const bool split_at_lines = ct.stem == concat(decide::tokenize_plain(vocab, lines), base.stem);
+                std::printf("context trie, lines %d, %-7s (%s): stem = lines tokens + lines-free stem: %s; stem ends %s\n", variant, f.name.c_str(), base.quote_split ? "quote-split" : "joint",
+                            split_at_lines ? "yes" : "no", show(vocab, std::vector<llama_token>(ct.stem.end() - std::min<size_t>(ct.stem.size(), 4), ct.stem.end())).c_str());
+            }
+        }
+        // no lines: the lines-free trie
+        for (const item & it : items) {
+            const auto ct = decide::context_trie(*it.t, *it.f, "", vocab);
+            CHECK(ct.stem == it.t->stem && ct.paths == it.t->paths);
+        }
+        // a path difference is a 500 naming the field
+        {
+            decide::field_trie changed = ts.fields[1];
+            changed.paths[0].push_back(changed.paths[0].back());
+            bool threw = false;
+            try { decide::context_trie(changed, cs.fields[1], "  \"queue\": \"billing\",\n", vocab); } catch (const decide::error & e) {
+                threw = e.code == "engine" && e.http == 500 && std::string(e.what()).find("field \"urgency\"") != std::string::npos;
+            }
+            CHECK(threw);
+        }
+    }
+
+    // spec 4.8 survey (informational): candidate keys whose tokens before the last one change when ",\n" follows
+    {
+        common_json body = common_json::parse(R"({"fields": {"c": {"type": "choice", "description": "d"}}, "states": ["x"]})");
+        body["fields"]["c"]["options"] = common_json::array({"Billing (EU)", "a)", "Other.", "Inc.", "Urgent!", "Now!", "100%", "50%", "Tier 2", "v1.2", "Level 10", "N/A"});
+        const auto kcs = decide::compile_request(body);
+        const auto kts = decide::build_tries(kcs, vocab, decide::scoring_mode::FULL_PATH);
+        const auto & f = kcs.fields[0];
+        const auto & t = kts.fields[0];
+        std::vector<std::string> expect;
+        for (size_t o = 0; o < f.options.size(); ++o) {
+            const auto ctx       = decide::tokenize_plain(vocab, decide::stem_text(f) + f.options[o].encoded + ",\n");
+            const bool stem_kept = ctx.size() >= t.stem.size() && std::equal(t.stem.begin(), t.stem.end(), ctx.begin());
+            const std::vector<llama_token> after(ctx.begin() + (stem_kept ? t.stem.size() : 0), ctx.end());
+            const bool rs = !stem_kept || decide::resplit(t.paths[o], after);
+            if (rs) expect.push_back(f.options[o].key);
+            // how the context covers t_k: the same token, a MERGED[piece(t_k)] token, or another split
+            const size_t k    = t.paths[o].size();
+            std::string  last = "-";
+            if (!rs && after.size() >= k) {
+                const llama_token tk = t.paths[o][k - 1];
+                const auto        m  = vi.merged.find(common_token_to_piece(vocab, tk, false));
+                last = after[k - 1] == tk ? "kept" : (m != vi.merged.end() && contains(m->second, after[k - 1])) ? "merged" : "other";
+            }
+            std::printf("resplit survey: %-14s path %s | with \",\\n\" %s -> resplit %s, last token %s\n", ("\"" + f.options[o].key + "\"").c_str(),
+                        show(vocab, t.paths[o]).c_str(), show(vocab, after).c_str(), rs ? "YES" : "no", last.c_str());
+        }
+        CHECK(t.resplit == expect);
+    }
+
     llama_model_free(model);
     llama_backend_free();
     if (failures) { std::fprintf(stderr, "%d failure(s)\n", failures); return 1; }
