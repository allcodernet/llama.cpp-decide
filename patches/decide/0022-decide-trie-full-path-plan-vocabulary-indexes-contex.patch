diff --git a/tools/decide/decide-vocab.cpp b/tools/decide/decide-vocab.cpp
new file mode 100644
index 000000000..3fc00c9f1
--- /dev/null
+++ b/tools/decide/decide-vocab.cpp
@@ -0,0 +1,47 @@
+#include "decide-vocab.h"
+#include "common.h"
+
+namespace decide {
+
+static bool is_json_space(char c) {
+    return c == ' ' || c == '\t' || c == '\n' || c == '\r';
+}
+
+bool ends_value(const std::string & w) {
+    for (char c : w) {
+        if (!is_json_space(c)) {
+            return c == ',' || c == '}';
+        }
+    }
+    return !w.empty();
+}
+
+vocab_index build_vocab_index(const llama_vocab * vocab) {
+    vocab_index       vi;
+    std::vector<char> tail_ends;   // tail_ends[i]: s[i..] is only whitespace or its first non-whitespace character is ',' or '}'
+    const llama_token n = llama_vocab_n_tokens(vocab);
+    for (llama_token u = 0; u < n; ++u) {
+        if (llama_vocab_is_control(vocab, u)) {
+            continue;
+        }
+        const std::string s = common_token_to_piece(vocab, u, false);
+        if (s.empty()) {
+            continue;
+        }
+        tail_ends.assign(s.size() + 1, 1);
+        for (size_t i = s.size(); i-- > 0;) {
+            tail_ends[i] = is_json_space(s[i]) ? tail_ends[i + 1] : (s[i] == ',' || s[i] == '}');
+        }
+        if (tail_ends[0]) {
+            vi.end_tokens.push_back(u);
+        }
+        for (size_t i = 1; i < s.size(); ++i) {
+            if (tail_ends[i]) {
+                vi.merged[s.substr(0, i)].push_back(u);
+            }
+        }
+    }
+    return vi;
+}
+
+} // namespace decide
