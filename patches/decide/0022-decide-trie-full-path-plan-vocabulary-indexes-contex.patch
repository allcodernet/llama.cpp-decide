+        full_path_seq s;
+        s.option = (int) o;
+        s.tokens = t.stem;
+        s.tokens.insert(s.tokens.end(), t.paths[o].begin(), t.paths[o].end());
+        const std::vector<int> & on = t.option_nodes[o];
+        for (size_t d = 0; d < on.size(); ++d) {
