+++ b/tools/decide/decide-vocab.h
@@ -0,0 +1,20 @@
+#pragma once
+#include "llama.h"
+
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace decide {
+
+// Spec 4.1 ends(w) for text right after a JSON value inside an object: w is not empty and is only whitespace (space, \t, \n, \r) or its first non-whitespace character is ',' or '}'.
+bool ends_value(const std::string & w);
+
+// Spec 4.1 indexes over every non-control token u with piece s = common_token_to_piece(vocab, u, false). Token ids are in ascending order.
+struct vocab_index {
+    std::vector<llama_token>                                  end_tokens;   // END = {u : ends(s)}
+    std::unordered_map<std::string, std::vector<llama_token>> merged;       // MERGED[b] = {u : s = b + r, b not empty, ends(r)} for every split of s
+};
+vocab_index build_vocab_index(const llama_vocab * vocab);
+
+} // namespace decide
