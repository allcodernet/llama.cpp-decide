@@ -82,6 +141,7 @@ int main() {
             decide::check_join(vocab, prefix, "Hi", decide::tokenize_plain(vocab, "Hi"), "test", "prefix/state");
             decide::check_join(vocab, "Hi", tail, decide::tokenize_template(vocab, tail), "test", "state/tail");
