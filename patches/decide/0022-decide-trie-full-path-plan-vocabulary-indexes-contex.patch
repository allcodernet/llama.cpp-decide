+static bool contains(const std::vector<llama_token> & v, llama_token t) { return std::find(v.begin(), v.end(), t) != v.end(); }
+
+static std::vector<llama_token> concat(std::vector<llama_token> a, const std::vector<llama_token> & b) {
+    a.insert(a.end(), b.begin(), b.end());
+    return a;
+}
+
+// longest common token prefix
+static std::vector<llama_token> common_prefix(const std::vector<std::vector<llama_token>> & v) {
+    std::vector<llama_token> out = v[0];
+    for (const auto & x : v) {
+        size_t k = 0;
+        while (k < out.size() && k < x.size() && out[k] == x[k]) ++k;
+        out.resize(k);
+    }
+    return out;
+}
+
+static std::string text_of(const llama_vocab * vocab, const std::vector<llama_token> & toks) {
+    std::string out;
+    for (llama_token t : toks) out += common_token_to_piece(vocab, t, false);
+    return out;
+}
+
+// "id:[piece]" list with escaped whitespace, for the informational printouts
+static std::string show(const llama_vocab * vocab, const std::vector<llama_token> & toks) {
+    std::string out;
+    for (llama_token t : toks) {
+        std::string e;
+        for (char ch : common_token_to_piece(vocab, t, false)) {
+            if (ch == '\n') e += "\\n"; else if (ch == '\r') e += "\\r"; else if (ch == '\t') e += "\\t"; else e += ch;
+        }
+        out += (out.empty() ? "" : " ") + std::to_string(t) + ":[" + e + "]";
+    }
+    return out;
+}
+
