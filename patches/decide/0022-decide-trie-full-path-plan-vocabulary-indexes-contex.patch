+bool resplit(const std::vector<llama_token> & path, const std::vector<llama_token> & in_context) {
+    const size_t n = path.empty() ? 0 : path.size() - 1;
+    return in_context.size() < n || !std::equal(path.begin(), path.begin() + n, in_context.begin());
+}
