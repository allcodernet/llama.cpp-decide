+    // 22. coverage clamp (spec 4.1): float rounding can put the sum of P(o) just above 1; (1, 1 + 1e-6] is reported as exactly
+    //     1, in a single answer and in the debias mean; larger values are left alone
+    {
+        const auto f = choice2("A", "B");
+        // P(A) = 1 (every log-prob 0), P(B) = e^lb
+        const auto rows = [](float lb) {
+            std::vector<decide::node_logp> r(4);
+            r[0].node = 0; r[0].child_logp = {0.0f, lb}; r[0].merged_logp = {NEG_INF, NEG_INF};
+            r[1].node = 1; r[1].child_logp = {0.0f}; r[1].merged_logp = {NEG_INF};
+            r[2].node = 2; r[2].end_logp = 0.0f;
+            r[3].node = 3; r[3].end_logp = 0.0f;
+            return r;
+        };
+        const auto just = decide::score_field_full(f, two_one(), rows(-15.0f));   // 1 + 3.1e-7
+        CHECK(just.coverage == 1.0 && near(just.probs[1], std::exp(-15.0) / (1.0 + std::exp(-15.0)), 1e-15));
+        const auto over = decide::score_field_full(f, two_one(), rows(-10.0f));   // 1 + 4.5e-5
+        CHECK(near(over.coverage, 1.0 + std::exp(-10.0), 1e-12) && over.coverage > 1.0 + 1e-6);
+        const auto with = [&](double c) { decide::field_answer a; a.probs = {0.5, 0.5}; a.argmax = 0; a.expected = 0.0; a.coverage = c; return a; };
+        CHECK(decide::average_variants(f, {with(1.0000015), with(1.0)}).coverage == 1.0);
+        CHECK(decide::average_variants(f, {with(1.00001), with(1.00001)}).coverage == 1.00001);
+        CHECK(decide::average_variants(f, {with(0.9), with(0.8)}).coverage == (0.9 + 0.8) / 2);
+        CHECK(std::isnan(decide::average_variants(f, {with(NAN), with(NAN)}).coverage));
+    }
