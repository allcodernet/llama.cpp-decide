+cache_plan plan_cache_store(const std::vector<uint64_t> & used, const std::vector<bool> & wanted, const std::vector<size_t> & bytes,
+                            bool cached, size_t capacity, size_t byte_limit, size_t new_bytes) {
+    cache_plan plan;
+    if (capacity == 0 || cached || new_bytes == 0 || new_bytes > byte_limit) {
+        return plan;
+    }
+    // the entries left, the new snapshot last (cache_victim's fallback)
+    std::vector<size_t>   left;
+    std::vector<uint64_t> u;
+    std::vector<bool>     w;
+    size_t                total = new_bytes;
+    for (size_t i = 0; i < used.size(); ++i) {
+        left.push_back(i);
+        u.push_back(used[i]);
+        w.push_back(wanted[i]);
+        total += bytes[i];
+    }
+    u.push_back(0);
+    w.push_back(false);
+    while (left.size() + 1 > capacity || total > byte_limit) {
+        const size_t v = cache_victim(u, w);
+        if (v == left.size()) {
+            return cache_plan();
+        }
+        total -= bytes[left[v]];
+        plan.erase.push_back(left[v]);
+        left.erase(left.begin() + v);
+        u.erase(u.begin() + v);
+        w.erase(w.begin() + v);
+    }
+    std::sort(plan.erase.begin(), plan.erase.end());
+    plan.store = true;
+    return plan;
+}
