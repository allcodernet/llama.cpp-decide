diff --git a/tools/decide/decide-score.cpp b/tools/decide/decide-score.cpp
new file mode 100644
index 000000000..c21d695e6
--- /dev/null
+++ b/tools/decide/decide-score.cpp
@@ -0,0 +1,137 @@
+#include "decide-score.h"
+#include "ggml.h"
+
+#include <algorithm>
+#include <cmath>
+#include <limits>
+
+namespace decide {
+
+// log_softmax over x, -inf inputs stay -inf and are skipped in the normalising sum.
+// If every input is -inf, every output is -inf.
+static std::vector<double> log_softmax(const std::vector<float> & x) {
+    double max = -std::numeric_limits<double>::infinity();
+    for (float v : x) {
+        if (!std::isinf(v) && v > max) {
+            max = v;
+        }
+    }
+    std::vector<double> lsm(x.size());
+    if (std::isinf(max)) {
+        // all inputs -inf
+        for (double & v : lsm) {
+            v = -std::numeric_limits<double>::infinity();
+        }
+        return lsm;
+    }
+    double sum = 0.0;
+    for (float v : x) {
+        if (!std::isinf(v)) {
+            sum += std::exp((double) v - max);
+        }
+    }
+    double log_z = max + std::log(sum);
+    for (size_t i = 0; i < x.size(); ++i) {
+        lsm[i] = std::isinf(x[i]) ? -std::numeric_limits<double>::infinity() : (double) x[i] - log_z;
+    }
+    return lsm;
+}
+
+field_answer score_field(const field & f, const field_trie & t, const std::vector<node_scores> & scores) {
+    std::vector<double> logp(f.options.size(), 0.0);
+
+    for (const node_scores & s : scores) {
+        auto lsm = log_softmax(s.child_logits);
+        const trie_node & node = t.nodes[s.node];
+        for (size_t k = 0; k < node.children.size(); ++k) {
+            const trie_node & child = t.nodes[node.children[k]];
+            for (int opt : child.options_through) {
+                logp[opt] += lsm[k];
+            }
+        }
+    }
+
+    std::vector<float> logp_f(logp.begin(), logp.end());
+    auto lsm = log_softmax(logp_f);
+
+    bool all_inf = true;
+    for (double v : lsm) {
+        if (!std::isinf(v)) {
+            all_inf = false;
+            break;
+        }
+    }
+    if (all_inf) {
+        throw error("engine", 500, "field '" + f.name + "': all options scored -inf");
+    }
+
+    field_answer a;
+    a.probs.resize(f.options.size());
+    for (size_t i = 0; i < a.probs.size(); ++i) {
+        a.probs[i] = std::isinf(lsm[i]) ? 0.0 : std::exp(lsm[i]);
+    }
+
+#ifndef NDEBUG
+    {
+        double sum = 0.0;
+        for (double p : a.probs) {
+            sum += p;
+        }
+        GGML_ASSERT(std::fabs(sum - 1.0) < 1e-4);
+    }
+#endif
+
+    a.argmax = 0;
+    for (size_t i = 1; i < a.probs.size(); ++i) {
+        if (a.probs[i] > a.probs[a.argmax]) {
+            a.argmax = (int) i;
+        }
+    }
+
+    a.expected = 0.0;
+    if (f.type == field_type::SCORE) {
+        for (size_t i = 0; i < a.probs.size(); ++i) {
+            a.expected += (double) i * a.probs[i];
+        }
+    }
+
+    return a;
+}
+
+common_json answer_json(const field & f, const field_answer & a) {
+    double confidence = a.probs[a.argmax];
+
+    if (f.type == field_type::CHOICE) {
+        common_json probs = common_json::object();
+        for (size_t i = 0; i < f.options.size(); ++i) {
+            probs[f.options[i].key] = a.probs[i];
+        }
+        common_json j = common_json::object();
+        j["value"]         = f.options[a.argmax].key;
+        j["probabilities"] = probs;
+        j["confidence"]    = confidence;
+        return j;
+    }
+
+    if (f.type == field_type::SCORE) {
+        common_json probs = common_json::array();
+        for (double p : a.probs) {
+            probs.push_back(p);
+        }
+        common_json j = common_json::object();
+        j["value"]         = a.argmax;
+        j["expected"]      = a.expected;
+        j["probabilities"] = probs;
+        j["confidence"]    = confidence;
+        return j;
+    }
+
+    // BOOL: options[0] = "true", options[1] = "false"
+    common_json j = common_json::object();
+    j["value"]      = a.probs[0] >= 0.5;
+    j["p_true"]     = a.probs[0];
+    j["confidence"] = std::max(a.probs[0], a.probs[1]);
+    return j;
+}
+
+} // namespace decide
diff --git a/tools/decide/decide-score.h b/tools/decide/decide-score.h
new file mode 100644
index 000000000..93d140c11
--- /dev/null
+++ b/tools/decide/decide-score.h
@@ -0,0 +1,38 @@
+#pragma once
+#include "decide-schema.h"
+#include "llama.h"
+#include <vector>
+
+namespace decide {
+
+// One trie node. nodes[0] is the root (= end of the stem). A node with >= 2 children is a branch node.
+struct trie_node {
+    llama_token      tok      = -1;   // token on the edge into this node (-1 for the root)
+    std::vector<int> children;        // node indices, in first-insertion order
+    std::vector<int> options_through; // option indices whose path passes through this node (leaf: exactly one)
+};
+
+struct field_trie {
+    std::vector<llama_token>              stem;         // tokens shared by every option (includes the stem text)
+    std::vector<std::vector<llama_token>> paths;        // per option: tokens after the stem
+    std::vector<trie_node>                nodes;
+    std::vector<int>                      branch_nodes; // node indices with >= 2 children, pre-order
+    bool                                  quote_split = false; // true when the quote-anchored fallback was used (choice fields only)
+};
+
+struct node_scores {
+    int                node;          // index into field_trie::nodes (must be a branch node)
+    std::vector<float> child_logits;  // logits of nodes[node].children[k].tok, same order as children
+};
+
+struct field_answer {
+    int                 argmax;       // option index; ties -> first
+    std::vector<double> probs;        // per option, sums to 1
+    double              expected;     // score fields: sum i * p_i; others 0
+};
+
+// Throws error{"engine", 500, ...} when every option ends with -inf.
+field_answer score_field(const field & f, const field_trie & t, const std::vector<node_scores> & scores);
+common_json  answer_json(const field & f, const field_answer & a);
+
+} // namespace decide
