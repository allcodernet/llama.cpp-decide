diff --git a/tests/test-decide-score.cpp b/tests/test-decide-score.cpp
new file mode 100644
index 000000000..4ca3a9c3e
--- /dev/null
+++ b/tests/test-decide-score.cpp
@@ -0,0 +1,97 @@
+#include "decide-score.h"
+#include <cmath>
+#include <cstdio>
+#include <limits>
+
+static int failures = 0;
+#define CHECK(cond) do { if (!(cond)) { std::fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #cond); failures++; } } while (0)
+static bool near(double a, double b, double eps = 1e-6) { return std::fabs(a - b) < eps; }
+static const float NEG_INF = -std::numeric_limits<float>::infinity();
+
+// flat trie: root -> 4 leaves, one option each
+static decide::field_trie flat4() {
+    decide::field_trie t;
+    t.nodes.resize(5);
+    t.nodes[0].tok = -1;
+    for (int i = 1; i <= 4; ++i) { t.nodes[0].children.push_back(i); t.nodes[i].tok = 100 + i; t.nodes[i].options_through = {i - 1}; t.nodes[0].options_through.push_back(i - 1); }
+    t.branch_nodes = {0};
+    t.paths = {{101}, {102}, {103}, {104}};
+    return t;
+}
+static decide::field choice4() {
+    decide::field f; f.name = "q"; f.type = decide::field_type::CHOICE;
+    for (const char * k : {"a", "b", "c", "d"}) f.options.push_back({k, "", decide::json_string(k)});
+    return f;
+}
+
+int main() {
+    // 1. flat softmax
+    {
+        auto f = choice4(); auto t = flat4();
+        auto a = decide::score_field(f, t, {{0, {1.0f, 2.0f, 3.0f, 4.0f}}});
+        double z = std::exp(1.0) + std::exp(2.0) + std::exp(3.0) + std::exp(4.0);
+        CHECK(near(a.probs[0], std::exp(1.0) / z) && near(a.probs[3], std::exp(4.0) / z));
+        CHECK(a.argmax == 3);
+        CHECK(near(a.probs[0] + a.probs[1] + a.probs[2] + a.probs[3], 1.0));
+        auto j = decide::answer_json(f, a);
+        CHECK(j.at("value").get<std::string>() == "d");
+        CHECK(near(j.at("probabilities").at("d").get<double>(), a.probs[3]));
+        CHECK(near(j.at("confidence").get<double>(), a.probs[3]));
+    }
+    // 2. tie -> first
+    {
+        auto a = decide::score_field(choice4(), flat4(), {{0, {1.0f, 1.0f, 0.0f, 0.0f}}});
+        CHECK(a.argmax == 0);
+    }
+    // 3. one -inf option
+    {
+        auto a = decide::score_field(choice4(), flat4(), {{0, {0.0f, NEG_INF, 0.0f, 0.0f}}});
+        CHECK(a.probs[1] == 0.0 && near(a.probs[0], 1.0 / 3));
+    }
+    // 4. all -inf -> engine error
+    {
+        bool threw = false;
+        try { decide::score_field(choice4(), flat4(), {{0, {NEG_INF, NEG_INF, NEG_INF, NEG_INF}}}); }
+        catch (const decide::error & e) { threw = (e.code == "engine" && e.http == 500); }
+        CHECK(threw);
+    }
+    // 5. two-level trie: root -> A(opts 0,1), B(opt 2); A -> leaf0, leaf1
+    {
+        decide::field f; f.name = "q"; f.type = decide::field_type::CHOICE;
+        for (const char * k : {"aa", "ab", "b"}) f.options.push_back({k, "", decide::json_string(k)});
+        decide::field_trie t; t.nodes.resize(5);
+        t.nodes[0].children = {1, 2}; t.nodes[0].options_through = {0, 1, 2};
+        t.nodes[1].tok = 10; t.nodes[1].children = {3, 4}; t.nodes[1].options_through = {0, 1};
+        t.nodes[2].tok = 11; t.nodes[2].options_through = {2};
+        t.nodes[3].tok = 20; t.nodes[3].options_through = {0};
+        t.nodes[4].tok = 21; t.nodes[4].options_through = {1};
+        t.branch_nodes = {0, 1};
+        // P(A)=0.5, P(B)=0.5 ; P(aa|A)=0.8, P(ab|A)=0.2
+        const float la = std::log(0.8f), lb = std::log(0.2f);
+        auto a = decide::score_field(f, t, {{0, {0.0f, 0.0f}}, {1, {la, lb}}});
+        CHECK(near(a.probs[0], 0.4, 1e-5) && near(a.probs[1], 0.1, 1e-5) && near(a.probs[2], 0.5, 1e-5));
+    }
+    // 6. score field: expected value and json
+    {
+        decide::field f; f.name = "u"; f.type = decide::field_type::SCORE;
+        for (int i = 0; i < 4; ++i) f.options.push_back({std::to_string(i), "L", std::to_string(i)});
+        auto a = decide::score_field(f, flat4(), {{0, {0.0f, 0.0f, std::log(2.0f), 0.0f}}});   // probs .2 .2 .4 .2
+        CHECK(near(a.expected, 0.2 * 1 + 0.4 * 2 + 0.2 * 3, 1e-5) && a.argmax == 2);
+        auto j = decide::answer_json(f, a);
+        CHECK(j.at("value").get<int>() == 2 && j.at("probabilities").is_array() && near(j.at("expected").get<double>(), a.expected, 1e-5));
+    }
+    // 7. bool json
+    {
+        decide::field f; f.name = "b"; f.type = decide::field_type::BOOL;
+        f.options = {{"true", "", "true"}, {"false", "", "false"}};
+        decide::field_trie t; t.nodes.resize(3); t.nodes[0].children = {1, 2}; t.nodes[0].options_through = {0, 1};
+        t.nodes[1].tok = 5; t.nodes[1].options_through = {0}; t.nodes[2].tok = 6; t.nodes[2].options_through = {1};
+        t.branch_nodes = {0}; t.paths = {{5}, {6}};
+        auto a = decide::score_field(f, t, {{0, {std::log(0.3f), std::log(0.7f)}}});
+        auto j = decide::answer_json(f, a);
+        CHECK(j.at("value").get<bool>() == false && near(j.at("p_true").get<double>(), 0.3, 1e-5) && near(j.at("confidence").get<double>(), 0.7, 1e-5));
+    }
+    if (failures) { std::fprintf(stderr, "%d failure(s)\n", failures); return 1; }
+    std::printf("test-decide-score: OK\n");
+    return 0;
+}
