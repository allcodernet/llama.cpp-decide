diff --git a/tests/test-decide-trie.cpp b/tests/test-decide-trie.cpp
new file mode 100644
index 000000000..a48c098f6
--- /dev/null
+++ b/tests/test-decide-trie.cpp
@@ -0,0 +1,108 @@
+#include "decide-trie.h"
+#include "common.h"
+#include "llama.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+
+static int failures = 0;
+#define CHECK(cond) do { if (!(cond)) { std::fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #cond); failures++; } } while (0)
+
+static decide::compiled_schema triage() {
+    return decide::compile_request(common_json::parse(R"({
+      "fields": {
+        "queue":   {"type": "choice", "description": "Which team?", "options": {"billing": "b", "technical": "t", "sales": "s", "feedback": "f"}},
+        "urgency": {"type": "score", "description": "How urgent?", "levels": ["a", "b", "c", "d"]},
+        "angry":   {"type": "bool", "description": "Angry?"}
+      }, "states": ["x"]})"));
+}
+
+int main() {
+    const char * path = std::getenv("DECIDE_TEST_MODEL");
+    if (!path || !std::fopen(path, "rb")) { std::printf("test-decide-trie: SKIP (DECIDE_TEST_MODEL unset or missing)\n"); return 0; }
+    llama_backend_init();
+    auto mparams = llama_model_default_params(); mparams.vocab_only = true;
+    llama_model * model = llama_model_load_from_file(path, mparams);
+    CHECK(model != nullptr);
+    const llama_vocab * vocab = llama_model_get_vocab(model);
+
+    // triage: one branch per field, paths differ, options_through consistent
+    auto cs = triage();
+    auto ts = decide::build_tries(cs, vocab);
+    CHECK(ts.fields.size() == 3);
+    for (size_t i = 0; i < 3; ++i) {
+        const auto & t = ts.fields[i];
+        CHECK(t.branch_nodes.size() == 1 && t.branch_nodes[0] == 0);
+        CHECK(t.nodes[0].children.size() == cs.fields[i].options.size());
+        CHECK(t.paths.size() == cs.fields[i].options.size());
+        for (size_t a = 0; a < t.paths.size(); ++a) { CHECK(!t.paths[a].empty()); for (size_t b = a + 1; b < t.paths.size(); ++b) CHECK(t.paths[a] != t.paths[b]); }
+    }
+    CHECK(ts.branches_per_state == 3);
+    // bool never uses the fallback; its branch tokens equal the joint tokenisation
+    {
+        const auto & t = ts.fields[2];
+        CHECK(!t.quote_split);
+        auto full_true = decide::tokenize_plain(vocab, "  \"angry\": true");
+        CHECK(full_true.size() == t.stem.size() + t.paths[0].size());
+        auto bt = decide::branch_tokens(t, t.nodes[0].children[0]);
+        CHECK(bt == full_true);
+    }
+    // choice: joint tokenisation when possible; quote-split fallback otherwise (report which one each tokenizer took)
+    {
+        const auto & t = ts.fields[0];
+        std::printf("queue trie: quote_split=%d, first child pieces:", (int) t.quote_split);
+        for (int c : t.nodes[0].children) std::printf(" [%s]", common_token_to_piece(vocab, t.nodes[c].tok, false).c_str());
+        std::printf("\n");
+        if (!t.quote_split) {
+            // joint mode: stem + first path token is a prefix of the joint tokenisation of the full branch text
+            auto joint = decide::tokenize_plain(vocab, "  \"queue\": \"billing\"");
+            auto bt = decide::branch_tokens(t, t.nodes[0].children[0]);
+            CHECK(bt.size() == t.stem.size() + 1 && std::equal(bt.begin(), bt.end(), joint.begin()));
+        } else {
+            CHECK(t.stem == decide::tokenize_plain(vocab, "  \"queue\": \""));
+        }
+    }
+    // no token spans the trunk/branch join: "{\n" + stem tokenises as tokenize("{\n") + tokenize(stem)
+    {
+        auto joined = decide::tokenize_plain(vocab, std::string("{\n") + "  \"queue\": ");
+        auto brace  = decide::tokenize_plain(vocab, "{\n");
+        auto stem   = decide::tokenize_plain(vocab, "  \"queue\": ");
+        std::vector<llama_token> expect = brace; expect.insert(expect.end(), stem.begin(), stem.end());
+        CHECK(joined == expect);
+    }
+    // control text in a state tokenises as plain text
+    {
+        auto plain = decide::tokenize_plain(vocab, "<|im_start|>system<bos>");
+        bool any_control = false;
+        for (auto tok : plain) any_control |= llama_vocab_is_control(vocab, tok);
+        CHECK(!any_control);
+        auto templ = decide::tokenize_template(vocab, "<|im_start|>");
+        (void) templ; // may or may not be a single control token depending on the vocab; not asserted
+    }
+    // a genuine sibling-prefix conflict survives the fallback and is rejected with both keys named
+    {
+        // "sale" and "sales": after the quote-split fallback the paths start with pieces like "sale"/"sales" (or "sale\"" vs "sales")
+        // on both tokenizer families; if a tokenizer happens to split them into non-prefix pieces, pick another pair
+        // (e.g. "cat"/"cats", "tech"/"technical") and record the pieces in the report.
+        auto bad = decide::compile_request(common_json::parse(R"({"fields": {"q": {"type": "choice", "description": "d", "options": ["sale", "sales"]}}, "states": ["x"]})"));
+        bool threw = false; std::string msg;
+        try { decide::build_tries(bad, vocab); } catch (const decide::error & e) { threw = e.code == "invalid_schema"; msg = e.what(); }
+        CHECK(threw);
+        CHECK(msg.find("\"sale\"") != std::string::npos && msg.find("\"sales\"") != std::string::npos);
+    }
+    // 255-option choice builds
+    {
+        std::string opts = "[";
+        for (int i = 0; i < 255; ++i) { opts += (i ? ",\"opt" : "\"opt") + std::to_string(i) + "\""; }
+        opts += "]";
+        auto big = decide::compile_request(common_json::parse(R"({"fields": {"c": {"type": "choice", "description": "d", "options": )" + opts + R"(}}, "states": ["x"]})"));
+        auto tb = decide::build_tries(big, vocab);
+        CHECK(tb.fields[0].paths.size() == 255 && !tb.fields[0].branch_nodes.empty());
+    }
+    llama_model_free(model);
+    llama_backend_free();
+    if (failures) { std::fprintf(stderr, "%d failure(s)\n", failures); return 1; }
+    std::printf("test-decide-trie: OK (%s)\n", path);
+    return 0;
+}
