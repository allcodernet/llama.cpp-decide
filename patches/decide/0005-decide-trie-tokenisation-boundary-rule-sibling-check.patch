diff --git a/tools/decide/decide-trie.cpp b/tools/decide/decide-trie.cpp
new file mode 100644
index 000000000..cb4f033f6
--- /dev/null
+++ b/tools/decide/decide-trie.cpp
@@ -0,0 +1,191 @@
+#include "decide-trie.h"
+#include "common.h"
+
+#include <algorithm>
+
+namespace decide {
+
+std::vector<llama_token> tokenize_plain(const llama_vocab * vocab, const std::string & text) {
+    return common_tokenize(vocab, text, false, false);
+}
+
+std::vector<llama_token> tokenize_template(const llama_vocab * vocab, const std::string & text) {
+    return common_tokenize(vocab, text, false, true);
+}
+
+// Inserts `path` into the trie (nodes[0] is the root), recording `opt` in options_through
+// along the way. Reuses an existing child edge with the same token when present, so that
+// paths sharing a prefix share nodes (first-insertion order is preserved in `children`).
+static void insert_path(std::vector<trie_node> & nodes, const std::vector<llama_token> & path, int opt) {
+    int cur = 0;
+    nodes[cur].options_through.push_back(opt);
+    for (llama_token tok : path) {
+        int next = -1;
+        for (int c : nodes[cur].children) {
+            if (nodes[c].tok == tok) { next = c; break; }
+        }
+        if (next == -1) {
+            trie_node n;
+            n.tok = tok;
+            nodes.push_back(n);
+            next = (int) nodes.size() - 1;
+            nodes[cur].children.push_back(next);
+        }
+        nodes[next].options_through.push_back(opt);
+        cur = next;
+    }
+}
+
+static void collect_branch_nodes_preorder(const std::vector<trie_node> & nodes, int node, std::vector<int> & out) {
+    if (nodes[node].children.size() >= 2) out.push_back(node);
+    for (int c : nodes[node].children) collect_branch_nodes_preorder(nodes, c, out);
+}
+
+// Rule 2's empty/prefix-path check, shared between the joint path and the quote-split fallback.
+// An empty path is trivially a prefix of every other path, so a single pairwise scan over
+// (i, j) with i != j catches both cases (paths.size() >= 2 always: choice needs >= 2 options,
+// score needs >= 2 levels, bool has exactly 2).
+static void check_paths_nonempty_distinct(const field & f, const std::vector<std::vector<llama_token>> & paths) {
+    for (size_t i = 0; i < paths.size(); ++i) {
+        for (size_t j = 0; j < paths.size(); ++j) {
+            if (i == j) continue;
+            const auto & pi = paths[i];
+            const auto & pj = paths[j];
+            if (pi.size() <= pj.size() && std::equal(pi.begin(), pi.end(), pj.begin())) {
+                throw error("invalid_schema", 400, "field \"" + f.name + "\": option \"" + f.options[i].key +
+                                                        "\" tokenises as a prefix of option \"" + f.options[j].key + "\"");
+            }
+        }
+    }
+}
+
+// Builds nodes/branch_nodes for the given per-option token paths (stem already stripped).
+static void build_from_paths(field_trie & t, const std::vector<std::vector<llama_token>> & paths) {
+    t.paths = paths;
+    t.nodes.clear();
+    t.nodes.emplace_back(); // root
+    t.nodes[0].tok = -1;
+    for (size_t i = 0; i < paths.size(); ++i) {
+        insert_path(t.nodes, paths[i], (int) i);
+    }
+    t.branch_nodes.clear();
+    collect_branch_nodes_preorder(t.nodes, 0, t.branch_nodes);
+}
+
+// Rule 5: sibling-prefix check at every branch node. Returns the message for the first
+// conflicting pair found, or an empty string when there is none.
+static std::string sibling_conflict(const field & f, const field_trie & t, const llama_vocab * vocab) {
+    for (int bn : t.branch_nodes) {
+        const auto & children = t.nodes[bn].children;
+        std::vector<std::string> pieces(children.size());
+        for (size_t k = 0; k < children.size(); ++k) {
+            pieces[k] = common_token_to_piece(vocab, t.nodes[children[k]].tok, false);
+        }
+        for (size_t k = 0; k < pieces.size(); ++k) {
+            for (size_t l = k + 1; l < pieces.size(); ++l) {
+                const std::string & pk = pieces[k];
+                const std::string & pl = pieces[l];
+                bool prefix = (pk.size() <= pl.size() && pl.compare(0, pk.size(), pk) == 0) ||
+                              (pl.size() <= pk.size() && pk.compare(0, pl.size(), pl) == 0);
+                if (prefix) {
+                    int opt_k = t.nodes[children[k]].options_through.front();
+                    int opt_l = t.nodes[children[l]].options_through.front();
+                    return "field \"" + f.name + "\": options \"" + f.options[opt_k].key + "\" and \"" +
+                           f.options[opt_l].key + "\" share a token prefix (\"" + pk + "\" vs \"" + pl +
+                           "\"); rename one of them";
+                }
+            }
+        }
+    }
+    return "";
+}
+
+field_trie build_trie(const field & f, const llama_vocab * vocab) {
+    // Rule 1: tokenise stem_text(f) + option.encoded for every option.
+    std::vector<std::vector<llama_token>> toks(f.options.size());
+    for (size_t i = 0; i < f.options.size(); ++i) {
+        toks[i] = tokenize_plain(vocab, stem_text(f) + f.options[i].encoded);
+    }
+
+    // Rule 2: stem = longest common token prefix of all toks[i].
+    size_t common = toks[0].size();
+    for (size_t i = 1; i < toks.size(); ++i) {
+        size_t lim = std::min(common, toks[i].size());
+        size_t k = 0;
+        while (k < lim && toks[0][k] == toks[i][k]) ++k;
+        common = k;
+    }
+
+    field_trie t;
+    t.stem.assign(toks[0].begin(), toks[0].begin() + common);
+    std::vector<std::vector<llama_token>> paths(toks.size());
+    for (size_t i = 0; i < toks.size(); ++i) {
+        paths[i].assign(toks[i].begin() + common, toks[i].end());
+    }
+    check_paths_nonempty_distinct(f, paths);
+
+    // Rules 3-4: build the trie, enumerate branch nodes (pre-order).
+    build_from_paths(t, paths);
+
+    // Rule 5: sibling-prefix check at every branch node.
+    std::string conflict_msg = sibling_conflict(f, t, vocab);
+    if (conflict_msg.empty()) {
+        return t;
+    }
+
+    // Rule 6: quote-anchored fallback, choice fields only.
+    if (f.type != field_type::CHOICE) {
+        throw error("invalid_schema", 400, conflict_msg);
+    }
+
+    field_trie qt;
+    qt.stem = tokenize_plain(vocab, stem_text(f) + "\"");
+    std::vector<std::vector<llama_token>> qpaths(f.options.size());
+    for (size_t i = 0; i < f.options.size(); ++i) {
+        qpaths[i] = tokenize_plain(vocab, f.options[i].key + "\"");
+    }
+    check_paths_nonempty_distinct(f, qpaths);
+    build_from_paths(qt, qpaths);
+    qt.quote_split = true;
+
+    std::string qconflict_msg = sibling_conflict(f, qt, vocab);
+    if (!qconflict_msg.empty()) {
+        throw error("invalid_schema", 400, qconflict_msg);
+    }
+
+    return qt;
+}
+
+trie_set build_tries(const compiled_schema & cs, const llama_vocab * vocab) {
+    trie_set ts;
+    ts.fields.reserve(cs.fields.size());
+    for (const auto & f : cs.fields) {
+        field_trie t = build_trie(f, vocab);
+        ts.branches_per_state += (int) t.branch_nodes.size();
+        ts.fields.push_back(std::move(t));
+    }
+    return ts;
+}
+
+std::vector<llama_token> branch_tokens(const field_trie & t, int node) {
+    std::vector<llama_token> out = t.stem;
+    // Walk from `node` to the root via a simple search (nodes[].children only stores
+    // forward edges), collecting edge tokens, then reverse.
+    std::vector<llama_token> rev;
+    int cur = node;
+    while (cur != 0) {
+        int parent = -1;
+        for (size_t i = 0; i < t.nodes.size(); ++i) {
+            for (int c : t.nodes[i].children) {
+                if (c == cur) { parent = (int) i; break; }
+            }
+            if (parent != -1) break;
+        }
+        rev.push_back(t.nodes[cur].tok);
+        cur = parent;
+    }
+    out.insert(out.end(), rev.rbegin(), rev.rend());
+    return out;
+}
+
+} // namespace decide
diff --git a/tools/decide/decide-trie.h b/tools/decide/decide-trie.h
new file mode 100644
index 000000000..d1d37519d
--- /dev/null
+++ b/tools/decide/decide-trie.h
@@ -0,0 +1,27 @@
+#pragma once
+#include "decide-schema.h"
+#include "decide-score.h"
+#include "llama.h"
+#include <vector>
+
+namespace decide {
+
+struct trie_set {
+    std::vector<field_trie> fields;            // same order as compiled_schema::fields
+    int                     branches_per_state = 0;   // sum over fields of branch_nodes.size()
+};
+
+// Tokenises stem_text(f) + o.encoded per option (add_special=false, parse_special=false),
+// takes the longest common token prefix as the stem, builds the trie, enumerates branch nodes,
+// and applies the sibling-prefix check. Throws error{"invalid_schema", 400, ...}.
+field_trie build_trie(const field & f, const llama_vocab * vocab);
+trie_set   build_tries(const compiled_schema & cs, const llama_vocab * vocab);
+
+// stem + path to `node` (edge tokens from the root), used to fill a branch sequence.
+std::vector<llama_token> branch_tokens(const field_trie & t, int node);
+
+// Plain-text tokenisation helpers shared with the engine.
+std::vector<llama_token> tokenize_plain(const llama_vocab * vocab, const std::string & text);   // add_special=false, parse_special=false
+std::vector<llama_token> tokenize_template(const llama_vocab * vocab, const std::string & text); // add_special=false, parse_special=true
+
+} // namespace decide
