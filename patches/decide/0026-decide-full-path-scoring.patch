--- /dev/null
+++ b/tests/test-decide-fullpath.cpp
@@ -0,0 +1,233 @@
+// spec 4.3-4.5 full-path engine helpers without a model: decode chunks (n_batch and the row cap), the row -> node mapping of
+// full-path branch sequences across a chunk split, the values of one row, and the branch token / row counts of the budget
+#include "decide-engine.h"
+
+#include <cmath>
+#include <cstdio>
+#include <limits>
+#include <string>
+#include <utility>
+#include <vector>
+
+static int failures = 0;
+#define CHECK(cond) do { if (!(cond)) { std::fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #cond); failures++; } } while (0)
+
+using chunks = std::vector<std::pair<size_t, size_t>>;
+static const float NEG_INF = -std::numeric_limits<float>::infinity();
+
+static bool near(double a, double b, double eps = 1e-5) { return std::fabs(a - b) < eps; }
+
+// stem {100, 101}; paths: option 0 {10, 20}, option 1 {10, 21}, option 2 {11} (insertion order of build_from_paths)
+// nodes: 0 root -> 1 (10) -> 2 (20, leaf of 0) and 3 (21, leaf of 1); root -> 4 (11, leaf of 2)
+static decide::field_trie region() {
+    decide::field_trie t;
+    t.stem = {100, 101};
+    t.paths = {{10, 20}, {10, 21}, {11}};
+    t.nodes.resize(5);
+    t.nodes[0].children = {1, 4}; t.nodes[0].options_through = {0, 1, 2};
+    t.nodes[1].tok = 10; t.nodes[1].children = {2, 3}; t.nodes[1].options_through = {0, 1};
+    t.nodes[2].tok = 20; t.nodes[2].options_through = {0};
+    t.nodes[3].tok = 21; t.nodes[3].options_through = {1};
+    t.nodes[4].tok = 11; t.nodes[4].options_through = {2};
+    t.branch_nodes = {0, 1};
+    t.option_nodes = {{0, 1, 2}, {0, 1, 3}, {0, 4}};
+    return t;
+}
+
+// stem {200}; paths {7}, {8}: a bool-like field
+static decide::field_trie two_leaves() {
+    decide::field_trie t;
+    t.stem = {200};
+    t.paths = {{7}, {8}};
+    t.nodes.resize(3);
+    t.nodes[0].children = {1, 2}; t.nodes[0].options_through = {0, 1};
+    t.nodes[1].tok = 7; t.nodes[1].options_through = {0};
+    t.nodes[2].tok = 8; t.nodes[2].options_through = {1};
+    t.branch_nodes = {0};
+    t.option_nodes = {{0, 1}, {0, 2}};
+    return t;
+}
+
+static std::vector<decide::decode_entry> plain(size_t n, int row_every = 0) {
+    std::vector<decide::decode_entry> e;
+    for (size_t i = 0; i < n; ++i) {
+        e.push_back({(llama_token) i, (llama_pos) i, 1, row_every > 0 && i % row_every == 0 ? (int) i : -1});
+    }
+    return e;
+}
+
+int main() {
+    using decide::decode_chunks;
+
+    // 1. chunks: n_batch alone (no rows), the row cap alone, both; no empty chunk at the end
+    {
+        CHECK(decode_chunks({}, 4, 3).empty());
+        CHECK(decode_chunks(plain(5), 2, 3) == (chunks{{0, 2}, {2, 4}, {4, 5}}));
+        CHECK(decode_chunks(plain(5), 8, 3) == (chunks{{0, 5}}));
+        // rows on every token: the cap (3) ends chunks before n_batch (8) does
+        CHECK(decode_chunks(plain(7, 1), 8, 3) == (chunks{{0, 3}, {3, 6}, {6, 7}}));
+        // exactly the cap at the last entry: one chunk
+        CHECK(decode_chunks(plain(3, 1), 8, 3) == (chunks{{0, 3}}));
+        // n_batch (2) before the cap (5)
+        CHECK(decode_chunks(plain(6, 1), 2, 5) == (chunks{{0, 2}, {2, 4}, {4, 6}}));
+        // rows on every third token (0, 3, 6, 9): cap 2 -> the chunk ends at the token holding the 2nd row
+        CHECK(decode_chunks(plain(11, 3), 100, 2) == (chunks{{0, 4}, {4, 10}, {10, 11}}));
+        // tree mode: fewer rows than the cap -> the n_batch chunks of today
+        CHECK(decode_chunks(plain(9, 4), 4, 65) == (chunks{{0, 4}, {4, 8}, {8, 9}}));
+    }
+
+    // 2. full-path branch sequences: every node read once, the row after token x belongs to the node whose edge token is x
+    //    (the root's row after the last stem token); a row-cap chunk boundary splits option 0's sequence
+    {
+        const decide::field_trie t    = region();
+        const auto               plan = decide::full_path_plan(t);
+        CHECK(plan.size() == 3);
+        std::vector<decide::decode_entry> entries;
+        std::vector<decide::row_ref>      refs;
+        const llama_pos pos0 = 30;
+        for (size_t o = 0; o < plan.size(); ++o) {
+            decide::add_full_path_seq(plan[o], 50 + (llama_seq_id) o, pos0, 2, 1, entries, refs);
+        }
+        // option 0: 4 tokens, option 1: 4, option 2: 3
+        CHECK(entries.size() == 11 && refs.size() == t.nodes.size());
+        // every entry: its sequence, positions from pos0, the plan's tokens
+        const std::vector<size_t> starts = {0, 4, 8};
+        for (size_t o = 0; o < plan.size(); ++o) {
+            for (size_t i = 0; i < plan[o].tokens.size(); ++i) {
+                const decide::decode_entry & e = entries[starts[o] + i];
+                CHECK(e.seq == 50 + (llama_seq_id) o && e.pos == pos0 + (llama_pos) i && e.tok == plan[o].tokens[i]);
+            }
+        }
+        // tagged entries: option 0 reads root (index 1), node 1 (2), node 2 (3); option 1 node 3 (index 3); option 2 node 4 (index 2)
+        std::vector<int> tagged;
+        for (size_t j = 0; j < entries.size(); ++j) {
+            if (entries[j].tag >= 0) {
+                tagged.push_back((int) j);
+            }
+        }
+        CHECK(tagged == (std::vector<int>{1, 2, 3, 7, 10}));
+        std::vector<int> reads(t.nodes.size(), 0);
+        for (int j : tagged) {
+            const decide::row_ref & r = refs[entries[j].tag];
+            CHECK(r.state == 2 && r.field == 1 && r.node >= 0 && r.node < (int) t.nodes.size());
+            if (r.node < 0 || r.node >= (int) t.nodes.size()) {
+                continue;
+            }
+            reads[r.node]++;
+            CHECK(r.node == 0 ? entries[j].tok == t.stem.back() : entries[j].tok == t.nodes[r.node].tok);
+        }
+        CHECK(reads == (std::vector<int>{1, 1, 1, 1, 1}));
+
+        // row cap 2: chunk [0, 3) holds option 0's first three tokens (rows: root, node 1); its last token (node 2's row) opens
+        // chunk [3, 8) with option 1 (node 3's row); option 2 is chunk [8, 11)
+        const chunks ch = decode_chunks(entries, 512, 2);
+        CHECK(ch == (chunks{{0, 3}, {3, 8}, {8, 11}}));
+        // the llama_get_logits_ith argument is the index inside the chunk's batch, not the index into the phase
+        CHECK(decide::chunk_rows(entries, 0, 3) == (std::vector<std::pair<int32_t, int>>{{1, entries[1].tag}, {2, entries[2].tag}}));
+        CHECK(decide::chunk_rows(entries, 3, 8) == (std::vector<std::pair<int32_t, int>>{{0, entries[3].tag}, {4, entries[7].tag}}));
+        CHECK(decide::chunk_rows(entries, 8, 11) == (std::vector<std::pair<int32_t, int>>{{2, entries[10].tag}}));
+        // the split sequence continues at the next position in the next chunk
+        CHECK(entries[3].seq == 50 && entries[3].pos == entries[2].pos + 1 && refs[entries[3].tag].node == 2);
+        // every row once over all chunks, each at its node
+        std::vector<int> seen(t.nodes.size(), 0);
+        for (const auto & c : ch) {
+            for (const auto & [i, tag] : decide::chunk_rows(entries, c.first, c.second)) {
+                const decide::decode_entry & e = entries[c.first + (size_t) i];
+                CHECK(e.tag == tag);
+                seen[refs[tag].node]++;
+            }
+        }
+        CHECK(seen == (std::vector<int>{1, 1, 1, 1, 1}));
+    }
+
+    // 3. one row's values: full-vocabulary softmax, children, END on a leaf, MERGED per leaf child
+    {
+        // trie: root -> 1 (tok 1) -> 3 (tok 3, leaf); root -> 2 (tok 2, leaf)
+        decide::field_trie t;
+        t.stem = {9};
+        t.paths = {{1, 3}, {2}};
+        t.nodes.resize(4);
+        t.nodes[0].children = {1, 2};
+        t.nodes[1].tok = 1; t.nodes[1].children = {3};
+        t.nodes[2].tok = 2;
+        t.nodes[3].tok = 3;
+        t.option_nodes = {{0, 1, 3}, {0, 2}};
+        // probabilities over a vocabulary of 8, logits shifted by 7 (the softmax removes the shift)
+        const std::vector<double> p = {0.05, 0.30, 0.20, 0.10, 0.15, 0.10, 0.05, 0.05};
+        std::vector<float>        logits;
+        for (double x : p) {
+            logits.push_back((float) (std::log(x) + 7.0));
+        }
+        const std::vector<llama_token> end_tokens = {4, 5};           // END mass 0.25
+        const std::vector<llama_token> merged_2   = {6};              // MERGED of leaf 2's piece: 0.05
+        const std::vector<llama_token> merged_3   = {6, 7};           // MERGED of leaf 3's piece: 0.10
+        const std::vector<const std::vector<llama_token> *> merged = {nullptr, nullptr, &merged_2, &merged_3};
+
+        const decide::node_logp root = decide::full_path_row(logits.data(), 8, t, 0, end_tokens, merged);
+        CHECK(root.node == 0 && root.child_logp.size() == 2 && root.merged_logp.size() == 2);
+        CHECK(near(root.child_logp[0], std::log(0.30)) && near(root.child_logp[1], std::log(0.20)));
+        CHECK(root.merged_logp[0] == NEG_INF);                       // child 1 is not a leaf
+        CHECK(near(root.merged_logp[1], std::log(0.05)));            // child 2 is a leaf
+        CHECK(root.end_logp == NEG_INF);
+
+        const decide::node_logp inner = decide::full_path_row(logits.data(), 8, t, 1, end_tokens, merged);
+        CHECK(inner.child_logp.size() == 1 && near(inner.child_logp[0], std::log(0.10)));
+        CHECK(inner.merged_logp.size() == 1 && near(inner.merged_logp[0], std::log(0.10)));
+        CHECK(inner.end_logp == NEG_INF);
+
+        const decide::node_logp leaf = decide::full_path_row(logits.data(), 8, t, 3, end_tokens, merged);
+        CHECK(leaf.node == 3 && leaf.child_logp.empty() && leaf.merged_logp.empty() && near(leaf.end_logp, std::log(0.25)));
+
+        // a leaf child without MERGED tokens: -inf
+        const decide::node_logp none = decide::full_path_row(logits.data(), 8, t, 0, end_tokens, {nullptr, nullptr, nullptr, &merged_3});
+        CHECK(none.merged_logp[1] == NEG_INF && near(none.child_logp[1], std::log(0.20)));
+
+        // large logits (shift 1000) stay finite: the maximum is subtracted before exp
+        std::vector<float> big;
+        for (double x : p) {
+            big.push_back((float) (std::log(x) + 1000.0));
+        }
+        const decide::node_logp b = decide::full_path_row(big.data(), 8, t, 0, end_tokens, merged);
+        CHECK(near(b.child_logp[0], std::log(0.30), 1e-3) && near(b.merged_logp[1], std::log(0.05), 1e-3));
+
+        // decide::score_field_full accepts the rows: P(0) = 0.3 * 0.1 * 0.25 + 0.3 * 0.10, P(1) = 0.2 * 0.25 + 0.05
+        std::vector<decide::node_logp> rows;
+        for (int n = 0; n < 4; ++n) {
+            rows.push_back(decide::full_path_row(logits.data(), 8, t, n, end_tokens, merged));
+        }
+        decide::field f;
+        f.name    = "f";
+        f.type    = decide::field_type::CHOICE;
+        f.options = {{"a", "", "\"a\""}, {"b", "", "\"b\""}};
+        const decide::field_answer a  = decide::score_field_full(f, t, rows);
+        const double               p0 = 0.3 * 0.1 * 0.25 + 0.3 * 0.10;
+        const double               p1 = 0.2 * 0.25 + 0.05;
+        CHECK(near(a.coverage, p0 + p1) && near(a.probs[0], p0 / (p0 + p1)) && near(a.probs[1], p1 / (p0 + p1)));
+
+        // NaN in the row: every value derived from the normaliser is NaN (score_field_full turns it into a 500)
+        std::vector<float> broken = logits;
+        broken[5] = std::numeric_limits<float>::quiet_NaN();
+        const decide::node_logp nan_row = decide::full_path_row(broken.data(), 8, t, 0, end_tokens, merged);
+        CHECK(std::isnan(nan_row.child_logp[0]));
+    }
+
+    // 4. budget counts per state: tree = branch tokens of the branch nodes and one row per branch node;
+    //    full-path = stem + path tokens per option and one row per trie node
+    {
+        decide::trie_set ts;
+        ts.fields = {region(), two_leaves()};
+        ts.mode   = decide::scoring_mode::TREE;
+        // tree: region branch nodes 0 (stem, 2 tokens) and 1 (stem + 10, 3 tokens); two_leaves branch node 0 (1 token)
+        const decide::branch_counts tree = decide::count_branches(ts);
+        CHECK(tree.tokens == 2 + 3 + 1 && tree.rows == 2 + 1);
+        ts.mode = decide::scoring_mode::FULL_PATH;
+        // full-path: region 4 + 4 + 3 tokens, 5 nodes; two_leaves 2 + 2 tokens, 3 nodes
+        const decide::branch_counts full = decide::count_branches(ts);
+        CHECK(full.tokens == 11 + 4 && full.rows == 5 + 3);
+    }
+
+    if (failures == 0) {
+        std::printf("test-decide-fullpath: OK\n");
+    }
+    return failures == 0 ? 0 : 1;
+}
