+#include <limits>
 #include <utility>
 
 namespace decide {
@@ -19,9 +21,59 @@ static common_json token_array(const std::vector<llama_token> & toks) {
     return a;
 }
 
+static const char * mode_name(scoring_mode m) {
+    return m == scoring_mode::FULL_PATH ? "full_path" : "tree";
+}
+
+// spec 10: the dump entry of one full-path branch sequence; logp per row: the node, the children's log-probs keyed by token id,
+// "end" on a leaf row, "merged" (keyed by the leaf child's token id) on a row with leaf children; -inf is written as null
+static common_json full_path_dump(const std::string & name, const field_trie & t, const full_path_seq & s, const std::vector<node_logp> & rows) {
+    common_json logp = common_json::array();
+    for (int node : s.row_node) {
+        const auto it = std::find_if(rows.begin(), rows.end(), [&](const node_logp & r) { return r.node == node; });
+        if (it == rows.end()) {
+            throw error("engine", 500, "field \"" + name + "\": missing full-path row for node " + std::to_string(node));
+        }
+        const std::vector<int> & children = t.nodes[node].children;
+        common_json row = common_json::object();
+        row["node"] = node;
+        if (children.empty()) {
+            row["end"] = it->end_logp;
+        } else {
+            common_json child  = common_json::object();
+            common_json merged = common_json::object();
+            for (size_t k = 0; k < children.size(); ++k) {
+                const std::string tok = std::to_string(t.nodes[children[k]].tok);
+                child[tok] = it->child_logp[k];
+                if (t.nodes[children[k]].children.empty()) {
+                    merged[tok] = it->merged_logp[k];
+                }
+            }
+            row["children"] = child;
+            if (!merged.empty()) {
+                row["merged"] = merged;
+            }
+        }
+        logp.push_back(row);
+    }
+    common_json rows_at = common_json::array();
+    for (int i : s.row_index) {
+        rows_at.push_back(i);
+    }
+    common_json b = common_json::object();
+    b["field"]  = name;
+    b["mode"]   = "full_path";
+    b["option"] = s.option;
+    b["tokens"] = token_array(s.tokens);
+    b["rows"]   = rows_at;
+    b["logp"]   = logp;
+    return b;
