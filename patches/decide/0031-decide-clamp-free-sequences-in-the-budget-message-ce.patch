-                                           "), n_ctx - 16 is " + std::to_string(n_ctx - 16));
+        const int64_t n = (int64_t) state_tokens[i].size();
+        if (state_cells(held, prefix_total, K, n, tail, branch_total) > n_ctx - 16) {
+            throw error("budget", 400, state_cells_message(i, held, prefix_total, K, n, tail, branch_total, n_ctx - 16));
         }
