From 39f3515320ba8afb44d0cb8ba05fee2bfd374b3b Mon Sep 17 00:00:00 2001
From: allcodernet <67543055+allcodernet@users.noreply.github.com>
Date: Sat, 26 Sep 2026 01:03:26 +0200
Subject: [PATCH 31/45] decide: clamp free sequences in the budget message;
 cell message helper

The spr = 0 message names max(0, D - K_eff) sequences left after the prefix
slots (D < K_eff gave a negative count). The per-state cell check and its 400
text move to decide-debias (state_cells, state_cells_message), so the number
in the message is the one compared; K = 1 keeps its text, K > 1 names
K_eff x (state, tail, branches). Unit tests pin D = 3 with K_eff 4 and both
cell texts (the live K = 1 case and the live 0.5B K = 2 case).
---
 tests/test-decide-debias.cpp   | 24 ++++++++++++++++++++++--
 tools/decide/decide-debias.cpp | 15 ++++++++++++++-
 tools/decide/decide-debias.h   | 11 +++++++++--
 tools/decide/decide-engine.cpp | 11 +++--------
 4 files changed, 48 insertions(+), 13 deletions(-)

diff --git a/tests/test-decide-debias.cpp b/tests/test-decide-debias.cpp
index be9c7c497..4d128915b 100644
--- a/tests/test-decide-debias.cpp
+++ b/tests/test-decide-debias.cpp
@@ -1,5 +1,5 @@
-// spec 6.1, 7, 8 without a model: the sequence layout of K catalogue variants, the sequence budget and its 400 message, the request
-// temperature, and one field's answer from its variant answers (mean, order_spread, mean coverage, then temperature)
+// spec 6.1, 7, 8 without a model: the sequence layout of K catalogue variants, the sequence and cell budgets and their 400 messages,
+// the request temperature, and one field's answer from its variant answers (mean, order_spread, mean coverage, then temperature)
 #include "decide-debias.h"
 
 #include <cmath>
@@ -93,6 +93,11 @@ int main() {
         CHECK(sb(3, 4, 3) == (std::vector<int>{16, 0}));     // fewer sequences than prefix slots
         CHECK(decide::sequence_budget_message(32, 4, 10, "full_path") ==
               "schema needs 44 sequences per state (K_eff 4 \u00d7 (1 trunk + 10 branch sequences, full_path)); --decide-seqs 32 leaves 28 after 4 prefix slots");
+        // fewer sequences than prefix slots: 0 are left, not a negative count
+        CHECK(decide::sequence_budget_message(3, 4, 3, "tree") ==
+              "schema needs 16 sequences per state (K_eff 4 \u00d7 (1 trunk + 3 branch sequences, tree)); --decide-seqs 3 leaves 0 after 4 prefix slots");
+        CHECK(decide::sequence_budget_message(4, 4, 3, "tree") ==
+              "schema needs 16 sequences per state (K_eff 4 \u00d7 (1 trunk + 3 branch sequences, tree)); --decide-seqs 4 leaves 0 after 4 prefix slots");
         // K = 1: the budget texts without debiasing
         CHECK(decide::sequence_budget_message(3, 1, 3, "tree") ==
               "schema needs 4 sequences per state (K_eff 1 \u00d7 (1 trunk + 3 branch sequences, tree)); --decide-seqs 3 leaves 2 after 1 prefix slots");
@@ -100,6 +105,21 @@ int main() {
               "schema needs 11 sequences per state (K_eff 1 \u00d7 (1 trunk + 10 branch sequences, full_path)); --decide-seqs 10 leaves 9 after 1 prefix slots");
     }
 
+    // 2b. spec 7.3 cells of one state alone: held + the K prefixes + K x (state + tail + branches), and the 400 text naming them.
+    //     K = 1 is the text without debiasing (a live case); K = 2 is the live 0.5B case: 496 + 2 x (3183 + 6 + 16) = 6906
+    {
+        CHECK(decide::state_cells(0, 248, 1, 3176, 6, 16) == 3446);
+        CHECK(decide::state_cells_message(0, 0, 248, 1, 3176, 6, 16, 2032) ==
+              "state 0 needs 3446 cells (held 0, prefix 248, state 3176, tail 6, branches 16), n_ctx - 16 is 2032");
+        CHECK(decide::state_cells(0, 496, 2, 3183, 6, 16) == 6906);
+        CHECK(decide::state_cells_message(0, 0, 496, 2, 3183, 6, 16, 4080) ==
+              "state 0 needs 6906 cells (held 0, prefix 496, K_eff 2 \u00d7 (state 3183, tail 6, branches 16)), n_ctx - 16 is 4080");
+        // cells held by server slots and a later state: 100 + 900 + 4 x (50 + 6 + 40) = 1384
+        CHECK(decide::state_cells(100, 900, 4, 50, 6, 40) == 1384);
+        CHECK(decide::state_cells_message(3, 100, 900, 4, 50, 6, 40, 1000) ==
+              "state 3 needs 1384 cells (held 100, prefix 900, K_eff 4 \u00d7 (state 50, tail 6, branches 40)), n_ctx - 16 is 1000");
+    }
+
     // 3. spec 8: options.temperature when given (0 = not given), else the server default
     {
         CHECK(decide::resolve_temperature(0.0, 1.0) == 1.0);
diff --git a/tools/decide/decide-debias.cpp b/tools/decide/decide-debias.cpp
index 52d69af58..e9c7e76ea 100644
--- a/tools/decide/decide-debias.cpp
+++ b/tools/decide/decide-debias.cpp
@@ -1,5 +1,7 @@
 #include "decide-debias.h"
 
+#include <algorithm>
+
 namespace decide {
 
 llama_seq_id trunk_seq(llama_seq_id seq_base, int K, int B, size_t c, int v) {
@@ -16,7 +18,18 @@ seq_budget sequence_budget(int decide_seqs, int K, int B) {
 std::string sequence_budget_message(int decide_seqs, int K, int B, const std::string & mode) {
     return "schema needs " + std::to_string(K * (1 + B)) + " sequences per state (K_eff " + std::to_string(K) + " \u00d7 (1 trunk + " +
            std::to_string(B) + " branch sequences, " + mode + ")); --decide-seqs " + std::to_string(decide_seqs) + " leaves " +
-           std::to_string(decide_seqs - K) + " after " + std::to_string(K) + " prefix slots";
+           std::to_string(std::max(0, decide_seqs - K)) + " after " + std::to_string(K) + " prefix slots";
+}
+
+int64_t state_cells(int64_t held, int64_t prefix, int K, int64_t state, int64_t tail, int64_t branches) {
+    return held + prefix + K * (state + tail + branches);
+}
+
+std::string state_cells_message(size_t i, int64_t held, int64_t prefix, int K, int64_t state, int64_t tail, int64_t branches, int64_t limit) {
+    const std::string per_variant = "state " + std::to_string(state) + ", tail " + std::to_string(tail) + ", branches " + std::to_string(branches);
+    return "state " + std::to_string(i) + " needs " + std::to_string(state_cells(held, prefix, K, state, tail, branches)) + " cells (held " +
+           std::to_string(held) + ", prefix " + std::to_string(prefix) + ", " +
+           (K == 1 ? per_variant : "K_eff " + std::to_string(K) + " \u00d7 (" + per_variant + ")") + "), n_ctx - 16 is " + std::to_string(limit);
 }
 
 double resolve_temperature(double requested, double server_default) {
diff --git a/tools/decide/decide-debias.h b/tools/decide/decide-debias.h
index 78e1d2b8c..fba4816ba 100644
--- a/tools/decide/decide-debias.h
+++ b/tools/decide/decide-debias.h
@@ -2,11 +2,13 @@
 #include "decide-score.h"
 #include "llama.h"
 
+#include <cstddef>
+#include <cstdint>
 #include <string>
 #include <vector>
 
 // Option-order debiasing (spec 6.1, 7) and temperature (spec 8) without a model: the sequence layout of K catalogue variants,
-// the sequence budget, the request temperature and one field's answer from its variant answers.
+// the sequence and cell budgets, the request temperature and one field's answer from its variant answers.
 namespace decide {
 
 // spec 6.1: slot v (prefix of variant v) is seq_base + v; state c of a round owns the K * (1 + B) ids from seq_base + K + c * K * (1 + B);
@@ -19,9 +21,14 @@ struct seq_budget {
     int states_per_round = 0;
 };
 seq_budget  sequence_budget(int decide_seqs, int K, int B);
-// spec 7.3: the 400 budget message when no state fits; mode "tree" or "full_path"
+// spec 7.3: the 400 budget message when no state fits (the sequences left after the K prefix slots: at least 0); mode "tree" or "full_path"
 std::string sequence_budget_message(int decide_seqs, int K, int B, const std::string & mode);
 
+// spec 7.3: the cells one state needs alone: held + the K prefixes + K x (state + tail + branch tokens)
+int64_t     state_cells(int64_t held, int64_t prefix, int K, int64_t state, int64_t tail, int64_t branches);
+// spec 7.3: the 400 budget message when state i needs more than `limit` (n_ctx - 16) cells; K = 1 is the text without debiasing
+std::string state_cells_message(size_t i, int64_t held, int64_t prefix, int K, int64_t state, int64_t tail, int64_t branches, int64_t limit);
+
 // spec 8: options.temperature when given (> 0; 0 = not given), else the server default
 double resolve_temperature(double requested, double server_default);
 
