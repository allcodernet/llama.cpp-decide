     const int64_t held  = held_cells();
     for (size_t i = 0; i < states.size(); ++i) {
-        const int64_t need = held + prefix_total + K * ((int64_t) state_tokens[i].size() + tail + branch_total);
-        if (need > n_ctx - 16) {
