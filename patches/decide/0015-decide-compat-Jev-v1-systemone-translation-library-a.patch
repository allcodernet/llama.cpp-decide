+#pragma once
+// Jev System One (POST /v1/systemone) <-> /v1/decide translation. Pure functions, no model.
+#include "decide-schema.h"
+#include "json.h"          // common_json
+
+#include <string>
+#include <vector>
+
+namespace decide {
+
+// one FastAPI-style validation entry; loc is built from JSON keys, never from messages
+// (array indices appear as decimal strings)
+struct compat_error {
+    std::vector<std::string> loc;
+    std::string              msg;
+    std::string              type;
+};
+
+// Jev request -> /v1/decide body. Throws compat_error for the first shape problem found.
+common_json systemone_to_decide(const common_json & body);
+// /v1/decide 200 body -> Jev response; questions and model come from the Jev request.
+common_json decide_to_systemone(const common_json & decide_response, const common_json & questions, const std::string & model);
+// clip((n*peak - 1)/(n - 1), 0, 1); n < 2 -> 1.0
+double      jev_confidence(const std::vector<double> & probs);
+// {"detail": [{"loc", "msg", "type"}, ...]}
+common_json validation_body(const std::vector<compat_error> & errs);
+// loc = ["body","questions",e.field], or ["body"] when e.field is empty; type = e.code
+compat_error from_decide_error(const error & e);
+// post-task /v1/decide error body -> {"detail": [...]} for status 400 (invalid_schema, budget);
+// any other status returns the body unchanged. The HTTP status itself is the caller's choice
+// (spec 3.2: invalid_schema -> 422, budget -> 400).
+common_json map_decide_error_body(int status, const common_json & decide_error_body);
+
+} // namespace decide
