new file mode 100644
index 000000000..82ca22c33
--- /dev/null
+++ b/tests/test-decide-compat.cpp
@@ -0,0 +1,270 @@
+#include "decide-compat.h"
+#include "decide-schema.h"
+#include "json.h"
+
+#include <cmath>
+#include <cstdio>
+#include <string>
+#include <vector>
+
+static int failures = 0;
+#define CHECK(cond) do { if (!(cond)) { std::fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #cond); failures++; } } while (0)
+
+// compares the dumps, so key order counts
+static void check_json(const common_json & got, const std::string & want_text, int line) {
+    const std::string got_s  = got.dump();
+    const std::string want_s = common_json::parse(want_text).dump();
+    if (got_s != want_s) {
+        std::fprintf(stderr, "FAIL line %d: json mismatch\n---got---\n%s\n---want---\n%s\n", line, got_s.c_str(), want_s.c_str());
+        failures++;
+    }
+}
+#define CHECK_JSON(got, want) check_json((got), (want), __LINE__)
+
+static void expect_compat_error(const std::string & body, const std::vector<std::string> & loc, int line) {
+    try {
+        (void) decide::systemone_to_decide(common_json::parse(body));
+    } catch (const decide::compat_error & e) {
+        if (e.loc != loc) {
+            std::string got;
+            for (const auto & s : e.loc) got += "[" + s + "]";
+            std::fprintf(stderr, "FAIL line %d: wrong loc %s (msg %s)\n", line, got.c_str(), e.msg.c_str());
+            failures++;
+        }
+        if (e.msg.empty() || e.type.empty()) {
+            std::fprintf(stderr, "FAIL line %d: empty msg or type\n", line);
+            failures++;
+        }
+        return;
+    }
+    std::fprintf(stderr, "FAIL line %d: no compat_error for %s\n", line, body.c_str());
+    failures++;
+}
+#define EXPECT_LOC(body, ...) expect_compat_error((body), std::vector<std::string>{__VA_ARGS__}, __LINE__)
+
+static bool near(double a, double b) { return std::fabs(a - b) < 1e-9; }
+
+int main() {
+    // 1. docs example: noul with both criteria halves
+    {
+        auto out = decide::systemone_to_decide(common_json::parse(R"({
+            "state": "Help! My payouts have been failing for 3 days.",
+            "model": "jev-latest",
+            "questions": {"is_urgent": {"type": "noul", "instructions": "Does this convey urgency?",
+                                        "criteria": {"true": "Explicitly time-sensitive", "false": "No urgency expressed"}}}
+        })"));
+        CHECK_JSON(out, R"J({
+            "model": "jev-latest",
+            "instructions": "Answer each question about the state.",
+            "fields": {"is_urgent": {"type": "bool",
+                "description": "Does this convey urgency? (true: Explicitly time-sensitive; false: No urgency expressed)"}},
+            "states": ["Help! My payouts have been failing for 3 days."]
+        })J");
+        // the translated body compiles
+        auto cs = decide::compile_request(out);
+        CHECK(cs.fields.size() == 1 && cs.fields[0].type == decide::field_type::BOOL);
+    }
+
+    // 2. choice with a null description, then a score with three levels; field order kept
+    {
+        auto out = decide::systemone_to_decide(common_json::parse(R"({
+            "state": "My password reset email never arrives.", "model": "m",
+            "questions": {
+                "department":  {"type": "choice", "instructions": "Which team?",
+                                "criteria": {"billing": "Payments and refunds", "technical": "Bugs", "sales": null}},
+                "frustration": {"type": "score", "instructions": "How frustrated?",
+                                "criteria": ["Calm", "Annoyed", "Furious"]}
+            }
+        })"));
+        CHECK_JSON(out.at("fields"), R"({
+            "department":  {"type": "choice", "description": "Which team?",
+                            "options": {"billing": "Payments and refunds", "technical": "Bugs", "sales": ""}},
+            "frustration": {"type": "score", "description": "How frustrated?", "levels": ["Calm", "Annoyed", "Furious"]}
+        })");
+        auto cs = decide::compile_request(out);
+        CHECK(cs.fields.size() == 2 && cs.fields[0].name == "department" && cs.fields[1].name == "frustration");
+    }
+
+    // 3. absent instructions (and null) -> per-type defaults
+    {
+        auto out = decide::systemone_to_decide(common_json::parse(R"({
+            "state": "s", "model": "m",
+            "questions": {
+                "n": {"type": "noul"},
+                "c": {"type": "choice", "criteria": {"a": "x", "b": "y"}},
+                "s": {"type": "score", "instructions": null, "criteria": ["lo", "hi"]}
+            }
+        })"));
+        CHECK(out.at("fields").at("n").at("description").get<std::string>() == "Answer yes or no.");
+        CHECK(out.at("fields").at("c").at("description").get<std::string>() == "Choose the option that applies.");
+        CHECK(out.at("fields").at("s").at("description").get<std::string>() == "Rate on the given scale.");
+    }
+
+    // 4. object state, object instructions, object choice value, empty score entry
+    {
+        const auto body = common_json::parse(R"({
+            "state": {"ticket": "hi", "tags": [1, 2]}, "model": "m",
+            "questions": {
+                "c": {"type": "choice", "instructions": {"question": "Pick", "data": {"k": "v"}},
+                      "criteria": {"a": {"rubric": "first", "n": 1}, "b": ["x", "y"]}},
+                "s": {"type": "score", "criteria": ["low", "", "high"]}
+            }
+        })");
+        auto out = decide::systemone_to_decide(body);
+        CHECK(out.at("states").at(0).get<std::string>() == body.at("state").dump(2));
+        CHECK(out.at("states").at(0).get<std::string>().find('\n') != std::string::npos);
+        const auto & c = out.at("fields").at("c");
+        CHECK(c.at("description").get<std::string>() == body.at("questions").at("c").at("instructions").dump(2));
+        CHECK(c.at("options").at("a").get<std::string>() == R"({"rubric":"first","n":1})");
+        CHECK(c.at("options").at("b").get<std::string>() == R"(["x","y"])");
+        CHECK_JSON(out.at("fields").at("s").at("levels"), R"(["low", "level 1", "high"])");
+    }
+
+    // 5. noul halves: only false; true null -> no suffix
+    {
+        auto out = decide::systemone_to_decide(common_json::parse(R"({
+            "state": "s", "model": "m",
+            "questions": {
+                "f":  {"type": "noul", "instructions": "Q?", "criteria": {"false": "No"}},
+                "t0": {"type": "noul", "instructions": "Q?", "criteria": {"true": null}},
+                "o":  {"type": "noul", "instructions": "Q?", "criteria": {"true": {"a": 1}}}
+            }
+        })"));
+        CHECK(out.at("fields").at("f").at("description").get<std::string>() == "Q? (false: No)");
+        CHECK(out.at("fields").at("t0").at("description").get<std::string>() == "Q?");
+        CHECK(out.at("fields").at("o").at("description").get<std::string>() == R"J(Q? (true: {"a":1}))J");
+    }
+
+    // 6. shape errors (422) with exact loc
+    EXPECT_LOC(R"({"state": "s", "questions": {"q": {"type": "noul"}}})", "body", "model");
+    EXPECT_LOC(R"({"state": "s", "model": 3, "questions": {"q": {"type": "noul"}}})", "body", "model");
+    EXPECT_LOC(R"({"model": "m", "questions": {"q": {"type": "noul"}}})", "body", "state");
+    EXPECT_LOC(R"({"model": "m", "state": 5, "questions": {"q": {"type": "noul"}}})", "body", "state");
+    EXPECT_LOC(R"({"model": "m", "state": "s", "questions": {}})", "body", "questions");
+    EXPECT_LOC(R"({"model": "m", "state": "s"})", "body", "questions");
+    EXPECT_LOC(R"({"model": "m", "state": "s", "questions": {"q": {"type": "maybe"}}})", "body", "questions", "q", "type");
+    EXPECT_LOC(R"({"model": "m", "state": "s", "questions": {"q": {"instructions": "x"}}})", "body", "questions", "q", "type");
+    EXPECT_LOC(R"({"model": "m", "state": "s", "questions": {"q": {"type": "choice", "criteria": ["a", "b"]}}})", "body", "questions", "q", "criteria");
+    EXPECT_LOC(R"({"model": "m", "state": "s", "questions": {"q": {"type": "choice"}}})", "body", "questions", "q", "criteria");
+    EXPECT_LOC(R"({"model": "m", "state": "s", "questions": {"q": {"type": "choice", "criteria": {"a": 5, "b": "x"}}}})", "body", "questions", "q", "criteria", "a");
+    EXPECT_LOC(R"({"model": "m", "state": "s", "questions": {"q": "noul"}})", "body", "questions", "q");
+    EXPECT_LOC(R"({"model": "m", "state": "s", "questions": {"q": {"type": "noul", "instructions": 7}}})", "body", "questions", "q", "instructions");
+    EXPECT_LOC(R"({"model": "m", "state": "s", "questions": {"q": {"type": "score", "criteria": {"a": "x"}}}})", "body", "questions", "q", "criteria");
+    EXPECT_LOC(R"({"model": "m", "state": "s", "questions": {"q": {"type": "score", "criteria": ["a", true]}}})", "body", "questions", "q", "criteria", "1");
+    EXPECT_LOC(R"({"model": "m", "state": "s", "questions": {"q": {"type": "noul", "criteria": "yes"}}})", "body", "questions", "q", "criteria");
+    EXPECT_LOC(R"({"model": "m", "state": "s", "questions": {"q": {"type": "noul", "criteria": {"true": 1}}}})", "body", "questions", "q", "criteria", "true");
+    // a question id with a quote and unicode reaches loc unchanged
+    EXPECT_LOC(R"({"model": "m", "state": "s", "questions": {"a\"bé": {"type": 1}}})", "body", "questions", "a\"b\xc3\xa9", "type");
+
+    // 7. decide response -> Jev response
+    {
+        const auto questions = common_json::parse(R"({
+            "department":  {"type": "choice", "criteria": {"billing": "b", "technical": "t", "sales": null}},
+            "frustration": {"type": "score", "criteria": ["Calm", {"level": "Annoyed", "hint": "some"}, "Furious"]},
+            "is_urgent":   {"type": "noul"}
+        })");
+        const auto resp = common_json::parse(R"({
+            "results": [{"answers": {
+                "department":  {"value": "billing", "probabilities": {"billing": 0.88, "technical": 0.12, "sales": 0.0}, "confidence": 0.88},
+                "frustration": {"value": 1, "expected": 1.05, "probabilities": [0.0, 0.95, 0.05], "confidence": 0.95},
+                "is_urgent":   {"value": true, "p_true": 0.95, "confidence": 0.95}
+            }}],
+            "usage": {"prompt_tokens": 50, "cached_tokens": 268, "state_tokens": 12, "scored_tokens": 7}
+        })");
+        auto out = decide::decide_to_systemone(resp, questions, "qwen3.5-9b");
+        const auto & d = out.at("answers").at("department");
+        CHECK(near(d.at("confidence").get<double>(), 0.82));
+        common_json expect = common_json::parse(R"({
+            "model": "qwen3.5-9b",
+            "answers": {
+                "department": {"type": "choice", "choice": "billing",
+                               "probabilities": {"billing": 0.88, "technical": 0.12, "sales": 0.0}, "confidence": 0.0},
+                "frustration": {"type": "score", "score": 1.05,
+                                "legend": {"0": "Calm", "1": {"level": "Annoyed", "hint": "some"}, "2": "Furious"},
+                                "probabilities": {"0": 0.0, "1": 0.95, "2": 0.05}, "confidence": 0.0},
+                "is_urgent": {"type": "noul", "noul": 0.95}
+            },
+            "usage": {"input_tokens": 318, "output_tokens": 0}
+        })");
+        // confidence is a computed double, so compare it separately and splice it in
+        const double fc = out.at("answers").at("frustration").at("confidence").get<double>();
+        CHECK(near(fc, (3 * 0.95 - 1) / 2));
+        expect["answers"]["department"]["confidence"]  = d.at("confidence").get<double>();
+        expect["answers"]["frustration"]["confidence"] = fc;
+        CHECK_JSON(out, expect.dump());
+        CHECK(out.at("usage").at("input_tokens").is_number_integer());
+        CHECK(out.at("usage").at("output_tokens").is_number_integer());
+        CHECK(out.at("answers").at("frustration").at("score").is_number_float());
+        CHECK(!out.at("answers").at("is_urgent").contains("confidence"));
+
+        // score equal to an integer stays a float
+        auto resp2 = resp;
+        resp2["results"][0]["answers"]["frustration"]["expected"] = 1;
+        auto out2 = decide::decide_to_systemone(resp2, questions, "m");
+        CHECK(out2.at("answers").at("frustration").at("score").is_number_float());
+    }
+
+    // 8. confidence
+    CHECK(near(decide::jev_confidence({1.0, 0.0, 0.0}), 1.0));
+    CHECK(near(decide::jev_confidence({1.0 / 3, 1.0 / 3, 1.0 / 3}), 0.0));
+    CHECK(near(decide::jev_confidence({0.5, 0.3, 0.2}), 0.25));
+    CHECK(near(decide::jev_confidence({0.9, 0.1}), 0.8));
+    CHECK(near(decide::jev_confidence({0.7}), 1.0));
+
+    // 9. from_decide_error
+    {
+        auto e1 = decide::from_decide_error(decide::error("invalid_schema", 400, "bad field", "q"));
+        CHECK((e1.loc == std::vector<std::string>{"body", "questions", "q"}));
+        CHECK(e1.type == "invalid_schema" && e1.msg == "bad field");
+        auto e2 = decide::from_decide_error(decide::error("invalid_states", 400, "bad states"));
+        CHECK((e2.loc == std::vector<std::string>{"body"}));
+        CHECK(e2.type == "invalid_states");
+    }
+
+    // compile() stamps the field name on errors that do not know it (empty description)
+    {
+        auto tr = decide::systemone_to_decide(common_json::parse(R"({
+            "model": "m", "state": "s",
+            "questions": {"ok": {"type": "noul"}, "q": {"type": "choice", "instructions": "", "criteria": {"a": "x", "b": "y"}}}
+        })"));
+        bool thrown = false;
+        try {
+            (void) decide::compile_request(tr);
+        } catch (const decide::error & e) {
+            thrown = true;
+            CHECK(e.field == "q");
+            auto ce = decide::from_decide_error(e);
+            CHECK((ce.loc == std::vector<std::string>{"body", "questions", "q"}));
+        }
+        CHECK(thrown);
+        // a one-level score passes the translator and fails in compile with the field
+        auto tr2 = decide::systemone_to_decide(common_json::parse(R"({
+            "model": "m", "state": "s", "questions": {"lvl": {"type": "score", "criteria": ["only"]}}
+        })"));
+        thrown = false;
+        try {
+            (void) decide::compile_request(tr2);
+        } catch (const decide::error & e) {
+            thrown = true;
+            CHECK(e.field == "lvl");
+        }
+        CHECK(thrown);
+    }
+
+    // 10. map_decide_error_body
+    CHECK_JSON(decide::map_decide_error_body(400, common_json::parse(R"({"error":{"code":"invalid_schema","message":"m","field":"q"}})")),
+               R"({"detail":[{"loc":["body","questions","q"],"msg":"m","type":"invalid_schema"}]})");
+    CHECK_JSON(decide::map_decide_error_body(400, common_json::parse(R"({"error":{"message":"too long","code":"budget"}})")),
+               R"({"detail":[{"loc":["body"],"msg":"too long","type":"budget"}]})");
+
+    // 11. validation_body keeps order
+    CHECK_JSON(decide::validation_body({{{"body", "model"}, "first", "missing"}, {{"body", "state"}, "second", "missing"}}),
+               R"({"detail":[{"loc":["body","model"],"msg":"first","type":"missing"},{"loc":["body","state"],"msg":"second","type":"missing"}]})");
+
+    if (failures) {
+        std::fprintf(stderr, "test-decide-compat: %d failure(s)\n", failures);
+        return 1;
+    }
+    std::printf("test-decide-compat: OK\n");
+    return 0;
+}
