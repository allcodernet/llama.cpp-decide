diff --git a/tools/decide/decide-compat.cpp b/tools/decide/decide-compat.cpp
new file mode 100644
index 000000000..e648ac01d
--- /dev/null
+++ b/tools/decide/decide-compat.cpp
@@ -0,0 +1,243 @@
+#include "decide-compat.h"
+
+#include <algorithm>
+#include <cstdint>
+
+namespace decide {
+
+using loc_t = std::vector<std::string>;
+
+static loc_t loc_of(loc_t base, const std::string & key) {
+    base.push_back(key);
+    return base;
+}
+
+[[noreturn]] static void fail(const loc_t & loc, const std::string & msg, const std::string & type) {
+    throw compat_error{loc, msg, type};
+}
+
+// X = string | object | array
+static bool is_x(const common_json & j) {
+    return j.is_string() || j.is_object() || j.is_array();
+}
+
+// spec 3.1 text(): string as is, object/array pretty JSON (indent 2), null ""
+static std::string text(const common_json & j) {
+    if (j.is_string()) return j.get<std::string>();
+    if (j.is_null())   return "";
+    return j.dump(2);
+}
+
+// spec 3.1 short(): string as is, object/array compact JSON, null ""
+static std::string short_text(const common_json & j) {
+    if (j.is_string()) return j.get<std::string>();
+    if (j.is_null())   return "";
+    return j.dump();
+}
+
+static const char * default_description(const std::string & type) {
+    if (type == "noul")   return "Answer yes or no.";
+    if (type == "choice") return "Choose the option that applies.";
+    return "Rate on the given scale.";
+}
+
+static common_json translate_question(const std::string & id, const common_json & q) {
+    const loc_t base = {"body", "questions", id};
+    if (!q.is_object()) fail(base, "Input should be a valid dictionary", "dict_type");
+
+    if (!q.contains("type")) fail(loc_of(base, "type"), "Field required", "missing");
+    const auto & tj = q.at("type");
+    const std::string type = tj.is_string() ? tj.get<std::string>() : "";
+    if (type != "noul" && type != "choice" && type != "score")
+        fail(loc_of(base, "type"), "Input should be 'noul', 'choice' or 'score'", "literal_error");
+
+    std::string d = default_description(type);
+    if (q.contains("instructions")) {
+        const auto & ij = q.at("instructions");
+        if (!ij.is_null()) {
+            if (!is_x(ij)) fail(loc_of(base, "instructions"), "Input should be a string, an object or an array", "invalid_type");
+            d = text(ij);
+        }
+    }
+
+    const loc_t cloc = loc_of(base, "criteria");
+    common_json f = common_json::object();
+    if (type == "noul") {
+        std::string suffix;
+        if (q.contains("criteria") && !q.at("criteria").is_null()) {
+            const auto & cj = q.at("criteria");
+            if (!cj.is_object()) fail(cloc, "Input should be a valid dictionary", "dict_type");
+            std::vector<std::string> parts;
+            for (const char * half : {"true", "false"}) {
+                if (!cj.contains(half)) continue;
+                const auto & hj = cj.at(half);
+                if (!hj.is_null() && !is_x(hj)) fail(loc_of(cloc, half), "Input should be a string, an object, an array or null", "invalid_type");
+                const std::string s = short_text(hj);
+                if (!s.empty()) parts.push_back(std::string(half) + ": " + s);
+            }
+            if (!parts.empty()) {
+                suffix = " (" + parts[0];
+                for (size_t i = 1; i < parts.size(); ++i) suffix += "; " + parts[i];
+                suffix += ")";
+            }
+        }
+        f["type"]        = "bool";
+        f["description"] = d + suffix;
+    } else if (type == "choice") {
+        if (!q.contains("criteria")) fail(cloc, "Field required", "missing");
+        const auto & cj = q.at("criteria");
+        if (!cj.is_object()) fail(cloc, "Input should be a valid dictionary", "dict_type");
+        common_json options = common_json::object();
+        for (const auto & [key, val] : cj.items()) {
+            if (!val.is_null() && !is_x(val)) fail(loc_of(cloc, key), "Input should be a string, an object, an array or null", "invalid_type");
+            options[key] = short_text(val);
+        }
+        f["type"]        = "choice";
+        f["description"] = d;
+        f["options"]     = options;
+    } else {
+        if (!q.contains("criteria")) fail(cloc, "Field required", "missing");
+        const auto & cj = q.at("criteria");
+        if (!cj.is_array()) fail(cloc, "Input should be a valid list", "list_type");
+        common_json levels = common_json::array();
+        for (size_t i = 0; i < cj.size(); ++i) {
+            const auto & ej = cj.at(i);
+            if (!is_x(ej)) fail(loc_of(cloc, std::to_string(i)), "Input should be a string, an object or an array", "invalid_type");
+            std::string s = short_text(ej);
+            if (s.empty()) s = "level " + std::to_string(i);
+            levels.push_back(s);
+        }
+        f["type"]        = "score";
+        f["description"] = d;
+        f["levels"]      = levels;
+    }
+    return f;
+}
+
+common_json systemone_to_decide(const common_json & body) {
+    if (!body.is_object()) fail({"body"}, "Input should be a valid dictionary", "dict_type");
+
+    if (!body.contains("model")) fail({"body", "model"}, "Field required", "missing");
+    if (!body.at("model").is_string()) fail({"body", "model"}, "Input should be a valid string", "string_type");
+
+    if (!body.contains("state")) fail({"body", "state"}, "Field required", "missing");
+    if (!is_x(body.at("state"))) fail({"body", "state"}, "Input should be a string, an object or an array", "invalid_type");
+
+    if (!body.contains("questions")) fail({"body", "questions"}, "Field required", "missing");
+    const auto & qs = body.at("questions");
+    if (!qs.is_object()) fail({"body", "questions"}, "Input should be a valid dictionary", "dict_type");
+    if (qs.empty()) fail({"body", "questions"}, "questions must have at least 1 entry", "too_short");
+
+    common_json fields = common_json::object();
+    for (const auto & [id, q] : qs.items()) {
+        fields[id] = translate_question(id, q);
+    }
+
+    common_json out = common_json::object();
+    out["model"]        = body.at("model");
+    out["instructions"] = "Answer each question about the state.";
+    out["fields"]       = fields;
+    common_json states  = common_json::array();
+    states.push_back(text(body.at("state")));
+    out["states"]       = states;
+    return out;
+}
+
+double jev_confidence(const std::vector<double> & probs) {
+    const size_t n = probs.size();
+    if (n < 2) return 1.0;
+    const double peak = *std::max_element(probs.begin(), probs.end());
+    const double c = ((double) n * peak - 1.0) / ((double) n - 1.0);
+    return std::min(1.0, std::max(0.0, c));
+}
+
+common_json decide_to_systemone(const common_json & decide_response, const common_json & questions, const std::string & model) {
+    const auto & answers = decide_response.at("results").at(0).at("answers");
+    common_json out_answers = common_json::object();
+    for (const auto & [id, q] : questions.items()) {
+        const std::string type = q.at("type").get<std::string>();
+        const auto & a = answers.at(id);
+        common_json j = common_json::object();
+        j["type"] = type;
+        if (type == "noul") {
+            j["noul"] = a.at("p_true").get<double>();
+        } else if (type == "choice") {
+            common_json probs = common_json::object();
+            std::vector<double> ps;
+            for (const auto & [key, p] : a.at("probabilities").items()) {
+                const double v = p.get<double>();
+                probs[key] = v;
+                ps.push_back(v);
+            }
+            j["choice"]        = a.at("value");
+            j["probabilities"] = probs;
+            j["confidence"]    = jev_confidence(ps);
+        } else {
+            const auto & criteria = q.at("criteria");
+            const auto & pl = a.at("probabilities");
+            common_json legend = common_json::object();
+            common_json probs  = common_json::object();
+            std::vector<double> ps;
+            for (size_t i = 0; i < pl.size(); ++i) {
+                const std::string k = std::to_string(i);
+                legend[k] = criteria.at(i);
+                const double v = pl.at(i).get<double>();
+                probs[k] = v;
+                ps.push_back(v);
+            }
+            j["score"]         = a.at("expected").get<double>();
+            j["legend"]        = legend;
+            j["probabilities"] = probs;
+            j["confidence"]    = jev_confidence(ps);
+        }
+        out_answers[id] = j;
+    }
+
+    const auto & u = decide_response.at("usage");
+    common_json usage = common_json::object();
+    usage["input_tokens"]  = u.at("prompt_tokens").get<int64_t>() + u.at("cached_tokens").get<int64_t>();
+    usage["output_tokens"] = (int64_t) 0;
+
+    common_json out = common_json::object();
+    out["model"]   = model;
+    out["answers"] = out_answers;
+    out["usage"]   = usage;
+    return out;
+}
+
+common_json validation_body(const std::vector<compat_error> & errs) {
+    common_json detail = common_json::array();
+    for (const auto & e : errs) {
+        common_json loc = common_json::array();
+        for (const auto & s : e.loc) loc.push_back(s);
+        common_json d = common_json::object();
+        d["loc"]  = loc;
+        d["msg"]  = e.msg;
+        d["type"] = e.type;
+        detail.push_back(d);
+    }
+    common_json out = common_json::object();
+    out["detail"] = detail;
+    return out;
+}
+
+compat_error from_decide_error(const error & e) {
+    compat_error ce;
+    ce.loc = e.field.empty() ? loc_t{"body"} : loc_t{"body", "questions", e.field};
+    ce.msg  = e.what();
+    ce.type = e.code;
+    return ce;
+}
+
+common_json map_decide_error_body(int status, const common_json & decide_error_body) {
+    if (status != 400 || !decide_error_body.is_object() || !decide_error_body.contains("error")) return decide_error_body;
+    const auto & ej = decide_error_body.at("error");
+    const std::string field = ej.value("field", std::string());
+    compat_error ce;
+    ce.loc  = field.empty() ? loc_t{"body"} : loc_t{"body", "questions", field};
+    ce.msg  = ej.value("message", std::string());
+    ce.type = ej.value("code", std::string());
+    return validation_body({ce});
+}
+
+} // namespace decide
