From e90de8c3514fb661240ec0317f6ba46bbfef7b42 Mon Sep 17 00:00:00 2001
From: allcodernet <67543055+allcodernet@users.noreply.github.com>
Date: Fri, 25 Sep 2026 15:54:25 +0200
Subject: [PATCH 12/45] common: reject --decide-seqs above the sequence limit

n_parallel + decide_seqs above llama_max_parallel_sequences() failed
later at context creation with a generic error. Check it after parsing,
so the order of -np and --decide-seqs does not matter.
---
 common/arg.cpp | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/common/arg.cpp b/common/arg.cpp
index f88198219..39de43bfd 100644
--- a/common/arg.cpp
+++ b/common/arg.cpp
@@ -889,6 +889,14 @@ static bool common_params_parse_ex(int argc, char ** argv, common_params_context
         params.mmproj_use_gpu = params.mmproj_device != nullptr;
     }
 
+    // n_parallel -1 (auto) is resolved later by the server; count it as one slot here
+    const int n_decide_total = std::max(1, params.n_parallel) + params.decide_seqs;
+    if (params.decide_seqs > 0 && n_decide_total > (int) llama_max_parallel_sequences()) {
+        throw std::invalid_argument(string_format(
+            "error: --decide-seqs %d plus %d slot sequence(s) needs %d sequences, the maximum is %zu\n",
+            params.decide_seqs, std::max(1, params.n_parallel), n_decide_total, llama_max_parallel_sequences()));
+    }
+
     if (params.prompt_cache_all && (params.interactive || params.interactive_first)) {
         throw std::invalid_argument("error: --prompt-cache-all not supported in interactive mode yet\n");
     }
