+static decide::field score4() {
+    decide::field f; f.name = "u"; f.type = decide::field_type::SCORE;
+    for (int i = 0; i < 4; ++i) f.options.push_back({std::to_string(i), "L", std::to_string(i)});
+    return f;
+}
+static decide::field bool2() {
+    decide::field f; f.name = "b"; f.type = decide::field_type::BOOL;
+    f.options = {{"true", "", "true"}, {"false", "", "false"}};
+    return f;
+}
+static decide::field choice2(const char * a, const char * b) {
+    decide::field f; f.name = "c"; f.type = decide::field_type::CHOICE;
+    for (const char * k : {a, b}) f.options.push_back({k, "", decide::json_string(k)});
+    return f;
+}
+// root -> 1 (tok 10) -> 3 (tok 20): option 0, two tokens; root -> 2 (tok 11): option 1, one token
+static decide::field_trie two_one() {
+    decide::field_trie t; t.nodes.resize(4);
+    t.nodes[0].children = {1, 2}; t.nodes[0].options_through = {0, 1};
+    t.nodes[1].tok = 10; t.nodes[1].children = {3}; t.nodes[1].options_through = {0};
+    t.nodes[2].tok = 11; t.nodes[2].options_through = {1};
+    t.nodes[3].tok = 20; t.nodes[3].options_through = {0};
+    t.branch_nodes = {0};
+    t.paths = {{10, 20}, {11}};
+    return t;
+}
+// full-path rows for two_one(), not in node order; the log-probs are exact in float
+static std::vector<decide::node_logp> two_one_rows(float merged_a, float merged_b) {
+    std::vector<decide::node_logp> rows(4);
+    rows[0].node = 3; rows[0].end_logp = -0.125f;
+    rows[1].node = 0; rows[1].child_logp = {-0.5f, -1.5f}; rows[1].merged_logp = {NEG_INF, merged_b};
+    rows[2].node = 2; rows[2].end_logp = -0.0625f;
+    rows[3].node = 1; rows[3].child_logp = {-0.25f}; rows[3].merged_logp = {merged_a};
+    return rows;
+}
+template <typename F>
+static bool engine_500(F fn, const char * text) {
+    try { fn(); }
+    catch (const decide::error & e) { return e.code == "engine" && e.http == 500 && std::string(e.what()).find(text) != std::string::npos; }
+    return false;
+}
 
