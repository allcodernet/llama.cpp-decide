-common_json answer_json(const field & f, const field_answer & a) {
+field_answer score_field_full(const field & f, const field_trie & t, const std::vector<node_logp> & rows) {
+    const std::string who = "field \"" + f.name + "\": ";
+    const float       inf = std::numeric_limits<float>::infinity();
+    std::vector<const node_logp *> row_of(t.nodes.size(), nullptr);
+    for (const node_logp & r : rows) {
+        const std::string at = "node " + std::to_string(r.node);
+        if (r.node < 0 || r.node >= (int) t.nodes.size()) {
+            throw error("engine", 500, who + "inconsistent full-path rows (" + at + " out of range)");
+        }
+        if (row_of[r.node] != nullptr) {
+            throw error("engine", 500, who + "inconsistent full-path rows (duplicate row for " + at + ")");
+        }
+        const size_t n_children = t.nodes[r.node].children.size();
+        if (r.child_logp.size() != n_children || r.merged_logp.size() != n_children) {
+            throw error("engine", 500, who + "inconsistent full-path rows (" + at + " has " + std::to_string(n_children) + " children, the row has " +
+                                            std::to_string(r.child_logp.size()) + " child and " + std::to_string(r.merged_logp.size()) + " merged values)");
+        }
+        // -inf is a masked token or an empty sum; NaN or +inf is a broken forward pass
+        bool finite = !std::isnan(r.end_logp) && r.end_logp != inf;
+        for (float v : r.child_logp) {
+            finite = finite && !std::isnan(v) && v != inf;
+        }
+        for (float v : r.merged_logp) {
+            finite = finite && !std::isnan(v) && v != inf;
+        }
+        if (!finite) {
