+
+    double log_z = -std::numeric_limits<double>::infinity();
+    for (double v : logp) {
+        log_z = log_add(log_z, v);
+    }
+    if (std::isinf(log_z)) {
+        throw error("engine", 500, who + "all options scored -inf");
+    }
+    std::vector<double> probs(logp.size());
+    for (size_t o = 0; o < logp.size(); ++o) {
+        probs[o] = std::exp(logp[o] - log_z);
+    }
+    field_answer extras;
+    extras.coverage = std::exp(log_z);
+    return rebuild_answer(f, probs, extras);
+}
+
+field_answer rebuild_answer(const field & f, const std::vector<double> & probs, const field_answer & extras) {
+    if (probs.size() != f.options.size()) {
+        throw error("engine", 500, "field \"" + f.name + "\": " + std::to_string(probs.size()) + " probabilities for " +
+                                        std::to_string(f.options.size()) + " options");
+    }
+    field_answer a;
+    a.probs  = probs;
+    a.argmax = 0;
+    for (size_t i = 1; i < probs.size(); ++i) {
+        if (probs[i] > probs[a.argmax]) {
+            a.argmax = (int) i;
+        }
+    }
+    a.expected = 0.0;
+    if (f.type == field_type::SCORE) {
+        for (size_t i = 0; i < probs.size(); ++i) {
+            a.expected += (double) i * probs[i];
+        }
+    }
+    a.coverage     = extras.coverage;
+    a.order_spread = extras.order_spread;
+    a.given        = extras.given;
+    return a;
+}
+
+std::vector<double> apply_temperature(const std::vector<double> & p, double T) {
+    if (!(T > 0)) {
+        throw error("engine", 500, "temperature must be > 0, got " + std::to_string(T));
+    }
+    if (T == 1.0) {
+        return p;
+    }
+    std::vector<double> scaled(p.size());
+    for (size_t i = 0; i < p.size(); ++i) {
+        scaled[i] = std::log(p[i]) / T;
+    }
+    const std::vector<double> lsm = log_softmax(scaled);
+    std::vector<double>       out(p.size());
+    for (size_t i = 0; i < p.size(); ++i) {
+        out[i] = std::exp(lsm[i]);
+    }
+    return out;
+}
