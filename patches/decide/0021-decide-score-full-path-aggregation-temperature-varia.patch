+    for (size_t o = 0; o < f.options.size(); ++o) {
+        if (o >= t.paths.size() || t.paths[o].empty()) {
+            throw error("engine", 500, who + "inconsistent trie (no path for option \"" + f.options[o].key + "\")");
+        }
+        const std::vector<llama_token> & path = t.paths[o];
+        int cur = 0;
+        for (size_t i = 0; i < path.size(); ++i) {
+            const node_logp &        r        = row(cur);
+            const std::vector<int> & children = t.nodes[cur].children;
+            size_t k = 0;
+            while (k < children.size() && t.nodes[children[k]].tok != path[i]) {
+                ++k;
+            }
+            if (k == children.size()) {
+                throw error("engine", 500, who + "inconsistent trie (path of option \"" + f.options[o].key + "\" leaves the trie at node " + std::to_string(cur) + ")");
+            }
+            cur = children[k];
+            if (i + 1 < path.size()) {
+                logp[o] += r.child_logp[k];
+            } else {
+                logp[o] += log_add((double) r.child_logp[k] + row(cur).end_logp, r.merged_logp[k]);
+            }
