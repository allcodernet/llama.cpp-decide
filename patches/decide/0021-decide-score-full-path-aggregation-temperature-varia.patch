+// log(exp(a) + exp(b)); -inf when both are -inf
+static double log_add(double a, double b) {
+    const double hi = std::max(a, b);
+    const double lo = std::min(a, b);
+    return std::isinf(hi) ? hi : hi + std::log1p(std::exp(lo - hi));
+}
