From d74bbe019e25a1a8ea6d63247548ab7aec75a0fe Mon Sep 17 00:00:00 2001
From: allcodernet <67543055+allcodernet@users.noreply.github.com>
Date: Fri, 25 Sep 2026 14:16:47 +0200
Subject: [PATCH 06/45] common: --decide-seqs, unified KV and output
 reservation for decision sequences

---
 common/arg.cpp         | 10 ++++++++++
 common/common.cpp      |  8 ++++++++
 common/common.h        |  1 +
 common/speculative.cpp |  1 +
 4 files changed, 20 insertions(+)

diff --git a/common/arg.cpp b/common/arg.cpp
index c4c4e143c..f88198219 100644
--- a/common/arg.cpp
+++ b/common/arg.cpp
@@ -2556,6 +2556,16 @@ common_params_context common_params_parser_init(common_params & params, llama_ex
             }
         ).set_env("LLAMA_ARG_N_PARALLEL"));
     }
+    add_opt(common_arg(
+        {"--decide-seqs"}, "N",
+        string_format("sequences reserved for the decide engine above the slots (default: %d, 0 = disabled, minimum 3)", params.decide_seqs),
+        [](common_params & params, int value) {
+            if (value < 0 || (value > 0 && value < 3)) {
+                throw std::invalid_argument("--decide-seqs needs at least 3 (prefix, trunk, one branch)");
+            }
+            params.decide_seqs = value;
+        }
+    ).set_env("LLAMA_ARG_DECIDE_SEQS").set_examples({LLAMA_EXAMPLE_SERVER, LLAMA_EXAMPLE_COMPLETION}));
     add_opt(common_arg(
         {"-ns", "--sequences"}, "N",
         string_format("number of sequences to decode (default: %d)", params.n_sequences),
diff --git a/common/common.cpp b/common/common.cpp
index d8319cd9a..9c4bb1aec 100644
--- a/common/common.cpp
+++ b/common/common.cpp
@@ -1747,6 +1747,14 @@ struct llama_context_params common_context_params_to_llama(const common_params &
     cparams.op_offload        = !params.no_op_offload;
     cparams.swa_full          = params.swa_full;
     cparams.kv_unified        = params.kv_unified;
+    if (params.decide_seqs > 0) {
+        // the decide engine copies its prefix sequence into trunk and branch sequences,
+        // which needs one shared KV buffer and one output row per sequence
+        cparams.kv_unified = true;
+        cparams.n_seq_max  = params.n_parallel + params.decide_seqs;
+        const int32_t cur = cparams.n_outputs_max == 0 ? (int32_t) cparams.n_batch : (int32_t) cparams.n_outputs_max;
+        cparams.n_outputs_max = std::max<int32_t>(cur, cparams.n_seq_max);
+    }
 
     cparams.type_k = params.cache_type_k;
     cparams.type_v = params.cache_type_v;
diff --git a/common/common.h b/common/common.h
index 63d0badd0..31a499053 100644
--- a/common/common.h
+++ b/common/common.h
@@ -453,6 +453,7 @@ struct common_params {
     int32_t n_keep                =     0; // number of tokens to keep from initial prompt
     int32_t n_chunks              =    -1; // max number of chunks to process (-1 = unlimited)
     int32_t n_parallel            =     1; // number of parallel sequences to decode
+    int32_t decide_seqs           =     0; // sequences reserved for the decide engine above the slots (0 = disabled, minimum 3)
     int32_t n_sequences           =     1; // number of sequences to decode
     int32_t n_outputs_max         =     0; // max outputs in a batch (0 = n_batch)
     int32_t n_outputs_max_per_seq =     1; // max outputs per sequence
diff --git a/common/speculative.cpp b/common/speculative.cpp
index 77dfe9535..d12fc523f 100644
--- a/common/speculative.cpp
+++ b/common/speculative.cpp
@@ -2468,6 +2468,7 @@ common_params common_base_params_to_speculative(const common_params & params) {
 
     const auto & params_spec = params.speculative.draft;
     common_params result = params;
+    result.decide_seqs = 0; // the draft context gets neither the decide sequences nor their output reservation
 
     result.embedding    = false;
     result.pooling_type = LLAMA_POOLING_TYPE_UNSPECIFIED;
-- 
2.55.0

