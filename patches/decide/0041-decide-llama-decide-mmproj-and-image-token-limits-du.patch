+common_json engine::pieces_hex(const std::vector<llama_token> & toks) const {
+    static const char digits[] = "0123456789abcdef";
+    common_json a = common_json::array();
+    for (llama_token t : toks) {
+        const std::string piece = common_token_to_piece(vocab, t, true);
+        std::string       hex;
+        for (unsigned char ch : piece) {
+            hex += digits[ch >> 4];
+            hex += digits[ch & 15];
+        }
+        a.push_back(hex);
+    }
+    return a;
+}
+
+common_json engine::parts_json(const state_input & in, const std::vector<image_input> & images) {
+    common_json parts = common_json::array();
+    for (const head_part & hp : in.head) {
+        common_json p = common_json::object();
+        if (hp.image < 0) {
+            p["type"]   = "text";
+            p["tokens"] = token_array(hp.tokens);
+            parts.push_back(p);
+            continue;
+        }
+        const image_input & im     = images[hp.image];
+        common_json         chunks = common_json::array();
+        for (size_t j = 0; j < mtmd_input_chunks_size(im.chunks.get()); ++j) {
+            const mtmd_input_chunk * ch = mtmd_input_chunks_get(im.chunks.get(), j);
+            common_json              c  = common_json::object();
+            if (mtmd_input_chunk_get_type(ch) == MTMD_INPUT_CHUNK_TYPE_TEXT) {
+                size_t              n    = 0;
+                const llama_token * toks = mtmd_input_chunk_get_tokens_text(ch, &n);
+                c["type"]   = "text";
+                c["tokens"] = token_array(std::vector<llama_token>(toks, toks + n));
+            } else {
+                c["type"]     = "image";
+                c["n_tokens"] = (int64_t) mtmd_input_chunk_get_n_tokens(ch);
+                c["n_pos"]    = (int64_t) mtmd_input_chunk_get_n_pos(ch);
+            }
+            chunks.push_back(c);
+        }
+        p["type"]     = "image";
+        p["sha256"]   = im.sha256;
+        p["n_tokens"] = im.n_tokens;
+        p["n_pos"]    = (int64_t) im.n_pos;
+        p["chunks"]   = chunks;
+        parts.push_back(p);
+    }
+    if (!in.rest.empty()) {   // the text after the last image
+        common_json p = common_json::object();
+        p["type"]   = "text";
+        p["tokens"] = token_array(in.rest);
+        parts.push_back(p);
+    }
+    return parts;
+}
