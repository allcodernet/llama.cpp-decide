diff --git a/tools/server/server-task.h b/tools/server/server-task.h
index 7ef643634..05d73a557 100644
--- a/tools/server/server-task.h
+++ b/tools/server/server-task.h
@@ -568,7 +568,7 @@ struct server_task_result_apply_lora : server_task_result {
     virtual json to_json() override;
 };
 
-// used by /v1/decide and /v1/decide/info; data is the response body, status its HTTP status
+// used by /v1/decide, /v1/decide/info and /v1/systemone; data is the response body, status its HTTP status
 struct server_task_result_decide : server_task_result {
     json data;
     int  status = 200;
diff --git a/tools/server/server.cpp b/tools/server/server.cpp
index cc6287d34..cfc27fc91 100644
--- a/tools/server/server.cpp
+++ b/tools/server/server.cpp
@@ -231,6 +231,7 @@ int llama_server(common_params & params, int argc, char ** argv) {
         routes.post_lora_adapters          = models_routes->proxy_post;
         routes.post_decide                 = models_routes->proxy_post;
         routes.get_decide_info             = models_routes->proxy_get;
