From 9bdaa893294fb2682e65fada2b22e0bc593fbaca Mon Sep 17 00:00:00 2001
From: allcodernet <67543055+allcodernet@users.noreply.github.com>
Date: Fri, 25 Sep 2026 18:42:44 +0200
Subject: [PATCH 17/45] server: POST /v1/systemone Jev-compatible route

Serve TypeSafe AI's System One request/response shape on top of the
decide task. The decide_run lambda becomes decide_task, which returns
the decide result's {status, body} (nullopt after handling a closed
connection or a generic task error itself); /v1/decide and
/v1/decide/info write that pair straight into the response as before.

post_systemone: 404 disabled before parsing; invalid JSON, translator
shape errors and compile_request/states_of errors on the translated
body become 422 FastAPI {"detail": [...]} bodies in the HTTP thread;
post-task 400s map through map_decide_error_body (budget stays 400,
invalid_schema and other compile codes become 422); 200 bodies are
translated with the request's questions and model; other statuses
pass through unchanged. Router mode proxies the route by model.
---
 tools/server/server-context.cpp | 83 +++++++++++++++++++++++++++++----
 tools/server/server-context.h   |  1 +
 tools/server/server-task.h      |  2 +-
 tools/server/server.cpp         |  3 ++
 4 files changed, 79 insertions(+), 10 deletions(-)

diff --git a/tools/server/server-context.cpp b/tools/server/server-context.cpp
index 0b843978d..3e6d2ecf1 100644
--- a/tools/server/server-context.cpp
+++ b/tools/server/server-context.cpp
@@ -17,12 +17,14 @@
 #include "mtmd.h"
 #include "mtmd-helper.h"
 #include "decide-api.h"
+#include "decide-compat.h"
 
 #include <algorithm>
 #include <cstddef>
 #include <cinttypes>
 #include <exception>
 #include <memory>
+#include <optional>
 #include <filesystem>
 #include <random>
 #include <utility>
@@ -5369,7 +5371,11 @@ void server_routes::init_routes() {
         res.data   = safe_json_to_str(body);
     };
 
-    const auto decide_run = [](server_res_generator & res, const server_http_req & req, json request, bool info) {
+    // posts a decide task and waits for it; nullopt when the outcome was already handled here
+    // (connection closed: nothing written; generic task error: written via res.error()),
+    // otherwise the decide result's {status, body}
+    const auto decide_task = [](server_res_generator & res, const server_http_req & req, json request, bool info)
+            -> std::optional<std::pair<int, json>> {
         auto & rd = res.rd;
         {
             server_task task(SERVER_TASK_TYPE_DECIDE);
@@ -5383,20 +5389,19 @@ void server_routes::init_routes() {
         if (!result) {
             // connection was closed
             GGML_ASSERT(req.should_stop());
-            return;
+            return std::nullopt;
         }
 
         const auto * dres = dynamic_cast<server_task_result_decide *>(result.get());
         if (dres == nullptr) {
             GGML_ASSERT(result->is_error());
             res.error(result->to_json());
-            return;
+            return std::nullopt;
         }
-        res.status = dres->status;
-        res.data   = safe_json_to_str(dres->data);
+        return std::make_pair(dres->status, dres->data);
     };
 
-    this->post_decide = [this, decide_error, decide_run](const server_http_req & req) {
+    this->post_decide = [this, decide_error, decide_task](const server_http_req & req) {
         auto res = create_response();
         if (params.decide_seqs <= 0) {
             decide_error(*res, 404, "decide endpoint disabled (--decide-seqs 0)", "disabled");
@@ -5418,11 +5423,14 @@ void server_routes::init_routes() {
             return res;
         }
 
-        decide_run(*res, req, std::move(body), false);
+        if (auto out = decide_task(*res, req, std::move(body), false)) {
+            res->status = out->first;
+            res->data   = safe_json_to_str(out->second);
+        }
         return res;
     };
 
-    this->get_decide_info = [this, decide_error, decide_run](const server_http_req & req) {
+    this->get_decide_info = [this, decide_error, decide_task](const server_http_req & req) {
         auto res = create_response();
         if (params.decide_seqs <= 0) {
             decide_error(*res, 404, "decide endpoint disabled (--decide-seqs 0)", "disabled");
@@ -5430,7 +5438,64 @@ void server_routes::init_routes() {
         }
 
         // no schema: the engine renders the template-only assistant prefix
-        decide_run(*res, req, json(), true);
+        if (auto out = decide_task(*res, req, json(), true)) {
+            res->status = out->first;
+            res->data   = safe_json_to_str(out->second);
+        }
+        return res;
+    };
+
+    // Jev System One shape on top of the decide task; validation errors use FastAPI's
+    // {"detail": [...]} body, 404 disabled and 500 engine keep the {"error": {...}} body
+    this->post_systemone = [this, decide_error, decide_task](const server_http_req & req) {
+        auto res = create_response();
+        if (params.decide_seqs <= 0) {
+            decide_error(*res, 404, "decide endpoint disabled (--decide-seqs 0)", "disabled");
+            return res;
+        }
+
+        const auto validation_error = [&res](const decide::compat_error & e) {
+            res->status = 422;
+            res->data   = safe_json_to_str(decide::validation_body({e}));
+        };
+
+        json body = json::parse_no_throw(req.body);
+        if (body.is_discarded()) {
+            validation_error({{"body"}, "request body is not valid JSON", "json_invalid"});
+            return res;
+        }
+
+        // both validation layers run here so that bad requests never reach the model
+        json request;
+        try {
+            request = decide::systemone_to_decide(body);
+            decide::compile_request(request);
+            decide::states_of(request);
+        } catch (const decide::compat_error & e) {
+            validation_error(e);
+            return res;
+        } catch (const decide::error & e) {
+            validation_error(decide::from_decide_error(e));
+            return res;
+        }
+
+        auto out = decide_task(*res, req, std::move(request), false);
+        if (!out) {
+            return res;
+        }
+        const auto & [status, data] = *out;
+        if (status == 200) {
+            res->status = 200;
+            res->data   = safe_json_to_str(decide::decide_to_systemone(data, body.at("questions"), body.at("model").get<std::string>()));
+        } else if (status == 400) {
+            // post-task errors: invalid_schema (sibling prefixes) is a validation error, budget stays 400
+            const std::string code = data.contains("error") ? data.at("error").value("code", std::string()) : std::string();
+            res->status = code == "budget" ? 400 : 422;
+            res->data   = safe_json_to_str(decide::map_decide_error_body(status, data));
+        } else {
+            res->status = status;
+            res->data   = safe_json_to_str(data);
+        }
         return res;
     };
 }
