         routes.get_slots                   = models_routes->proxy_get;
         routes.post_slots                  = models_routes->proxy_post;
 
@@ -286,6 +287,8 @@ int llama_server(common_params & params, int argc, char ** argv) {
     // one-pass decisions (--decide-seqs)
     ctx_http.post("/v1/decide",                ex_wrapper(routes.post_decide));
     ctx_http.get ("/v1/decide/info",           ex_wrapper(routes.get_decide_info));
+    // Jev System One compatible shape on top of the decide engine
+    ctx_http.post("/v1/systemone",             ex_wrapper(routes.post_systemone));
     // Save & load slots
     ctx_http.get ("/slots",                    ex_wrapper(routes.get_slots));
     ctx_http.post("/slots/:id_slot",           ex_wrapper(routes.post_slots));
