+// request bounds: pretty text grows with the square of the nesting depth, so check the depth before any dump
+static constexpr int    max_depth            = 32;       // a scalar is depth 0, [1] depth 1
+static constexpr size_t max_questions        = 64;       // same as the compile field limit, checked before translation
+static constexpr size_t max_translated_bytes = 2097152;  // 2 MiB of text()/short() output per request
+
+// true when j nests deeper than depth levels; stops one level past the cap
+static bool deeper_than(const common_json & j, int depth) {
+    if (!j.is_object() && !j.is_array()) return false;
+    if (depth == 0) return true;
+    for (const auto & child : j) {
+        if (deeper_than(child, depth - 1)) return true;
+    }
+    return false;
+}
+
 // X = string | object | array
 static bool is_x(const common_json & j) {
     return j.is_string() || j.is_object() || j.is_array();
@@ -35,13 +50,24 @@ static std::string short_text(const common_json & j) {
     return j.dump();
 }
 
+// text() (pretty) or short_text() of a request value at loc, after the depth check; adds the output size to total and checks the cap
+static std::string bounded_text(const common_json & j, const loc_t & loc, bool pretty, size_t & total) {
+    if (deeper_than(j, max_depth)) fail(loc, "nesting deeper than " + std::to_string(max_depth) + " levels", "value_error");
+    std::string s = pretty ? text(j) : short_text(j);
+    total += s.size();
+    if (total > max_translated_bytes) {
+        fail({"body"}, "request too large after serialisation (" + std::to_string(total) + " bytes, limit " + std::to_string(max_translated_bytes) + ")", "value_error");
+    }
+    return s;
+}
