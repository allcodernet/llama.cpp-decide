diff --git a/tools/decide/decide-pixels.cpp b/tools/decide/decide-pixels.cpp
new file mode 100644
index 000000000..8ea7051fb
--- /dev/null
+++ b/tools/decide/decide-pixels.cpp
@@ -0,0 +1,29 @@
+#include "decide-pixels.h"
+
+// libmtmd compiles stb_image with external linkage (tools/mtmd/mtmd-helper.cpp); this copy is static, JPEG and PNG only
+#define STB_IMAGE_STATIC
+#define STB_IMAGE_IMPLEMENTATION
+#define STBI_ONLY_JPEG
+#define STBI_ONLY_PNG
+#define STBI_NO_STDIO
+#include "stb/stb_image.h"
+
+namespace decide {
+
+bool decode_rgb(const std::string & bytes, std::vector<unsigned char> & rgb, uint32_t & nx, uint32_t & ny, std::string & why) {
+    int             x = 0, y = 0, comp = 0;
+    unsigned char * data = stbi_load_from_memory((const stbi_uc *) bytes.data(), (int) bytes.size(), &x, &y, &comp, 3);
+    if (data == nullptr) {
+        // stb_image's unknown-chunk reason starts with the chunk type, an empty string for type 0 (a PNG that ends after IHDR)
+        const char * reason = stbi_failure_reason();
+        why = reason && *reason ? reason : "unknown stb_image error";
+        return false;
+    }
+    nx = (uint32_t) x;
+    ny = (uint32_t) y;
+    rgb.assign(data, data + (size_t) x * (size_t) y * 3);
+    stbi_image_free(data);
+    return true;
+}
+
+} // namespace decide
