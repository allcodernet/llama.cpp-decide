+#pragma once
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace decide {
+
+// spec 3.1: JPEG or PNG bytes -> RGB pixels (row-major, 3 bytes per pixel) with the decide library's own static copy of the
+// vendored stb_image (JPEG and PNG only); false and `why` when stb_image cannot decode them. libmtmd's loader (audio, webp
+// and video paths, ffmpeg) is never used.
+bool decode_rgb(const std::string & bytes, std::vector<unsigned char> & rgb, uint32_t & nx, uint32_t & ny, std::string & why);
+
+} // namespace decide
