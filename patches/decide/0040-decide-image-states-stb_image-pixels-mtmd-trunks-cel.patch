+std::vector<engine::state_input> engine::prepare_inputs(const std::vector<state_parts> & states, std::vector<image_input> & images) const {
+    std::vector<state_input> out(states.size());
+    for (size_t i = 0; i < states.size(); ++i) {
+        const state_parts & parts = states[i];
+        state_input &       in    = out[i];
+        size_t              last  = parts.size();   // the last image part; parts.size() when there is none
+        for (size_t k = 0; k < parts.size(); ++k) {
+            if (parts[k].image) {
+                last = k;
+            }
+        }
+        for (size_t k = 0; k < parts.size(); ++k) {
+            const state_part & p = parts[k];
+            if (!p.image) {
+                // spec 3.1: untrusted text, no special tokens (a media marker in it stays text)
+                std::vector<llama_token> toks = tokenize_plain(vocab, p.text);
+                in.text_tokens += (int64_t) toks.size();
+                if (last < parts.size() && k < last) {
+                    in.head.push_back({std::move(toks), -1});
+                } else {
+                    in.rest = std::move(toks);   // after the last image (at most one text part: no two are adjacent), or no image at all
+                }
+                continue;
+            }
+            images.push_back(tokenize_image(p, i, k));
+            in.head.push_back({{}, (int) images.size() - 1});
+            in.image_cells     += images.back().n_tokens;
+            in.image_positions += images.back().n_pos;
+            in.images++;
+        }
+    }
+    return out;
+}
+
+int engine::decode_tokens(const std::vector<llama_token> & toks, llama_seq_id seq, llama_pos & pos, stats & st) {
+    std::vector<entry> entries;
+    entries.reserve(toks.size());
+    for (llama_token t : toks) {
+        entries.push_back({t, pos++, seq, -1});
+    }
+    return decode_chunked(entries, nullptr, st);
+}
+
+int engine::decode_image(const image_input & im, llama_seq_id seq, llama_pos & pos, stats & st) {
+    const mtmd_input_chunks * chunks = im.chunks.get();
+    for (size_t j = 0; j < mtmd_input_chunks_size(chunks); ++j) {
+        const mtmd_input_chunk * ch = mtmd_input_chunks_get(chunks, j);
+        if (mtmd_input_chunk_get_type(ch) == MTMD_INPUT_CHUNK_TYPE_TEXT) {
+            size_t              n    = 0;
+            const llama_token * toks = mtmd_input_chunk_get_tokens_text(ch, &n);
+            const int           rc   = decode_tokens(std::vector<llama_token>(toks, toks + n), seq, pos, st);
+            if (rc != 0) {
+                return rc;
+            }
+            continue;
+        }
+        // spec 5.2: encode (the embeddings live in the context's buffer until the next encode), then the helper's decode; an image
+        // is encoded again for every variant and retry
+        int64_t t = ggml_time_us();
+        if (mtmd_encode_chunk(cfg.mctx, ch) != 0) {
+            throw error("engine", 500, "image encode failed (projector)");
+        }
+        float * embd = mtmd_get_output_embd(cfg.mctx);
+        st.image_encode_us += ggml_time_us() - t;
+        t = ggml_time_us();
+        llama_pos     next = pos;
+        const int32_t rc   = mtmd_helper_decode_image_chunk(cfg.mctx, ctx, ch, embd, pos, seq, n_batch, &next, nullptr, nullptr);
+        llama_synchronize(ctx);
+        st.image_decode_us += ggml_time_us() - t;
+        if (rc == 1) {
+            return 1;   // no KV slot: the round's retry path
+        }
+        if (rc != 0) {
+            throw error("engine", 500, "image decode failed: rc=" + std::to_string(rc));
+        }
+        const int64_t n = (int64_t) mtmd_input_chunk_get_n_tokens(ch);
+        st.prompt_tokens += n;   // spec 3.3: every decoded cell, once per decode
+        st.decodes += (int) ((n + n_batch - 1) / n_batch);
+        pos = next;   // M-RoPE: far fewer positions than cells
+    }
+    return 0;
+}
