index 000000000..7dac04438
--- /dev/null
+++ b/tests/test-decide-image.cpp
@@ -0,0 +1,280 @@
+// Sub-project 4 without a model (spec 3.1-3.4, 4.1, 9.1): the states of a request as text and image parts, strict base64,
+// the data URI, the JPEG/PNG header and its pixel limit, every limit, the order of the checks and the vision status
+#include "decide-engine.h"
+#include "decide-image.h"
+#include "decide-schema.h"
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <vector>
+
+static int failures = 0;
+#define CHECK(cond) do { if (!(cond)) { std::fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #cond); failures++; } } while (0)
+
+using decide::vision_reason;
+
+// 2 x 3 RGB PNG (rows: red green / blue yellow / cyan magenta) and a 4 x 2 baseline JPEG (Pillow, 2026-10-02). The JPEG's
+// SOF0 marker is at byte 158: precision at 162, height at 163-164, width at 165-166.
+static const char * PNG_B64 = "iVBORw0KGgoAAAANSUhEUgAAAAIAAAADCAIAAAA2iEnWAAAAGElEQVR4nAXBAQEAAAjDIG7/zhOEoHJiPUfdBv3wKgpGAAAAAElFTkSuQmCC";
+static const char * JPG_B64 = "";
+static const size_t JPG_SOF = 158;
+
+static std::string unb64(const char * s) {
+    std::string out;
+    if (!decide::base64_decode_strict(s, out)) {
+        std::fprintf(stderr, "FAIL fixture is not base64\n");
+        std::exit(1);
+    }
+    return out;
+}
+
+static std::string b64(const std::string & in) {
+    static const char * A = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    std::string out;
+    size_t      i = 0;
+    for (; i + 2 < in.size(); i += 3) {
+        const uint32_t v = ((uint32_t) (uint8_t) in[i] << 16) | ((uint32_t) (uint8_t) in[i + 1] << 8) | (uint8_t) in[i + 2];
+        out += A[v >> 18]; out += A[(v >> 12) & 63]; out += A[(v >> 6) & 63]; out += A[v & 63];
+    }
+    if (i + 1 == in.size()) {
+        const uint32_t v = (uint32_t) (uint8_t) in[i] << 16;
+        out += A[v >> 18]; out += A[(v >> 12) & 63]; out += "==";
+    } else if (i + 2 == in.size()) {
+        const uint32_t v = ((uint32_t) (uint8_t) in[i] << 16) | ((uint32_t) (uint8_t) in[i + 1] << 8);
+        out += A[v >> 18]; out += A[(v >> 12) & 63]; out += A[(v >> 6) & 63]; out += '=';
+    }
+    return out;
+}
+
+static std::string be32(uint32_t v) {
+    std::string s(4, '\0');
+    s[0] = (char) (v >> 24); s[1] = (char) (v >> 16); s[2] = (char) (v >> 8); s[3] = (char) v;
+    return s;
+}
+
+// a PNG signature and IHDR chunk only: enough for the header check, no pixel data
+static std::string png_header(uint32_t w, uint32_t h) {
+    return std::string("\x89PNG\r\n\x1a\n", 8) + be32(13) + "IHDR" + be32(w) + be32(h) + std::string("\x08\x02\x00\x00\x00", 5) + be32(0);
+}
+
+static std::string url(const std::string & bytes, const std::string & subtype = "png") { return "data:image/" + subtype + ";base64," + b64(bytes); }
+static std::string img(const std::string & u) { return R"({"type": "image_url", "image_url": {"url": )" + decide::json_string(u) + "}}"; }
+static std::string txt(const std::string & t) { return R"({"type": "text", "text": )" + decide::json_string(t) + "}"; }
+static std::string list(const std::vector<std::string> & items) {
+    std::string s = "[";
+    for (size_t i = 0; i < items.size(); ++i) {
+        s += (i ? ", " : "") + items[i];
+    }
+    return s + "]";
+}
+static common_json body(const std::vector<std::string> & states) { return common_json::parse(R"({"states": )" + list(states) + "}"); }
+
+// states_of must accept the states (raw JSON texts); a rejection ends the test
+static std::vector<decide::state_parts> accept(const std::vector<std::string> & states, vision_reason v = vision_reason::AVAILABLE) {
+    try {
+        return decide::states_of(body(states), v);
+    } catch (const decide::error & e) {
+        std::fprintf(stderr, "FAIL rejected: %s\n", e.what());
+        std::exit(1);
+    }
+}
+
+// states_of must fail with this code (http 400) and field, with `text` in the message
+static void reject(const std::vector<std::string> & states, const std::string & code, const std::string & field, const std::string & text,
+                   vision_reason v = vision_reason::AVAILABLE) {
+    try {
+        (void) decide::states_of(body(states), v);
+    } catch (const decide::error & e) {
+        if (e.code != code || e.http != 400 || e.field != field || std::string(e.what()).find(text) == std::string::npos) {
+            std::fprintf(stderr, "FAIL wrong error: code=%s http=%d field=%s msg=%s (wanted %s, %s, \"%s\")\n", e.code.c_str(), e.http,
+                         e.field.c_str(), e.what(), code.c_str(), field.c_str(), text.c_str());
+            failures++;
+        }
+        return;
+    }
+    std::fprintf(stderr, "FAIL no error (wanted %s %s \"%s\")\n", code.c_str(), field.c_str(), text.c_str());
+    failures++;
+}
+
+int main() {
+    const std::string png = unb64(PNG_B64);
+    const std::string jpg = unb64(JPG_B64);
+    CHECK(png.size() == 81 && jpg.size() == 633);
+
+    // 1. strict base64 (RFC 4648 section 4): round trips, then every malformed form
+    {
+        std::string all;
+        for (int i = 0; i < 256; ++i) {
+            all += (char) i;
+        }
+        std::string out;
+        for (size_t n = 0; n <= 20; ++n) {
+            CHECK(decide::base64_decode_strict(b64(all.substr(0, n)), out) && out == all.substr(0, n));
+        }
+        CHECK(decide::base64_decode_strict(b64(all), out) && out == all);
+        CHECK(decide::base64_decode_strict("", out) && out.empty());
+        for (const char * bad : {"QQ", "QQ=", "QQ=A", "Q===", "====", "QUJD\n", "QU JD", "QUJ-", "QUJ_", "QQ==QUJD", "QUJD====", "Q"}) {
+            CHECK(!decide::base64_decode_strict(bad, out));
+        }
+    }
+
+    // 2. headers: sizes; APP segments, fill bytes and a progressive frame; unreadable headers
+    {
+        decide::image_header h;
+        CHECK(decide::read_image_header(png, h) == "" && h.format == "png" && h.width == 2 && h.height == 3);
+        CHECK(decide::read_image_header(jpg, h) == "" && h.format == "jpeg" && h.width == 4 && h.height == 2);
+        CHECK((unsigned char) jpg[JPG_SOF] == 0xFF && (unsigned char) jpg[JPG_SOF + 1] == 0xC0);
+        const std::string app = jpg.substr(0, 2) + std::string("\xFF\xE1\x00\x06" "abcd", 8) + "\xFF" + jpg.substr(2);   // APP1, then a fill byte
+        CHECK(decide::read_image_header(app, h) == "" && h.width == 4 && h.height == 2);
+        std::string prog = jpg;
+        prog[JPG_SOF + 1] = (char) 0xC2;   // progressive frame header
+        CHECK(decide::read_image_header(prog, h) == "" && h.format == "jpeg" && h.width == 4 && h.height == 2);
+        std::string zero = jpg;
+        zero[JPG_SOF + 5] = 0;
+        zero[JPG_SOF + 6] = 0;   // height 0
+        CHECK(decide::read_image_header(zero, h).find("zero width or height") != std::string::npos);
+        CHECK(decide::read_image_header(jpg.substr(0, 100), h).find("truncated") != std::string::npos);   // ends before the SOF
+        CHECK(decide::read_image_header(std::string("\xFF\xD8\xFF\xDA\x00\x02", 6), h).find("no frame header") != std::string::npos);
+        CHECK(decide::read_image_header(png.substr(0, 20), h).find("PNG header") != std::string::npos);
+        CHECK(decide::read_image_header(std::string("BM") + std::string(60, '\0'), h) == "the image is not a JPEG or PNG file");
+        CHECK(decide::read_image_header(png_header(8000, 4000), h) == "" && h.width == 8000 && h.height == 4000);
+    }
+
+    // 3. a string and its one-part form are the same state; parts keep their order; the format comes from the magic bytes
+    {
+        const auto a = accept({"\"hello\""});
+        const auto b = accept({list({txt("hello")})});
+        CHECK(a.size() == 1 && b.size() == 1 && a[0].size() == 1 && b[0].size() == 1);
+        CHECK(!a[0][0].image && !b[0][0].image && a[0][0].text == "hello" && b[0][0].text == "hello");
+        const auto c = accept({list({txt("a"), img(url(png)), txt("b"), img(url(jpg, "jpeg"))})});
+        CHECK(c[0].size() == 4 && !c[0][0].image && c[0][1].image && !c[0][2].image && c[0][3].image);
+        CHECK(c[0][0].text == "a" && c[0][2].text == "b");
+        CHECK(c[0][1].format == "png" && c[0][1].width == 2 && c[0][1].height == 3 && c[0][1].bytes == png);
+        CHECK(c[0][3].format == "jpeg" && c[0][3].width == 4 && c[0][3].height == 2 && c[0][3].bytes == jpg);
+        const auto d = accept({list({img(url(jpg, "png"))}), list({img(url(png, "svg+xml"))}), "\"text\""});
+        CHECK(d.size() == 3 && d[0][0].format == "jpeg" && d[1][0].format == "png" && !d[2][0].image);
+        CHECK(accept({list({img(url(png))})})[0].size() == 1);
+        CHECK(accept({list({img(url(png)), txt("after")})})[0][1].text == "after");
+    }
+
+    // 4. malformed parts (spec 3.1): field states[i] of the state that breaks a rule
+    {
+        const std::string ok = img(url(png));
+        const std::string is = "invalid_states";
+        reject({"\"x\"", list({})}, is, "states[1]", "must not be empty");
+        reject({list({txt("a"), txt("b")})}, is, "states[0]", "must not be adjacent");
+        reject({list({txt("a"), ok, txt("b"), txt("c")})}, is, "states[0]", "part 3: two text parts must not be adjacent");
+        reject({list({R"({"type": "input_image", "image_url": {"url": "x"}})"})}, is, "states[0]", "unknown part type \"input_image\"");
+        reject({list({R"("text")"})}, is, "states[0]", "a part must be an object");
+        reject({list({R"({"text": "a"})"})}, is, "states[0]", "a part must be an object");
+        reject({list({R"({"type": 1})"})}, is, "states[0]", "a part must be an object");
+        reject({list({txt("")})}, is, "states[0]", "a text part is");
+        reject({list({R"({"type": "text", "text": 5})"})}, is, "states[0]", "a text part is");
+        reject({list({R"({"type": "text", "text": "a", "extra": 1})"})}, is, "states[0]", "a text part is");
+        reject({list({R"({"type": "image_url", "image_url": "data:image/png;base64,AAAA"})"})}, is, "states[0]", "an image part is");
+        reject({list({R"({"type": "image_url", "image_url": {}})"})}, is, "states[0]", "an image part is");
+        reject({list({R"({"type": "image_url", "image_url": {"url": 1}})"})}, is, "states[0]", "an image part is");
+        reject({list({R"({"type": "image_url", "image_url": {"url": ")" + url(png) + R"(", "detail": "auto"}})"})}, is, "states[0]", "an image part is");
+        reject({"\"x\"", "1"}, is, "states[1]", "strings or arrays of parts");
+        reject({"\"x\"", "{}"}, is, "states[1]", "strings or arrays of parts");
+        reject({"\"\""}, is, "", "states entries must not be empty");   // today's message and field
+    }
+
+    // 5. limits: 4 images per state, 32 per request (named at the state with the 33rd image), 10 MiB, 32,000,000 pixels
+    {
+        const std::string ok = img(url(png));
+        const std::string is = "invalid_states";
+        CHECK(accept({list({ok, ok, ok, ok, txt("x")})})[0].size() == 5);
+        reject({list({ok, ok, ok, ok, ok})}, is, "states[0]", "at most 4 images per state");
+        std::vector<std::string> nine(9, list({ok, ok, ok, ok}));
+        reject(nine, is, "states[8]", "at most 32 images per request");
+        nine.pop_back();
+        CHECK(accept(nine).size() == 8);   // exactly 32
+        std::string big = png_header(1, 1);
+        big.resize(decide::MAX_IMAGE_BYTES, '\0');
+        CHECK(accept({list({img(url(big))})})[0][0].bytes.size() == 10485760);
+        big.push_back('\0');
+        reject({list({img(url(big))})}, is, "states[0]", "(at most 10485760)");   // decoded size
+        big.append(3, '\0');
+        reject({list({img(url(big))})}, is, "states[0]", "(at most 10485760)");   // encoded length, before decoding
+        CHECK(accept({list({img(url(png_header(8000, 4000)))})})[0][0].width == 8000);   // 32,000,000 pixels: allowed
+        reject({list({img(url(png_header(8000, 4001)))})}, is, "states[0]", "8000 x 4001 = 32008000 pixels, at most 32000000");
+        std::string tall = jpg;
+        tall[JPG_SOF + 5] = (char) 0x0F; tall[JPG_SOF + 6] = (char) 0xA1;   // height 4001
+        tall[JPG_SOF + 7] = (char) 0x1F; tall[JPG_SOF + 8] = (char) 0x40;   // width 8000
+        reject({list({img(url(tall, "jpeg"))})}, is, "states[0]", "8000 x 4001 = 32008000 pixels");
+    }
+
+    // 6. the URL: data:image/<subtype>;base64,<data> only, case-sensitive, no parameters; strict base64
+    {
+        const std::string is   = "invalid_states";
+        const std::string data = b64(png);
+        for (const std::string & u : {std::string("http://images.cocodataset.org/val2017/000000039769.jpg"), std::string("https://x/y.png"),
+                                      std::string("file:///etc/hostname"), std::string("/home/marduk/x.png"), data,
+                                      "DATA:image/png;base64," + data, "data:IMAGE/png;base64," + data, "data:image/PNG;base64," + data,
+                                      "data:image/png;BASE64," + data, "data:image/png;charset=utf-8;base64," + data,
+                                      "data:image/;base64," + data, "data:text/plain;base64," + data, "data:image/png," + data,
+                                      "data:image/png;base64" + data}) {
+            reject({list({img(u)})}, is, "states[0]", "data:image/<subtype>;base64,<data>");
+        }
+        reject({list({img("data:image/png;base64,")})}, is, "states[0]", "not a JPEG or PNG");                         // empty data
+        reject({list({img("data:image/png;base64," + data.substr(0, data.size() - 2))})}, is, "states[0]", "invalid base64");   // length
+        reject({list({img("data:image/png;base64," + data.substr(0, 40) + "\n" + data.substr(40))})}, is, "states[0]", "invalid base64");
+        std::string urlsafe = data;
+        for (char & c : urlsafe) {
+            if (c == '+') c = '-';
+            if (c == '/') c = '_';
+        }
+        CHECK(urlsafe != data);
+        reject({list({img("data:image/png;base64," + urlsafe)})}, is, "states[0]", "invalid base64");
+        reject({list({img(url(std::string("BM") + std::string(60, '\0')))})}, is, "states[0]", "not a JPEG or PNG");
+        reject({list({img(url(png.substr(0, 20)))})}, is, "states[0]", "PNG header");
+    }
+
+    // 7. passes 1-2 (spec 3.2): pass 1 over every state first, then vision_unavailable at the first state with an image (spec 4.2)
+    {
+        const std::string ok = img(url(png));
+        const std::string vu = "vision_unavailable";
+        reject({list({ok})}, vu, "states[0]", "--mmproj", vision_reason::NO_PROJECTOR);
+        reject({"\"text\"", list({txt("a"), ok})}, vu, "states[1]", "(no_projector)", vision_reason::NO_PROJECTOR);
+        reject({"\"t\"", list({ok})}, vu, "states[1]", "(projector_without_vision)", vision_reason::PROJECTOR_WITHOUT_VISION);
+        reject({"\"t\"", list({ok})}, vu, "states[1]", "(non_causal_projector)", vision_reason::NON_CAUSAL_PROJECTOR);
+        reject({list({ok}), list({txt("a"), txt("b")})}, "invalid_states", "states[1]", "adjacent", vision_reason::NO_PROJECTOR);
+        for (vision_reason v : {vision_reason::NO_PROJECTOR, vision_reason::PROJECTOR_WITHOUT_VISION, vision_reason::NON_CAUSAL_PROJECTOR}) {
+            const auto t = accept({"\"a\"", list({txt("b")})}, v);   // without images the parse does not depend on vision
+            CHECK(t.size() == 2 && t[0][0].text == "a" && t[1][0].text == "b" && !t[0][0].image && !t[1][0].image);
+        }
+    }
+
+    // 8. the vision status (spec 4.1) and its info key (spec 3.4)
+    {
+        CHECK(decide::vision_reason_for(false, true, false, true) == vision_reason::NO_PROJECTOR);
+        CHECK(decide::vision_reason_for(true, false, false, true) == vision_reason::PROJECTOR_WITHOUT_VISION);
+        CHECK(decide::vision_reason_for(true, true, true, false) == vision_reason::NON_CAUSAL_PROJECTOR);
+        CHECK(decide::vision_reason_for(true, true, true, true) == vision_reason::AVAILABLE);
+        CHECK(decide::vision_reason_for(true, true, false, false) == vision_reason::AVAILABLE);
+        const decide::vision_status none = decide::vision_status_of(nullptr);
+        CHECK(none.reason == vision_reason::NO_PROJECTOR && !none.mrope && !none.non_causal);
+        CHECK(decide::vision_json(none).dump() == R"({"available":false,"reason":"no_projector"})");
+        decide::vision_status v;
+        v.reason = vision_reason::AVAILABLE;
+        v.mrope  = true;
+        const common_json j = decide::vision_json(v);
+        CHECK(j.at("available").get<bool>() && j.at("mrope").get<bool>() && !j.at("non_causal").get<bool>());
+        CHECK(j.at("max_images_per_state").get<int64_t>() == 4 && j.at("max_images_per_request").get<int64_t>() == 32);
+        CHECK(j.at("max_image_bytes").get<int64_t>() == 10485760 && j.at("max_image_pixels").get<int64_t>() == 32000000);
+        v.reason = vision_reason::PROJECTOR_WITHOUT_VISION;
+        CHECK(decide::vision_json(v).dump() == R"({"available":false,"reason":"projector_without_vision"})");
+        v.reason = vision_reason::NON_CAUSAL_PROJECTOR;
+        CHECK(decide::vision_json(v).dump() == R"({"available":false,"reason":"non_causal_projector"})");
+    }
+
+    if (failures) {
+        std::fprintf(stderr, "%d failure(s)\n", failures);
+        return 1;
+    }
+    std::printf("test-decide-image: OK\n");
+    return 0;
+}
