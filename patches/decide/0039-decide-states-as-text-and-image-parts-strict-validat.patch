diff --git a/tools/decide/decide-image.cpp b/tools/decide/decide-image.cpp
new file mode 100644
index 000000000..6518f832b
--- /dev/null
+++ b/tools/decide/decide-image.cpp
@@ -0,0 +1,257 @@
+#include "decide-image.h"
+
+namespace decide {
+
+vision_reason vision_reason_for(bool projector, bool supports_vision, bool non_causal, bool non_causal_enabled) {
+    if (!projector) {
+        return vision_reason::NO_PROJECTOR;
+    }
+    if (!supports_vision) {
+        return vision_reason::PROJECTOR_WITHOUT_VISION;
+    }
+    if (non_causal && !non_causal_enabled) {
+        return vision_reason::NON_CAUSAL_PROJECTOR;
+    }
+    return vision_reason::AVAILABLE;
+}
+
+const char * vision_reason_code(vision_reason r) {
+    switch (r) {
+        case vision_reason::NO_PROJECTOR:             return "no_projector";
+        case vision_reason::PROJECTOR_WITHOUT_VISION: return "projector_without_vision";
+        case vision_reason::NON_CAUSAL_PROJECTOR:     return "non_causal_projector";
+        case vision_reason::AVAILABLE:                break;
+    }
+    return "";
+}
+
+std::string vision_unavailable_message(size_t state, vision_reason r) {
+    std::string why;
+    switch (r) {
+        case vision_reason::NO_PROJECTOR:             why = "no projector is loaded; start the server or llama-decide with --mmproj"; break;
+        case vision_reason::PROJECTOR_WITHOUT_VISION: why = "the loaded projector has no vision encoder"; break;
+        case vision_reason::NON_CAUSAL_PROJECTOR:     why = "the projector decodes images with non-causal attention, which this engine does not support"; break;
+        case vision_reason::AVAILABLE:                why = "vision is available"; break;
+    }
+    return "states[" + std::to_string(state) + "] has an image part, but vision is not available (" + vision_reason_code(r) + "): " + why;
+}
+
+common_json vision_json(const vision_status & v) {
+    common_json j = common_json::object();
+    if (v.reason != vision_reason::AVAILABLE) {
+        j["available"] = false;
+        j["reason"]    = std::string(vision_reason_code(v.reason));
+        return j;
+    }
+    j["available"]              = true;
+    j["mrope"]                  = v.mrope;
+    j["non_causal"]             = v.non_causal;
+    j["max_images_per_state"]   = (int64_t) MAX_IMAGES_PER_STATE;
+    j["max_images_per_request"] = (int64_t) MAX_IMAGES_PER_REQUEST;
+    j["max_image_bytes"]        = (int64_t) MAX_IMAGE_BYTES;
+    j["max_image_pixels"]       = (int64_t) MAX_IMAGE_PIXELS;
+    return j;
+}
+
+static int b64_value(unsigned char c) {
+    if (c >= 'A' && c <= 'Z') return c - 'A';
+    if (c >= 'a' && c <= 'z') return c - 'a' + 26;
+    if (c >= '0' && c <= '9') return c - '0' + 52;
+    if (c == '+') return 62;
+    if (c == '/') return 63;
+    return -1;
+}
+
+bool base64_decode_strict(std::string_view in, std::string & out) {
+    out.clear();
+    if (in.size() % 4 != 0) {
+        return false;
+    }
+    size_t pad = 0;   // at most two '=' at the very end; '=' anywhere else fails below
+    while (pad < 2 && pad < in.size() && in[in.size() - 1 - pad] == '=') {
+        pad++;
+    }
+    out.reserve(in.size() / 4 * 3);
+    uint32_t acc  = 0;
+    int      bits = 0;
+    for (size_t i = 0; i + pad < in.size(); ++i) {
+        const int v = b64_value((unsigned char) in[i]);
+        if (v < 0) {
+            return false;
+        }
+        acc = ((acc << 6) | (uint32_t) v) & 0xFFFFFF;
+        bits += 6;
+        if (bits >= 8) {
+            bits -= 8;
+            out.push_back((char) ((acc >> bits) & 0xFF));
+        }
+    }
+    return true;
+}
+
+static uint32_t be16(const std::string & b, size_t p) {
+    return ((uint32_t) (uint8_t) b[p] << 8) | (uint8_t) b[p + 1];
+}
+
+static uint32_t be32(const std::string & b, size_t p) {
+    return (be16(b, p) << 16) | be16(b, p + 2);
+}
+
+std::string read_image_header(const std::string & b, image_header & h) {
+    static const char png_magic[] = "\x89PNG\r\n\x1a\n";
+    if (b.size() >= 8 && b.compare(0, 8, png_magic, 8) == 0) {
+        if (b.size() < 24 || b.compare(12, 4, "IHDR") != 0) {
+            return "cannot read the PNG header (no IHDR chunk)";
+        }
+        h.format = "png";
+        h.width  = be32(b, 16);
+        h.height = be32(b, 20);
+        if (h.width == 0 || h.height == 0) {
+            return "the PNG header gives a zero width or height";
+        }
+        return "";
+    }
+    if (b.size() >= 3 && (uint8_t) b[0] == 0xFF && (uint8_t) b[1] == 0xD8 && (uint8_t) b[2] == 0xFF) {
+        size_t p = 2;   // after SOI: segments until the frame header (SOFn)
+        while (p < b.size()) {
+            if ((uint8_t) b[p] != 0xFF) {
+                return "cannot read the JPEG header (no marker where one is expected)";
+            }
+            while (p < b.size() && (uint8_t) b[p] == 0xFF) {
+                ++p;   // a marker may be preceded by fill bytes
+            }
+            if (p >= b.size()) {
+                break;
+            }
+            const uint8_t m = (uint8_t) b[p++];
+            if (m == 0xD8 || m == 0x01 || (m >= 0xD0 && m <= 0xD7)) {
+                continue;   // markers without a length
+            }
+            if (m == 0xDA || m == 0xD9) {
+                return "cannot read the JPEG header (no frame header before the image data)";
+            }
+            if (p + 2 > b.size()) {
+                break;
+            }
+            const uint32_t len = be16(b, p);
+            if (len < 2 || p + len > b.size()) {
+                break;
+            }
+            const bool sof = m >= 0xC0 && m <= 0xCF && m != 0xC4 && m != 0xC8 && m != 0xCC;
+            if (sof) {
+                if (len < 7) {
+                    return "cannot read the JPEG header (short frame header)";
+                }
+                h.format = "jpeg";
+                h.height = be16(b, p + 3);
+                h.width  = be16(b, p + 5);
+                if (h.width == 0 || h.height == 0) {
+                    return "the JPEG header gives a zero width or height";
+                }
+                return "";
+            }
+            p += len;
+        }
+        return "cannot read the JPEG header (truncated)";
+    }
+    return "the image is not a JPEG or PNG file";
+}
+
+static error invalid(size_t state, const std::string & msg) {
+    const std::string where = "states[" + std::to_string(state) + "]";
+    return error("invalid_states", 400, where + ": " + msg, where);
+}
+
+static bool subtype_char(char c) {
+    return (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '.' || c == '+' || c == '-';
+}
+
+// spec 3.1: the data URI of one image part -> its bytes, format and header size; pixel and size limits
+static state_part parse_image(const std::string & url, size_t state, const std::string & part) {
+    static const std::string scheme = "data:image/";
+    static const std::string marker = ";base64,";
+    static const std::string form   = "the url must be data:image/<subtype>;base64,<data>";
+    if (url.compare(0, scheme.size(), scheme) != 0) {
+        throw invalid(state, part + form + "; remote URLs, file: URLs, paths and bare base64 are not accepted");
+    }
+    size_t i = scheme.size();
+    while (i < url.size() && subtype_char(url[i])) {
+        ++i;
+    }
+    if (i == scheme.size() || url.compare(i, marker.size(), marker) != 0) {
+        throw invalid(state, part + form + " with a subtype of a-z 0-9 . + - and no further parameters");
+    }
+    const std::string_view data = std::string_view(url).substr(i + marker.size());
+    if (data.size() > (MAX_IMAGE_BYTES + 2) / 3 * 4) {
+        throw invalid(state, part + "the image has more than " + std::to_string(MAX_IMAGE_BYTES) + " bytes (at most " +
+                                 std::to_string(MAX_IMAGE_BYTES) + ")");
+    }
+    state_part p;
+    p.image = true;
+    if (!base64_decode_strict(data, p.bytes)) {
+        throw invalid(state, part + "invalid base64 (standard alphabet A-Z a-z 0-9 + /, = padding, a length that is a multiple of 4, "
+                                    "no whitespace)");
+    }
+    if (p.bytes.size() > MAX_IMAGE_BYTES) {
+        throw invalid(state, part + "the image has " + std::to_string(p.bytes.size()) + " bytes (at most " + std::to_string(MAX_IMAGE_BYTES) + ")");
+    }
+    image_header      h;
+    const std::string why = read_image_header(p.bytes, h);
+    if (!why.empty()) {
+        throw invalid(state, part + why);
+    }
+    const uint64_t pixels = (uint64_t) h.width * h.height;
+    if (pixels > MAX_IMAGE_PIXELS) {
+        throw invalid(state, part + "the image is " + std::to_string(h.width) + " x " + std::to_string(h.height) + " = " +
+                                 std::to_string(pixels) + " pixels, at most " + std::to_string(MAX_IMAGE_PIXELS));
+    }
+    p.format = h.format;
+    p.width  = h.width;
+    p.height = h.height;
+    return p;
+}
+
+state_parts parse_parts(const common_json & parts, size_t state, int & images) {
+    if (parts.size() == 0) {
+        throw invalid(state, "a part list must not be empty");
+    }
+    state_parts out;
+    int         in_state = 0;
+    for (size_t k = 0; k < parts.size(); ++k) {
+        const std::string where = "part " + std::to_string(k) + ": ";
+        const auto &      pj    = parts.at(k);
+        if (!pj.is_object() || !pj.contains("type") || !pj.at("type").is_string()) {
+            throw invalid(state, where + "a part must be an object with a string \"type\"");
+        }
+        const std::string type = pj.at("type").get<std::string>();
+        if (type == "text") {
+            if (pj.size() != 2 || !pj.contains("text") || !pj.at("text").is_string() || pj.at("text").get<std::string>().empty()) {
+                throw invalid(state, where + "a text part is {\"type\": \"text\", \"text\": <non-empty string>}");
+            }
+            if (!out.empty() && !out.back().image) {
+                throw invalid(state, where + "two text parts must not be adjacent; join them into one");
+            }
+            state_part p;
+            p.text = pj.at("text").get<std::string>();
+            out.push_back(std::move(p));
+        } else if (type == "image_url") {
+            const bool shape = pj.size() == 2 && pj.contains("image_url") && pj.at("image_url").is_object() &&
+                               pj.at("image_url").size() == 1 && pj.at("image_url").contains("url") && pj.at("image_url").at("url").is_string();
+            if (!shape) {
+                throw invalid(state, where + "an image part is {\"type\": \"image_url\", \"image_url\": {\"url\": <data URI>}}");
+            }
+            if (++in_state > MAX_IMAGES_PER_STATE) {
+                throw invalid(state, where + "at most 4 images per state");
+            }
+            if (++images > MAX_IMAGES_PER_REQUEST) {
+                throw invalid(state, where + "at most 32 images per request");
+            }
+            out.push_back(parse_image(pj.at("image_url").at("url").get<std::string>(), state, where));
+        } else {
+            throw invalid(state, where + "unknown part type \"" + type + "\" (text or image_url)");
+        }
+    }
+    return out;
+}
+
+} // namespace decide
diff --git a/tools/decide/decide-image.h b/tools/decide/decide-image.h
new file mode 100644
index 000000000..e3eb8a4c1
--- /dev/null
+++ b/tools/decide/decide-image.h
@@ -0,0 +1,50 @@
+#pragma once
+#include "decide-schema.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <string_view>
+
+// Image parts of a state without a model (spec 3.1-3.4, 4.1): the limits, the vision status as info reports it, strict
+// base64, the JPEG/PNG header and the part list of one state.
+namespace decide {
+
+constexpr int      MAX_IMAGES_PER_STATE   = 4;
+constexpr int      MAX_IMAGES_PER_REQUEST = 32;
+constexpr size_t   MAX_IMAGE_BYTES        = 10485760;   // 10 MiB, decoded
+constexpr uint64_t MAX_IMAGE_PIXELS       = 32000000;   // width x height
+// spec 9.5: whether non-causal projectors (Gemma 3) are enabled; false once gemma-3-4b fails the non-causal gate
+constexpr bool     NON_CAUSAL_ENABLED     = true;
+
+// spec 4.1: the reason (AVAILABLE when vision is available) and, when available, the projector's position and attention kind
+struct vision_status {
+    vision_reason reason     = vision_reason::NO_PROJECTOR;
+    bool          mrope      = false;
+    bool          non_causal = false;
+};
+// spec 4.1: the first condition that fails, in the spec's order
+vision_reason vision_reason_for(bool projector, bool supports_vision, bool non_causal, bool non_causal_enabled);
+// "no_projector", "projector_without_vision", "non_causal_projector"; "" when available
+const char *  vision_reason_code(vision_reason r);
+// spec 4.2: the 400 message for state `state`; names the case and, for no_projector, --mmproj
+std::string   vision_unavailable_message(size_t state, vision_reason r);
+// spec 3.4: the info key
+common_json   vision_json(const vision_status & v);
+
+// RFC 4648 section 4 only: alphabet A-Z a-z 0-9 + /, = padding, a length that is a multiple of 4, no whitespace; false otherwise
+bool base64_decode_strict(std::string_view in, std::string & out);
+
+struct image_header {
+    std::string format;   // "jpeg" or "png"
+    uint32_t    width  = 0;
+    uint32_t    height = 0;
+};
+// spec 3.1: "" and `h` filled from the magic bytes and the header, or why the bytes are not a readable JPEG/PNG header
+std::string read_image_header(const std::string & bytes, image_header & h);
+
+// spec 3.1, 3.2 pass 1 for one array state: parts, limits, URL, base64, format, header pixels. `images` counts the
+// request's images so far (the limit of 32). Throws error{"invalid_states", 400, msg, "states[<state>]"}.
+state_parts parse_parts(const common_json & parts, size_t state, int & images);
+
+} // namespace decide
