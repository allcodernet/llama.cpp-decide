diff --git a/tools/decide/decide-fullpath.cpp b/tools/decide/decide-fullpath.cpp
new file mode 100644
index 000000000..2011d6ff1
--- /dev/null
+++ b/tools/decide/decide-fullpath.cpp
@@ -0,0 +1,107 @@
+#include "decide-fullpath.h"
+#include "common.h"
+
+#include <algorithm>
+#include <cmath>
+#include <limits>
+#include <string>
+
+namespace decide {
+
+std::vector<const std::vector<llama_token> *> leaf_merged_sets(const field_trie & t, const vocab_index & vi, const llama_vocab * vocab) {
+    std::vector<const std::vector<llama_token> *> out(t.nodes.size(), nullptr);
+    for (size_t n = 1; n < t.nodes.size(); ++n) {
+        if (!t.nodes[n].children.empty()) {
+            continue;
+        }
+        const auto it = vi.merged.find(common_token_to_piece(vocab, t.nodes[n].tok, false));
+        if (it != vi.merged.end()) {
+            out[n] = &it->second;
+        }
+    }
+    return out;
+}
+
+node_logp full_path_row(const float * logits, int n_vocab, const field_trie & t, int node,
+                        const std::vector<llama_token> & end_tokens, const std::vector<const std::vector<llama_token> *> & merged) {
+    // full-vocabulary log-sum-exp; NaN or +inf in the row makes it NaN, which score_field_full rejects
+    float max = -std::numeric_limits<float>::infinity();
+    for (int i = 0; i < n_vocab; ++i) {
+        max = logits[i] > max ? logits[i] : max;
+    }
+    double sum = 0.0;
+    for (int i = 0; i < n_vocab; ++i) {
+        sum += (double) std::exp(logits[i] - max);
+    }
+    const double lse = (double) max + std::log(sum);
+    // log of the probability mass of `toks` (-inf when empty)
+    const auto log_mass = [&](const std::vector<llama_token> & toks) {
+        double m = 0.0;
+        for (llama_token u : toks) {
+            m += std::exp((double) logits[u] - lse);
+        }
+        return (float) std::log(m);
+    };
+
+    const trie_node & n = t.nodes[node];
+    node_logp         r;
+    r.node = node;
+    for (int child : n.children) {
+        r.child_logp.push_back((float) ((double) logits[t.nodes[child].tok] - lse));
+        const bool leaf = t.nodes[child].children.empty();
+        r.merged_logp.push_back(leaf && merged[child] != nullptr ? log_mass(*merged[child]) : -std::numeric_limits<float>::infinity());
+    }
+    if (n.children.empty()) {
+        r.end_logp = log_mass(end_tokens);
+    }
+    return r;
+}
+
+common_json full_path_dump(const std::string & name, const field_trie & t, const full_path_seq & s, const std::vector<node_logp> & rows) {
+    common_json logp = common_json::array();
+    for (int node : s.row_node) {
+        const auto it = std::find_if(rows.begin(), rows.end(), [&](const node_logp & r) { return r.node == node; });
+        if (it == rows.end()) {
+            throw error("engine", 500, "field \"" + name + "\": missing full-path row for node " + std::to_string(node));
+        }
+        const std::vector<int> & children = t.nodes[node].children;
+        common_json row = common_json::object();
+        row["node"] = node;
+        if (children.empty()) {
+            row["end"] = it->end_logp;
+        } else {
+            common_json child  = common_json::object();
+            common_json merged = common_json::object();
+            for (size_t k = 0; k < children.size(); ++k) {
+                const std::string tok = std::to_string(t.nodes[children[k]].tok);
+                child[tok] = it->child_logp[k];
+                if (t.nodes[children[k]].children.empty()) {
+                    merged[tok] = it->merged_logp[k];
+                }
+            }
+            row["children"] = child;
+            if (!merged.empty()) {
+                row["merged"] = merged;
+            }
+        }
+        logp.push_back(row);
+    }
+    common_json toks = common_json::array();
+    for (llama_token tok : s.tokens) {
+        toks.push_back(tok);
+    }
+    common_json rows_at = common_json::array();
+    for (int i : s.row_index) {
+        rows_at.push_back(i);
+    }
+    common_json b = common_json::object();
+    b["field"]  = name;
+    b["mode"]   = "full_path";
+    b["option"] = s.option;
+    b["tokens"] = toks;
+    b["rows"]   = rows_at;
+    b["logp"]   = logp;
+    return b;
+}
+
+} // namespace decide
diff --git a/tools/decide/decide-fullpath.h b/tools/decide/decide-fullpath.h
new file mode 100644
index 000000000..5423083ca
--- /dev/null
+++ b/tools/decide/decide-fullpath.h
@@ -0,0 +1,24 @@
+#pragma once
+#include "decide-score.h"
+#include "decide-trie.h"
+#include "decide-vocab.h"
+#include "llama.h"
+
+#include <string>
+#include <vector>
+
+// Full-path scoring helpers without a model (spec 4.1, 4.4, 10): the values of one logit row and the dump entry of one branch sequence.
+namespace decide {
+
+// spec 4.1: per node of t, the MERGED set of a leaf's edge-token piece; nullptr for the root, inner nodes and pieces without MERGED tokens
+std::vector<const std::vector<llama_token> *> leaf_merged_sets(const field_trie & t, const vocab_index & vi, const llama_vocab * vocab);
+// spec 4.4: the values of the row read after `node`, from the full-vocabulary softmax of `logits` (n_vocab values): the log-probs
+// of the children's tokens, the END mass on a leaf, per leaf child the MERGED mass of merged[child] (-inf otherwise)
+node_logp full_path_row(const float * logits, int n_vocab, const field_trie & t, int node,
+                        const std::vector<llama_token> & end_tokens, const std::vector<const std::vector<llama_token> *> & merged);
+
+// spec 10: the dump entry of one full-path branch sequence; logp per row: the node, the children's log-probs keyed by token id,
+// "end" on a leaf row, "merged" (keyed by the leaf child's token id) on a row with leaf children; -inf is written as null
+common_json full_path_dump(const std::string & name, const field_trie & t, const full_path_seq & s, const std::vector<node_logp> & rows);
+
+} // namespace decide
